        then show ?thesis
        proof cases
          case cI
          show ?thesis
          proof (cases "Lng N - 1 = 1")
            case j1one: True
            have L2: "Lng N = 2" using j1one L by linarith
            have n2': "2 \<le> n" using n2 by simp
