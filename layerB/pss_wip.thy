        hence L2shape: "Trans ((L::pairseq)[Suc 1]) = Trm ([be] @ [be])" using TPred by simp
        have "isOT_BT (Trm ([be] @ [be]))" using L2OT L2shape by (simp add: OT_B_def OT_def)
        thus ?thesis by simp
      qed
      show ?thesis by (rule that[OF s o j])
