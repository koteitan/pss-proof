lemma dgx_M0RUN_ineq_of_le0anc:
  fixes M :: pairseq
  assumes hp: "hasParent M 1 (Lng M - 1)"
    and anc: "le0 M (s84x_jm2 M + 1) (Lng M - 1)"
  shows "entry M 1 (s84x_jm2 M) < entry M 1 (s84x_jm2 M + 1)"
proof -
