  have base1: "lessBT (bpHeadT (Trans (Pred (s84x_N M))))
                 (d4vx_ins s0 ?ub b0 (Dpt (enat ?ub) 0\<^sub>B))"
    by (rule base1H[OF inner'])
  show ?thesis
    by (rule w84x_exchange13_core[OF MST n1 uv bodyT bodyne dbbodyH inner'
          k1 mn base0H base1])
