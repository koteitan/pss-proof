  have fn1: "FirstNodes N ! (Lng (Br N) - 1) = Lng N - 1" using eq by (simp add: cfbx_j1p_def)
  have anc0: "m \<le> parent N 0 (Lng N - 1)" using mle jnt fn1 by simp
