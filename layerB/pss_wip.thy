lemma lp2x_c2L1_of_sharp:
  fixes M :: pairseq
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS" and cond: "transCondV M"
    and nadm: "\<not> adm M (transJ0 M)"
    and J1pos: "transJ1 M > 0" and T1: "transT1 M \<noteq> 0\<^sub>B"
    and t2ne: "transT2 M \<noteq> 0\<^sub>B"
