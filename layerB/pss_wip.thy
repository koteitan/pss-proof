section \<open>r54-OC4 --- \<open>ordIntC\<close> closed and the combined termination census\<close>

subsection \<open>The \<open>ordIntC\<close> residual, closed (strict form first)\<close>

text \<open>The interior ORDER residual of @{thm [source] opx_OTmulti} (r53): the
  \<open>leBT\<close>-weakening \<open>Trans (P[n]) \<le>\<^sub>B Trans P\<close> of the interior exchange legs
  (III)/(IV)/(V), needed only for the \<open>descP\<close> junction of the reassembled
  multi host.  Every branch is already closed:

  \<^enum> (III), \<open>hasParent\<close>: conjunct (2) of
    @{thm [source] cpx_condIII_exchange_uncond} (strict).
  \<^enum> (III), no-parent: \<open>P[n] = Pred P\<close>
    (@{thm [source] npx_oper_noParent_Pred}) with the \<open>k = 0\<close> EQUALITY
    readback @{thm [source] npx_operB_numBT0_Pred_condIII}, then the fseq
    descent @{thm [source] m_buc1_3_2a_fseq_lt} on the \<open>OT\<^bsub>B\<^esub>\<close> host --- this
    corner (and its condIV twin) is the ONLY use of the slot's
    \<open>Trans P \<in> OT_B\<close> hypothesis.
  \<^enum> (IV), \<open>hasParent\<close>: conjunct (2) of
    @{thm [source] cnv_condIV_exchange_final} (strict).
  \<^enum> (IV), no-parent: \<open>P[n] = Pred P\<close> plus the \<open>k = 0\<close> INEQUALITY readback
    @{thm [source] dpx_condIV_noParent_operB0}, chained through
    @{thm [source] m_buc1_3_2a_fseq_lt} by @{thm [source] b1x_le_less_trans}.
  \<^enum> (V), adm: conjunct (2) of
    @{thm [source] m_8_5_Trans_oper_exchange_condV_adm_uncond}.
  \<^enum> (V), non-adm: conjunct (2) of
    @{thm [source] atx_Trans_oper_exchange_condV_nonadm_uncond}.

  All six branches are in fact STRICT, so we prove \<open>lessBT\<close> and weaken; the
  census-shaped \<open>leBT\<close> statement follows verbatim.  Audit (agent-workflow
  rule 4): cites only proven facts; no refuted endpoints, no \<open>sorry\<close>-\<open>p_*\<close>.\<close>

lemma oc4_ordIntC_strict:
  fixes P :: pairseq and n :: nat
  assumes PST: "P \<in> ST_PS" and PPT: "P \<in> PT_PS"
    and j1gt: "1 < Lng P - 1"
    and cond: "transCondIII P \<or> transCondIV P \<or> transCondV P"
    and POT: "Trans P \<in> OT_B"
    and ngt: "1 < n"
  shows "lessBT (Trans ((P::pairseq)[n])) (Trans P)"
proof -
  have n1: "1 \<le> n" using ngt by linarith
  have PR: "P \<in> RT_PS" using PST m_6_7_ST_PS_subseteq_RT_PS by blast
  have LP: "1 < Lng P" using j1gt by linarith
  have nzP: "\<not> zeroT P" using LP by (auto simp: zeroT_def)
  have TPne: "Trans P \<noteq> 0\<^sub>B" using Trans_Mark_invariant_aux PR nzP by blast
  have OP0: "lessBT (operB (Trans P) (numBT 0)) (Trans P)"
    by (rule m_buc1_3_2a_fseq_lt[OF POT TPne])
  consider (cIII) "transCondIII P" | (cIV) "transCondIV P" | (cV) "transCondV P"
    using cond by blast
  then show ?thesis
  proof cases
    case cIII
    show ?thesis
    proof (cases "hasParent P 1 (Lng P - 1)")
      case True
      show ?thesis
        using cpx_condIII_exchange_uncond[OF PST PPT True j1gt cIII n1] by blast
    next
      case False
      have epos: "0 < entry P 1 (Lng P - 1)"
        using cIII by (simp add: transCondIII_def)
      have j1gt0: "0 < Lng P - 1" using j1gt by linarith
      have opm: "(P::pairseq)[n] = Pred P"
        by (rule npx_oper_noParent_Pred[OF j1gt0 epos False])
      have rb: "operB (Trans P) (numBT 0) = Trans (Pred P)"
        by (rule npx_operB_numBT0_Pred_condIII[OF PR PPT j1gt cIII False])
      have "lessBT (Trans (Pred P)) (Trans P)" using OP0 rb by simp
      thus ?thesis using opm by simp
    qed
  next
    case cIV
    show ?thesis
    proof (cases "hasParent P 1 (Lng P - 1)")
      case True
      show ?thesis
        using cnv_condIV_exchange_final[OF PST PPT True cIV n1] by blast
    next
      case False
      have epos: "0 < entry P 1 (Lng P - 1)"
        using cIV by (simp add: transCondIV_def)
      have j1gt0: "0 < Lng P - 1" using j1gt by linarith
      have opm: "(P::pairseq)[n] = Pred P"
        by (rule npx_oper_noParent_Pred[OF j1gt0 epos False])
      have le0: "leBT (Trans (Pred P)) (operB (Trans P) (numBT 0))"
        by (rule dpx_condIV_noParent_operB0[OF PR PPT j1gt cIV False])
      have "lessBT (Trans (Pred P)) (Trans P)"
        by (rule b1x_le_less_trans[OF le0 OP0])
      thus ?thesis using opm by simp
    qed
  next
    case cV
    show ?thesis
    proof (cases "adm P (parent P 0 (Lng P - 1))")
      case True
      show ?thesis
        by (rule m_8_5_Trans_oper_exchange_condV_adm_uncond(2)[OF PST PPT n1 cV True])
    next
      case False
      show ?thesis
        by (rule atx_Trans_oper_exchange_condV_nonadm_uncond(2)[OF PST PPT cV False n1])
    qed
  qed
qed

text \<open>The residual in its EXACT census shape (the \<open>ordIntC\<close> hypothesis of
  @{thm [source] opx_OTmulti} / @{thm [source] opx_termination_census} /
  @{thm [source] opx_termination_census_v3}, hypothesis order verbatim).\<close>

lemma oc4_ordIntC:
  fixes P :: pairseq and n :: nat
  assumes "P \<in> ST_PS" and "P \<in> PT_PS" and "1 < Lng P - 1"
    and "transCondIII P \<or> transCondIV P \<or> transCondV P"
    and "Trans P \<in> OT_B" and "1 < n"
  shows "leBT (Trans ((P::pairseq)[n])) (Trans P)"
  using oc4_ordIntC_strict[OF assms] by blast

subsection \<open>THE COMBINED TERMINATION CENSUS --- both pillars modulo
  \<open>{otIII, otIV, PredNp, Lpv, L1v, DEEPOT, NOBR, FINRC}\<close>\<close>

text \<open>\<^bold>\<open>Census synthesis (r54).\<close>  The r53 census styles are wired into ONE
  master census with the MINIMAL current residual set:

  \<^enum> the \<open>OTint\<close> slot is @{thm [source] otx3_OTint_slot}
    (transport-free, condition (V) fully covered) --- residuals
    \<open>{otIII, otIV, PredNp, Lpv, L1v}\<close>;
  \<^enum> the \<open>TVall\<close> slot is @{thm [source] ljx_TVall_of_fin}
    (\<open>LDJB\<close> a theorem) --- residual \<open>{FINRC}\<close>;
  \<^enum> the \<open>ordIntC\<close> slot is DISCHARGED outright by
    @{thm [source] oc4_ordIntC};
  \<^enum> the structural slots \<open>OTmulti\<close>/\<open>OTpred\<close> are already eliminated inside
    @{thm [source] opx_termination_census_v3} --- residuals
    \<open>{DEEPOT, NOBR}\<close>.

  Each residual hypothesis below is stated VERBATIM in its existing shape
  (\<open>otIII\<close>/\<open>otIV\<close>/\<open>PredNpH\<close>/\<open>LpvH\<close>/\<open>L1vH\<close> from
  @{thm [source] otx3_OTint_slot}, \<open>DEEPOT\<close>/\<open>NOBR\<close> from
  @{thm [source] opx_termination_census_v3}, \<open>FINRC\<close> from
  @{thm [source] ljx_TVall_of_fin}), so the parallel fronts attacking them
  plug in without reshaping.  Audit (rule 4): cites only proven facts.\<close>

theorem oc4_termination_census_master:
  assumes otIII: "\<And>P n. P \<in> ST_PS \<Longrightarrow> P \<in> PT_PS \<Longrightarrow> 1 < Lng P - 1 \<Longrightarrow>
             transCondIII P \<Longrightarrow> Trans P \<in> OT_B \<Longrightarrow> 1 < n \<Longrightarrow>
             Trans ((P::pairseq)[n]) \<in> OT_B"
    and otIV: "\<And>P n. P \<in> ST_PS \<Longrightarrow> P \<in> PT_PS \<Longrightarrow> 1 < Lng P - 1 \<Longrightarrow>
             transCondIV P \<Longrightarrow> Trans P \<in> OT_B \<Longrightarrow> 1 < n \<Longrightarrow>
             Trans ((P::pairseq)[n]) \<in> OT_B"
    and PredNpH: "\<And>P. P \<in> ST_PS \<Longrightarrow> P \<in> PT_PS \<Longrightarrow> transCondV P \<Longrightarrow>
             \<not> adm P (transJ0 P) \<Longrightarrow>
             Trans (Pred (s84x_Np P))
               = Dpt (enat (entry P 1 (transJ0 P))) (transT2 P)"
    and LpvH: "\<And>P. P \<in> ST_PS \<Longrightarrow> P \<in> PT_PS \<Longrightarrow> transCondV P \<Longrightarrow>
             \<not> adm P (transJ0 P) \<Longrightarrow>
             Trans (s84x_Lp P)
               = Dpt (enat (entry P 1 (transJ0 P)))
                   (transT2 P +\<^sub>B Dpt (enat (entry P 1 (transJ0 P))) 0\<^sub>B)"
    and L1vH: "\<And>P s\<^sub>1 b\<^sub>1. P \<in> ST_PS \<Longrightarrow> P \<in> PT_PS \<Longrightarrow> transCondV P \<Longrightarrow>
             \<not> adm P (transJ0 P) \<Longrightarrow>
             scb_decomp (Trans ((P::pairseq)[1])) s\<^sub>1
               (flatBT (Dpt (enat (entry P 1 (transJm1 P))) (transT2 P))) b\<^sub>1 \<Longrightarrow>
             scb_kind1 (Trans P) s\<^sub>1 (flatBT (transC2 P)) b\<^sub>1 \<Longrightarrow>
             scb_decomp (Trans (s84x_L P 1)) s\<^sub>1
               (flatBT (Dpt (enat (entry P 1 (transJm1 P)))
                  (transT2 P +\<^sub>B Dpt (enat (entry P 1 (transJ0 P)))
                     (transT2 P +\<^sub>B Dpt (enat (entry P 1 (transJ0 P))) 0\<^sub>B)))) b\<^sub>1"
    and DEEPOT: "\<And>K x q q' ps. K \<in> ST_PS \<Longrightarrow> monoT K \<Longrightarrow> Br K \<noteq> [] \<Longrightarrow>
             1 < Lng K - 1 \<Longrightarrow> Trans K \<in> OT_B \<Longrightarrow>
             Trans K = Dpt (enat (entry K 1 0)) (Trm ps +\<^sub>B Dpt (enat x) q) \<Longrightarrow>
             Trans (Pred K) = Dpt (enat (entry K 1 0)) (Trm ps +\<^sub>B Dpt (enat x) q') \<Longrightarrow>
             Trans (Pred K) \<in> OT_B"
    and NOBR: "\<And>K. K \<in> ST_PS \<Longrightarrow> monoT K \<Longrightarrow> Br K = [] \<Longrightarrow> 1 < Lng K - 1 \<Longrightarrow>
             Trans K \<in> OT_B \<Longrightarrow> Trans (Pred K) \<in> OT_B"
    and FINRC: "\<And>K. K \<in> ST_PS \<Longrightarrow> K \<in> PT_PS \<Longrightarrow> 1 < Lng K - 1 \<Longrightarrow>
             transCondII K \<Longrightarrow> tvx_finRc K"
  shows "\<forall>M. M \<in> ST_PS \<longrightarrow> Trans M \<in> OT_B"
    and "\<forall>M n. M \<in> ST_PS \<longrightarrow> 1 \<le> n \<longrightarrow> 1 < Lng M \<longrightarrow>
           lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  have OTint: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIII N \<or> transCondIV N \<or> transCondV N \<Longrightarrow>
                  Trans N \<in> OT_B \<Longrightarrow> 1 < m \<Longrightarrow> Trans ((N::pairseq)[m]) \<in> OT_B"
    by (rule otx3_OTint_slot[OF otIII otIV PredNpH LpvH L1vH])
  have TVall: "\<And>K. K \<in> ST_PS \<Longrightarrow> K \<in> PT_PS \<Longrightarrow> 1 < Lng K - 1 \<Longrightarrow>
                  transCondII K \<Longrightarrow> c2sx_tailval K"
    by (rule ljx_TVall_of_fin[OF FINRC])
  show "\<forall>M. M \<in> ST_PS \<longrightarrow> Trans M \<in> OT_B"
    by (rule opx_termination_census_v3(1)[OF OTint TVall oc4_ordIntC DEEPOT NOBR])
  show "\<forall>M n. M \<in> ST_PS \<longrightarrow> 1 \<le> n \<longrightarrow> 1 < Lng M \<longrightarrow>
           lessBT (Trans ((M::pairseq)[n])) (Trans M)"
    by (rule opx_termination_census_v3(2)[OF OTint TVall oc4_ordIntC DEEPOT NOBR])
qed

