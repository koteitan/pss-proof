lemma oc4_L1v:
  fixes P :: pairseq and s\<^sub>1 b\<^sub>1 :: "Sym list"
  assumes PST: "P \<in> ST_PS" and PPT: "P \<in> PT_PS" and cond: "transCondV P"
    and nadm: "\<not> adm P (transJ0 P)"
    and d1h: "scb_decomp (Trans ((P::pairseq)[1])) s\<^sub>1
               (flatBT (Dpt (enat (entry P 1 (transJm1 P))) (transT2 P))) b\<^sub>1"
    and k1h: "scb_kind1 (Trans P) s\<^sub>1 (flatBT (transC2 P)) b\<^sub>1"
  shows "scb_decomp (Trans (s84x_L P 1)) s\<^sub>1
           (flatBT (Dpt (enat (entry P 1 (transJm1 P)))
              (transT2 P +\<^sub>B Dpt (enat (entry P 1 (transJ0 P)))
                 (transT2 P +\<^sub>B Dpt (enat (entry P 1 (transJ0 P))) 0\<^sub>B)))) b\<^sub>1"
  by (rule nf2x_L1v[OF PST PPT cond d1h atx_c2L1[OF PST PPT cond nadm]])

