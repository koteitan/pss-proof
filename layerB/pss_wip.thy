    and descent: "\<And>K n. K \<in> ST_PS \<Longrightarrow> 1 \<le> n \<Longrightarrow> 1 < Lng K
                    \<Longrightarrow> lessBT (Trans ((K::pairseq)[n])) (Trans K)"
