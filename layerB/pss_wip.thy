lemma m_8_7_Trans_cnst_OT: "Trans (cnst u m) \<in> OT_B"
proof (cases "u = 0")
  case True
  have eq: "Trans (cnst u m) = multBT (Dpt (enat u) 0\<^sub>B) m"
