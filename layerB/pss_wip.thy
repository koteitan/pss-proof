          also have "\<dots> = Trans (A @ (L::pairseq)[j]) +\<^sub>B blkT" using Ljval[OF j1] by simp
          also have "\<dots> = Trans ((N::pairseq)[j]) +\<^sub>B blkT" using Nival[OF j1] by simp
          also have "\<dots> = Trm (as @ replicate j be) +\<^sub>B Trm [be]"
