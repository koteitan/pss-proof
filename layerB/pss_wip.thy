  have "Trans (concat (replicate (Suc m) (Pred M))) = operB (Trans M) (numBT m)"
    by (rule m_8_1_Trans_replicate_pred_condI[OF MR MP j1gt cond j0z m1])
  thus ?thesis using pow nm by simp
qed

