text \<open>\<open>transC2 M\<close> with the innermost right-end core \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0\<close> replaced by
  \<open>D\<^sub>a 0\<close> for a parameter \<open>a\<close>.  Mirrors \<^const>\<open>transC2\<close> verbatim (same
  let-chain, same branch guards); \<open>transC2 M = s84d_c2hole M (M\<^bsub>1,j\<^sub>1\<^esub>)\<close> holds
  definitionally.  The \<open>L\<^sub>1 = M[1] \<oplus> ((M\<^bsub>0,j\<^sub>1\<^esub>, M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>))\<close> instance realises
  \<open>transC2 L\<^sub>1 = s84d_c2hole M (M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>)\<close> (validated 496/496, B_hole).\<close>

definition s84d_c2hole :: "pairseq \<Rightarrow> nat \<Rightarrow> BT" where
  "s84d_c2hole M a =
     (let jp = transJ0 M;  v = transV M;  t2 = transT2 M;
          J1 = Lng (PB t2) - 1;  pj = PB t2 ! J1;
          leftDj0 = (bpHeadV pj = enat (entry M 1 jp));
          t3 = (if leftDj0 then SigmaB (take J1 (PB t2)) else t2);
          t4 = (if leftDj0 then bpHeadT pj else t2)
      in if transCondI M \<or> transCondIII M \<or> transCondV M
         then Dpt v (t2 +\<^sub>B Dpt (enat a) 0\<^sub>B)
         else if transCondVI M
         then Dpt v (Dpt (enat a) 0\<^sub>B)
         else if t2 = 0\<^sub>B
         then Dpt v (Dpt (enat (entry M 1 jp)) (Dpt (enat a) 0\<^sub>B))
         else Dpt v (t3 +\<^sub>B Dpt (enat (entry M 1 jp))
                            (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B)))"

lemma s84d_c2hole_at_j1: "transC2 M = s84d_c2hole M (entry M 1 (Lng M - 1))"
  by (simp add: transC2_def s84d_c2hole_def Let_def transJ1_def)

text \<open>Uniform core pair: ONE \<open>(w,w')\<close> marks the trailing principal \<open>D\<^sub>a 0\<close> of
  \<open>t + D\<^sub>a 0\<close> for EVERY \<open>a\<close> (the pre/post strings of the trailing-principal
  split do not depend on the principal's content).\<close>

lemma s84d_corepair_shared:
  assumes tTB: "t \<in> T_B"
  shows "\<exists>w w'. \<forall>a. scb_decomp (t +\<^sub>B Dpt (enat a) 0\<^sub>B) w
                      (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
proof -
  have DTB: "\<And>a::nat. Dpt (enat a) 0\<^sub>B \<in> T_B" by (simp add: T_B_def)
  have Dp: "\<And>a::nat. \<exists>p. Dpt (enat a) 0\<^sub>B = Trm [p]" by blast
  obtain w w' where
    d0: "scb_decomp (t +\<^sub>B Dpt (enat 0) 0\<^sub>B) w (flatBT (Dpt (enat 0) 0\<^sub>B)) w'"
    using m_7_2_add_scb_conj1[OF tTB DTB[of 0] Dp[of 0]]
    unfolding MarkedB_def by auto
  have "\<forall>a. scb_decomp (t +\<^sub>B Dpt (enat a) 0\<^sub>B) w (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
  proof
    fix a
    show "scb_decomp (t +\<^sub>B Dpt (enat a) 0\<^sub>B) w (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
      by (rule m_7_2_add_scb_conj2[OF tTB DTB[of 0] Dp[of 0] DTB[of a] Dp[of a] d0])
  qed
  thus ?thesis by blast
qed

lemma s84d_corepair_nested:
  assumes t3TB: "t3 \<in> T_B" and t4TB: "t4 \<in> T_B"
  shows "\<exists>w w'. \<forall>a. scb_decomp (t3 +\<^sub>B Dpt (enat u) (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B)) w
                      (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
proof -
  have ipta: "\<And>a::nat. isPTB_str (flatBT (Dpt (enat a) 0\<^sub>B))"
    by (rule isPTB_str_Dpt) simp_all
  obtain p4 q4 where
    i4: "\<forall>a. scb_decomp (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B) p4 (flatBT (Dpt (enat a) 0\<^sub>B)) q4"
    using s84d_corepair_shared[OF t4TB] by blast
  define c :: "nat \<Rightarrow> BT" where "c = (\<lambda>a. Dpt (enat u) (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B))"
  have li: "\<And>a. scb_decomp (c a) (Dsym (enat u) # p4) (flatBT (Dpt (enat a) 0\<^sub>B)) q4"
  proof -
    fix a
    show "scb_decomp (c a) (Dsym (enat u) # p4) (flatBT (Dpt (enat a) 0\<^sub>B)) q4"
      using scb_Dpt_lift[OF i4[rule_format, of a] ipta[of a]]
      by (simp add: c_def)
  qed
  have dfin: "\<And>a. dfree_BT (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B)"
    using t4TB unfolding T_B_def by (cases t4) auto
  have cTB: "\<And>a. c a \<in> T_B" using dfin by (simp add: T_B_def c_def)
  have cp: "\<And>a. \<exists>p. c a = Trm [p]" unfolding c_def by blast
  obtain p3 q3 where
    d30: "scb_decomp (t3 +\<^sub>B c 0) p3 (flatBT (c 0)) q3"
    using m_7_2_add_scb_conj1[OF t3TB cTB[of 0] cp[of 0]]
    unfolding MarkedB_def by auto
  have "\<forall>a. scb_decomp (t3 +\<^sub>B Dpt (enat u) (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B))
              (p3 @ Dsym (enat u) # p4) (flatBT (Dpt (enat a) 0\<^sub>B)) (q4 @ q3)"
  proof
    fix a
    have d3a: "scb_decomp (t3 +\<^sub>B c a) p3 (flatBT (c a)) q3"
      by (rule m_7_2_add_scb_conj2[OF t3TB cTB[of 0] cp[of 0] cTB[of a] cp[of a] d30])
    have "scb_decomp (t3 +\<^sub>B c a) (p3 @ Dsym (enat u) # p4)
            (flatBT (Dpt (enat a) 0\<^sub>B)) (q4 @ q3)"
      by (rule m_7_2_scb_compose[OF cp[of a] d3a li[of a]])
    thus "scb_decomp (t3 +\<^sub>B Dpt (enat u) (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B))
            (p3 @ Dsym (enat u) # p4) (flatBT (Dpt (enat a) 0\<^sub>B)) (q4 @ q3)"
      by (simp add: c_def)
  qed
  thus ?thesis by blast
qed

text \<open>The engine: one \<open>(w,w')\<close> marks the hole \<open>D\<^sub>a 0\<close> of \<open>s84d_c2hole M a\<close>
  for every \<open>a\<close>, with the marked-head letter \<open>D\<^bsub>transV M\<^esub>\<close> exposed.
  Case analysis on the four \<open>transC2\<close> branch shapes; the \<open>T\<^bsub>B\<^esub>\<close> data of
  \<open>t\<^sub>3\<close>/\<open>t\<^sub>4\<close> reads off \<open>dfree_BT (transC1 M)\<close> exactly as in the proof of
  @{thm [source] m_8_4_rightend_Trans}.\<close>

lemma s84d_c2hole_scb:
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS"
    and J1pos: "transJ1 M > 0" and T1: "transT1 M \<noteq> 0\<^sub>B"
  shows "\<exists>w w'. \<forall>a. scb_decomp (s84d_c2hole M a)
                      (Dsym (transV M) # w) (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
proof -
  have c1shape: "transC1 M = Dpt (transV M) (transT2 M)"
    by (rule transC2_single_principal_head(1)[OF MR MP J1pos T1])
  have dfc1: "dfree_BT (transC1 M)"
    by (rule m_8_5_dfree_transC1_std[OF MR MP J1pos T1])
  have vne: "transV M \<noteq> \<infinity>" and dft2: "dfree_BT (transT2 M)"
    using dfc1 c1shape by auto
  have t2TB: "transT2 M \<in> T_B" using dft2 by (simp add: T_B_def)
  have ipta: "\<And>a::nat. isPTB_str (flatBT (Dpt (enat a) 0\<^sub>B))"
    by (rule isPTB_str_Dpt) simp_all
  show ?thesis
  proof (cases "transCondI M \<or> transCondIII M \<or> transCondV M")
    case condA: True
    have c2h: "\<And>a. s84d_c2hole M a
                 = Dpt (transV M) (transT2 M +\<^sub>B Dpt (enat a) 0\<^sub>B)"
      using condA by (simp add: s84d_c2hole_def Let_def)
    obtain w w' where
      W: "\<forall>a. scb_decomp (transT2 M +\<^sub>B Dpt (enat a) 0\<^sub>B) w
                (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
      using s84d_corepair_shared[OF t2TB] by blast
    have "\<And>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
                (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
    proof -
      fix a
      show "scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
              (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
        using scb_Dpt_lift[OF W[rule_format, of a] ipta[of a]] c2h by simp
    qed
    thus ?thesis by blast
  next
    case notA: False
    show ?thesis
    proof (cases "transCondVI M")
      case VI: True
      have c2h: "\<And>a. s84d_c2hole M a = Dpt (transV M) (Dpt (enat a) 0\<^sub>B)"
        using notA VI by (simp add: s84d_c2hole_def Let_def)
      have selfd: "\<And>a::nat. scb_decomp (Dpt (enat a) 0\<^sub>B) []
                     (flatBT (Dpt (enat a) 0\<^sub>B)) []"
        by (rule s84c2_scb_self) simp_all
      have "\<And>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # [])
              (flatBT (Dpt (enat a) 0\<^sub>B)) []"
      proof -
        fix a
        show "scb_decomp (s84d_c2hole M a) (Dsym (transV M) # [])
                (flatBT (Dpt (enat a) 0\<^sub>B)) []"
          using scb_Dpt_lift[OF selfd[of a] ipta[of a]] c2h by simp
      qed
      thus ?thesis by blast
    next
      case notVI: False
      show ?thesis
      proof (cases "transT2 M = 0\<^sub>B")
        case t2z: True
        define u' where "u' = entry M 1 (transJ0 M)"
        have c2h: "\<And>a. s84d_c2hole M a
                     = Dpt (transV M) (Dpt (enat u') (Dpt (enat a) 0\<^sub>B))"
          using notA notVI t2z by (simp add: s84d_c2hole_def Let_def u'_def)
        have selfd: "\<And>a::nat. scb_decomp (Dpt (enat a) 0\<^sub>B) []
                       (flatBT (Dpt (enat a) 0\<^sub>B)) []"
          by (rule s84c2_scb_self) simp_all
        have l1: "\<And>a. scb_decomp (Dpt (enat u') (Dpt (enat a) 0\<^sub>B))
                    (Dsym (enat u') # []) (flatBT (Dpt (enat a) 0\<^sub>B)) []"
        proof -
          fix a
          show "scb_decomp (Dpt (enat u') (Dpt (enat a) 0\<^sub>B))
                  (Dsym (enat u') # []) (flatBT (Dpt (enat a) 0\<^sub>B)) []"
            using scb_Dpt_lift[OF selfd[of a] ipta[of a]] by simp
        qed
        have "\<And>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # [Dsym (enat u')])
                (flatBT (Dpt (enat a) 0\<^sub>B)) []"
        proof -
          fix a
          show "scb_decomp (s84d_c2hole M a) (Dsym (transV M) # [Dsym (enat u')])
                  (flatBT (Dpt (enat a) 0\<^sub>B)) []"
            using scb_Dpt_lift[OF l1[of a] ipta[of a]] c2h by simp
        qed
        thus ?thesis by blast
      next
        case t2n: False
        define t2 where "t2 = transT2 M"
        define JJ1 where "JJ1 = Lng (PB t2) - 1"
        define pj where "pj = PB t2 ! JJ1"
        define u' where "u' = entry M 1 (transJ0 M)"
        define ldj where "ldj = (bpHeadV pj = enat u')"
        define t3 where "t3 = (if ldj then SigmaB (take JJ1 (PB t2)) else t2)"
        define t4 where "t4 = (if ldj then bpHeadT pj else t2)"
        have c2h: "\<And>a. s84d_c2hole M a
                     = Dpt (transV M)
                         (t3 +\<^sub>B Dpt (enat u') (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B))"
          using notA notVI t2n
          by (simp add: s84d_c2hole_def Let_def t3_def t4_def ldj_def pj_def
                        JJ1_def t2_def u'_def)
        have dft2': "dfree_BT t2" using dft2 t2_def by simp
        obtain ps where t2ps: "t2 = Trm ps" by (cases t2) auto
        have psne: "ps \<noteq> []" using t2n t2ps t2_def by simp
        have dfps: "\<forall>p \<in> set ps. dfree_BP p" using dft2' t2ps by simp
        have PBt2: "PB t2 = map (\<lambda>p. Trm [p]) ps" using t2ps by (simp add: PB_def)
        have JJ1lt: "JJ1 < Lng ps" using JJ1_def PBt2 psne by simp
        have pjval: "pj = Trm [ps ! JJ1]" using pj_def PBt2 JJ1lt by simp
        obtain wv z where pspl: "ps ! JJ1 = DB wv z" by (cases "ps ! JJ1") auto
        have dfpj: "dfree_BP (ps ! JJ1)" using dfps nth_mem[OF JJ1lt] by blast
        have dft4: "dfree_BT t4"
        proof (cases ldj)
          case True
          have "bpHeadT pj = z" using pjval pspl by simp
          moreover have "dfree_BT z" using dfpj pspl by simp
          ultimately show ?thesis using t4_def True by simp
        next
          case False thus ?thesis using t4_def dft2' by simp
        qed
        have dft3: "dfree_BT t3"
        proof (cases ldj)
          case True
          have untq: "map untrm (take JJ1 (PB t2)) = map (\<lambda>p. [p]) (take JJ1 ps)"
            using PBt2 by (simp add: take_map)
          have sig: "SigmaB (take JJ1 (PB t2)) = Trm (take JJ1 ps)"
            by (simp add: SigmaB_def untq s84c2_concat_map_single)
          have "\<forall>p \<in> set (take JJ1 ps). dfree_BP p"
            using dfps by (auto dest: in_set_takeD)
          thus ?thesis using t3_def True sig by simp
        next
          case False thus ?thesis using t3_def dft2' by simp
        qed
        have t3TB: "t3 \<in> T_B" using dft3 by (simp add: T_B_def)
        have t4TB: "t4 \<in> T_B" using dft4 by (simp add: T_B_def)
        obtain w w' where
          W: "\<forall>a. scb_decomp (t3 +\<^sub>B Dpt (enat u') (t4 +\<^sub>B Dpt (enat a) 0\<^sub>B)) w
                    (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
          using s84d_corepair_nested[OF t3TB t4TB] by blast
        have "\<And>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
                (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
        proof -
          fix a
          show "scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
                  (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
            using scb_Dpt_lift[OF W[rule_format, of a] ipta[of a]] c2h by simp
        qed
        thus ?thesis by blast
      qed
    qed
  qed
qed

text \<open>切片のscb分解 part (1), on the whole surgery regime: a UNIQUE
  \<open>(s'\<^sub>1,b'\<^sub>1)\<close> with \<open>(D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>1\<^esub> s'\<^sub>1, D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0, b'\<^sub>1)\<close> an scb-decomposition
  of \<open>c\<^sub>2\<close>.  Empirical: 2617/2617 over conditions III/IV/V/VI
  (python/_r15_s4d_validate.py P1u_*/P1h_*; I/II do not arise under
  \<open>hasParent M 1 j\<^sub>1\<close> — the statement for them follows by the same
  construction).\<close>

lemma s84d_c2_rightmost_scb:
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS"
    and J1pos: "transJ1 M > 0" and T1: "transT1 M \<noteq> 0\<^sub>B"
  shows "\<exists>!sb. scb_decomp (transC2 M)
                 (Dsym (enat (entry M 1 (transJm1 M))) # fst sb)
                 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) (snd sb)"
proof -
  have vval: "transV M = enat (entry M 1 (transJm1 M))"
    by (rule m_8_5_scbdec_c1_shape(1)[OF MR MP J1pos T1])
  obtain w w' where
    W: "\<forall>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
              (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
    using s84d_c2hole_scb[OF MR MP J1pos T1] by blast
  have dc2: "scb_decomp (transC2 M)
               (Dsym (enat (entry M 1 (transJm1 M))) # w)
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) w'"
    using W[rule_format, of "entry M 1 (Lng M - 1)"]
    unfolding s84d_c2hole_at_j1[symmetric] vval .
  define body where "body = bpHeadT (transC2 M)"
  have c2b: "transC2 M = Dpt (transV M) body"
    using transC2_single_principal_head(2)[OF MR MP J1pos T1] body_def by simp
  have c2ne: "transC2 M \<noteq> Trm []" by (subst c2b) simp
  show ?thesis
  proof (rule ex1I[of _ "(w, w')"])
    show "scb_decomp (transC2 M)
            (Dsym (enat (entry M 1 (transJm1 M))) # fst (w, w'))
            (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) (snd (w, w'))"
      using dc2 by simp
  next
    fix y
    assume Hy: "scb_decomp (transC2 M)
                  (Dsym (enat (entry M 1 (transJm1 M))) # fst y)
                  (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) (snd y)"
    have "Dsym (enat (entry M 1 (transJm1 M))) # fst y
            = Dsym (enat (entry M 1 (transJm1 M))) # w \<and> snd y = w'"
      by (rule m_7_2_scb_unique_sb[OF Hy dc2 c2ne])
    thus "y = (w, w')" by (simp add: prod_eq_iff)
  qed
qed

text \<open>The L4 hypothesis set forces \<open>j\<^sub>1 > 1\<close> and \<open>t\<^sub>1 \<noteq> 0\<close>: if \<open>Lng M = 2\<close> the
  reduced dichotomy @{thm [source] row1_last_bound} together with the row-1
  parent's strict step would make \<open>M\<close> satisfy condition (VI).\<close>

lemma s84d_L4_regime:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
  shows "1 < Lng M - 1" and "transT1 M \<noteq> 0\<^sub>B"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MPT by (simp add: PT_PS_def)
  have mono: "monoT M" using MPT by (simp add: PT_PS_def)
  have jm2lt: "s84x_jm2 M < Lng M - 1"
    and e1lt: "entry M 1 (s84x_jm2 M) < entry M 1 (Lng M - 1)"
    using s84c1_jm2_basic(1,2)[OF hp] by simp_all
  have L: "1 < Lng M" using jm2lt by linarith
  show j1gt: "1 < Lng M - 1"
  proof (rule ccontr)
    assume "\<not> 1 < Lng M - 1"
    hence j1eq: "Lng M - 1 = 1" using jm2lt by linarith
    have jm2z: "s84x_jm2 M = 0" using jm2lt j1eq by simp
    \<comment> \<open>row-0 parent of \<open>j\<^sub>1 = 1\<close> is \<open>0\<close>\<close>
    have hp0: "hasParent M 0 (Lng M - 1)"
      by (rule monoT_hasParent0_last[OF MT mono L])
    have parR0: "nextR M 0 (parent M 0 (Lng M - 1)) (Lng M - 1)"
      using hp0 unfolding hasParent_def parent_def by (rule theI')
    have j0lt: "parent M 0 (Lng M - 1) < Lng M - 1"
      using parR0 by (simp add: nextR_def nextrel0_def)
    have j0z: "parent M 0 (Lng M - 1) = 0" using j0lt j1eq by simp
    have dich: "entry M 1 (parent M 0 (Lng M - 1)) \<ge> entry M 1 (Lng M - 1)
              \<or> entry M 1 (parent M 0 (Lng M - 1)) + 1 = entry M 1 (Lng M - 1)"
      by (rule row1_last_bound[OF MR MPT L])
    have nge: "\<not> entry M 1 (parent M 0 (Lng M - 1)) \<ge> entry M 1 (Lng M - 1)"
      using j0z jm2z e1lt by simp
    have estep: "entry M 1 (parent M 0 (Lng M - 1)) + 1 = entry M 1 (Lng M - 1)"
      using dich nge by blast
    have e1pos: "0 < entry M 1 (Lng M - 1)" using e1lt by simp
    have "transCondVI M"
      unfolding transCondVI_def using e1pos estep j0z j1eq by simp
    thus False using nVI by simp
  qed
  have LP: "Lng (Pred M) = Lng M - 1" using L by (simp add: Pred_def)
  have "\<not> zeroT (Pred M)" using LP j1gt by (auto simp: zeroT_def)
  hence "Trans (Pred M) \<noteq> 0\<^sub>B"
    using m_7_3_Trans_zeroT[OF Pred_RT_PS[OF MR]] by simp
  thus "transT1 M \<noteq> 0\<^sub>B" by (simp add: transT1_def)
qed

text \<open>§8.4 補題（条件(III)～(V)の下での切片のscb分解） part (1)
  (content.md 4605, 4609): the unique \<open>c\<^sub>2\<close>-decomposition brick under the L4
  hypothesis set.  Parts (2)(3) are BLOCKED on the unproven
  \<open>p_8_2_condV_terminal_slice_Trans\<close> (the \<open>j\<^sub>-\<^sub>1 \<to> j\<^sub>-\<^sub>2\<close> head rebase); this
  part needs neither it nor \<open>Adm\<^sub>M(j\<^sub>-\<^sub>2) = j\<^sub>-\<^sub>1\<close> (kept for interface fidelity
  with the stage-1 statement).\<close>

lemma m_8_4_slice_scb_part1:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
    and admeq: "Adm M (s84x_jm2 M) = transJm1 M"
  shows "\<exists>!sb. scb_decomp (transC2 M)
                 (Dsym (enat (entry M 1 (transJm1 M))) # fst sb)
                 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) (snd sb)"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have j1gt: "1 < Lng M - 1" and T1: "transT1 M \<noteq> 0\<^sub>B"
    using s84d_L4_regime[OF MST MPT hp nVI] by simp_all
  have J1pos: "transJ1 M > 0" using j1gt by (simp add: transJ1_def)
  show ?thesis by (rule s84d_c2_rightmost_scb[OF MR MPT J1pos T1])
qed

subsection \<open>s84d: L6 kernel bricks (conjuncts (1) and (2))\<close>

text \<open>Marked-basepoint data for \<open>j\<^sub>-\<^sub>2 = parent\<^sub>1(j\<^sub>1)\<close>, \<open>j\<^sub>-\<^sub>3 = Adm(j\<^sub>-\<^sub>2)\<close> and
  \<open>j\<^sub>-\<^sub>1 = Adm(j\<^sub>0)\<close> (as in the proof of @{thm [source] m_8_4_Trans_scb}).\<close>

lemma s84d_jm3_Marked:
  assumes MR: "M \<in> RT_PS" and MT: "M \<in> T_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
  shows "(M, s84x_jm3 M) \<in> Marked" and "s84x_jm3 M \<le> s84x_jm2 M"
    and "s84x_jm2 M < Lng M - 1"
proof -
  have nrR: "nextR M 1 (s84x_jm2 M) (Lng M - 1)"
    by (rule s84c1_nextR1_jm2[OF hp])
  have nr1: "nextrel1 M (s84x_jm2 M) (Lng M - 1)" using nrR by (simp add: nextR_def)
  show jm2lt: "s84x_jm2 M < Lng M - 1" using nr1 by (simp add: nextrel1_def)
  have L: "1 < Lng M" using jm2lt by linarith
  have jm2L: "s84x_jm2 M \<le> Lng M - 1" using jm2lt by linarith
  show jm3le: "s84x_jm3 M \<le> s84x_jm2 M"
    using adm_Adm_le by (simp add: s84x_jm3_def)
  have admjm3: "adm M (s84x_jm3 M)" using adm_Adm_adm by (simp add: s84x_jm3_def)
  have le1a: "leR M 1 (s84x_jm3 M) (s84x_jm2 M)"
    using adm_row1_ancestry[OF MT jm2L] by (simp add: s84x_jm3_def)
  have le0a: "le0 M (s84x_jm3 M) (s84x_jm2 M)"
    using m_le1_imp_le0[OF le1a] by (simp add: leR_def)
  have le0b: "le0 M (s84x_jm2 M) (Lng M - 1)" using nr1 by (simp add: nextrel1_def)
  have "le0 M (s84x_jm3 M) (Lng M - 1)" by (rule le0_trans[OF le0a le0b])
  hence "leR M 0 (s84x_jm3 M) (Lng M - 1)" by (simp add: leR_def)
  thus "(M, s84x_jm3 M) \<in> Marked" using MT admjm3 by (simp add: Marked_def)
qed

lemma s84d_jm1_Marked:
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS" and L: "1 < Lng M"
  shows "(M, transJm1 M) \<in> Marked" and "transJm1 M < Lng M - 1"
proof -
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have mono: "monoT M" using MP by (simp add: PT_PS_def)
  have hp0: "hasParent M 0 (Lng M - 1)"
    by (rule monoT_hasParent0_last[OF MT mono L])
  have parR0: "nextR M 0 (parent M 0 (Lng M - 1)) (Lng M - 1)"
    using hp0 unfolding hasParent_def parent_def by (rule theI')
  have nr0: "nextrel0 M (parent M 0 (Lng M - 1)) (Lng M - 1)"
    using parR0 by (simp add: nextR_def)
  have j0lt: "parent M 0 (Lng M - 1) < Lng M - 1"
    using nr0 by (simp add: nextrel0_def)
  have j0L: "parent M 0 (Lng M - 1) \<le> Lng M - 1" using j0lt by simp
  have jm1le: "transJm1 M \<le> parent M 0 (Lng M - 1)"
    using adm_Adm_le by (simp add: transJm1_def transJ0_def transJ1_def)
  show "transJm1 M < Lng M - 1" using jm1le j0lt by linarith
  have admjm1: "adm M (transJm1 M)"
    using adm_Adm_adm by (simp add: transJm1_def transJ0_def transJ1_def)
  have le1a: "leR M 1 (transJm1 M) (parent M 0 (Lng M - 1))"
    using adm_row1_ancestry[OF MT j0L]
    by (simp add: transJm1_def transJ0_def transJ1_def)
  have le0a: "le0 M (transJm1 M) (parent M 0 (Lng M - 1))"
    using m_le1_imp_le0[OF le1a] by (simp add: leR_def)
  have j0Lng: "parent M 0 (Lng M - 1) < Lng M" using j0lt L by linarith
  have j1Lng: "Lng M - 1 < Lng M" using L by linarith
  have le0b: "le0 M (parent M 0 (Lng M - 1)) (Lng M - 1)"
    unfolding le0_def using j0Lng j1Lng nr0 by simp
  have "le0 M (transJm1 M) (Lng M - 1)" by (rule le0_trans[OF le0a le0b])
  hence "leR M 0 (transJm1 M) (Lng M - 1)" by (simp add: leR_def)
  thus "(M, transJm1 M) \<in> Marked" using MT admjm1 by (simp add: Marked_def)
qed

text \<open>L6 conjunct (1) in \<open>scb_decomp\<close> form: unique \<open>(s'\<^sub>0,b'\<^sub>0)\<close> with
  \<open>(s'\<^sub>0, Trans N, b'\<^sub>0)\<close> an scb-decomposition of \<open>Trans M\<close> (content.md 4806;
  the kind-1 upgrade is @{thm [source] m_8_4_Trans_scb}).\<close>

lemma s84d_dec1_Trans_N_scb:
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS"
    and j1gt: "1 < Lng M - 1" and hp: "hasParent M 1 (Lng M - 1)"
  shows "\<exists>!sb. scb_decomp (Trans M) (fst sb) (flatBT (Trans (s84x_N M))) (snd sb)"
proof -
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have mM3: "(M, s84x_jm3 M) \<in> Marked" and jm3le: "s84x_jm3 M \<le> s84x_jm2 M"
    and jm2lt: "s84x_jm2 M < Lng M - 1"
    using s84d_jm3_Marked[OF MR MT hp] by simp_all
  have jm3lt: "s84x_jm3 M < Lng M - 1" using jm3le jm2lt by linarith
  have repr: "Mark M (s84x_jm3 M) = Trans (s84x_N M)"
    using m_7_4_Mark_Trans_repr[OF mM3 MR jm3lt] by (simp add: s84x_N_def)
  obtain s b where d: "scb_decomp (Trans M) s (flatBT (Mark M (s84x_jm3 M))) b"
    using m_7_3_Trans_Mark_MarkedB[OF MR mM3] unfolding MarkedB_def by auto
  have TMne: "Trans M \<noteq> Trm []"
  proof -
    have "\<not> zeroT M" using j1gt by (auto simp: zeroT_def)
    thus ?thesis using m_7_3_Trans_zeroT[OF MR] by simp
  qed
  show ?thesis
  proof (rule ex1I[of _ "(s, b)"])
    show "scb_decomp (Trans M) (fst (s, b)) (flatBT (Trans (s84x_N M))) (snd (s, b))"
      using d repr by simp
  next
    fix y
    assume Hy: "scb_decomp (Trans M) (fst y) (flatBT (Trans (s84x_N M))) (snd y)"
    have d': "scb_decomp (Trans M) s (flatBT (Trans (s84x_N M))) b"
      using d repr by simp
    have "fst y = s \<and> snd y = b" by (rule m_7_2_scb_unique_sb[OF Hy d' TMne])
    thus "y = (s, b)" by (simp add: prod_eq_iff)
  qed
qed

text \<open>Strict Mark inequality along the marked chain: for marked \<open>m < m'\<close>
  (interior), \<open>Mark M m \<noteq> Mark M m'\<close>.  Interior case by the RightNodes-length
  strictness (@{thm [source] RightNodes_seg_len_strict_mono} through the
  @{thm [source] m_7_4_RightNodes_Mark} split); \<open>m = 0\<close> case by the
  \<^const>\<open>RightAnces\<close> chain of the prefix slice (a \<open>\<ge> 2\<close>-column slice has a
  \<open>\<ge> 2\<close>-node right spine).  Feeds the nontriviality of L6 (2)
  (empirical: DEC2ne/DEC2rn 1053/1053).\<close>

lemma s84d_Mark_neq:
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS"
    and mM: "(M, m) \<in> Marked" and mM': "(M, m') \<in> Marked"
    and lt: "m < m'" and m'lt: "m' < Lng M - 1"
  shows "Mark M m \<noteq> Mark M m'"
proof -
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have L: "1 < Lng M" using lt m'lt by linarith
  have m'pos: "0 < m'" using lt by simp
  have m'le: "m' \<le> Lng M - 1" using m'lt by simp
  obtain b0 b1 where
    RTm': "RightNodes (Trans M) = b0 @ [entry M 1 m'] @ b1"
    and Rsegm': "RightNodes (Trans (seg M 0 m')) = b0 @ [entry M 1 m']"
    and RMarkm': "RightNodes (Mark M m') = [entry M 1 m'] @ b1"
    using m_7_4_RightNodes_Mark[OF mM' MR m'pos m'lt] by blast
  show ?thesis
  proof (cases "0 < m")
    case mpos: True
    have mlt: "m < Lng M - 1" using lt m'lt by linarith
    obtain a0 a1 where
      RTm: "RightNodes (Trans M) = a0 @ [entry M 1 m] @ a1"
      and Rsegm: "RightNodes (Trans (seg M 0 m)) = a0 @ [entry M 1 m]"
      and RMarkm: "RightNodes (Mark M m) = [entry M 1 m] @ a1"
      using m_7_4_RightNodes_Mark[OF mM MR mpos mlt] by blast
    have sm: "length (RightNodes (Trans (seg M 0 m)))
            < length (RightNodes (Trans (seg M 0 m')))"
      by (rule RightNodes_seg_len_strict_mono[OF MR mM mpos lt m'le])
    have la: "length a0 < length b0" using sm Rsegm Rsegm' by simp
    have lenT1: "length (RightNodes (Trans M)) = length a0 + 1 + length a1"
      using RTm by simp
    have lenT2: "length (RightNodes (Trans M)) = length b0 + 1 + length b1"
      using RTm' by simp
    have "length a1 > length b1" using lenT1 lenT2 la by linarith
    hence "length (RightNodes (Mark M m)) \<noteq> length (RightNodes (Mark M m'))"
      using RMarkm RMarkm' by simp
    thus ?thesis by auto
  next
    case False
    hence m0: "m = 0" by simp
    have j1lt: "Lng M - 1 < Lng M" using L by linarith
    have segM: "seg M 0 (Lng M - 1) = M"
    proof -
      have "seg M 0 (Lng M - 1) = take (Suc (Lng M - 1)) M"
        by (rule seg_0_eq_take) (use L in linarith)
      thus ?thesis using L by simp
    qed
    have mlt0: "(0::nat) < Lng M - 1" using m'lt m'pos by linarith
    have "Mark M 0 = Trans (seg M 0 (Lng M - 1))"
      using m_7_4_Mark_Trans_repr[OF mM[unfolded m0] MR mlt0] by simp
    hence Mark0: "Mark M 0 = Trans M" using segM by simp
    show ?thesis
    proof
      assume eq: "Mark M m = Mark M m'"
      have eqT: "Trans M = Mark M m'" using eq Mark0 m0 by simp
      have "b0 @ [entry M 1 m'] @ b1 = [entry M 1 m'] @ b1"
        using RTm' RMarkm' eqT by simp
      hence b0e: "b0 = []" by simp
      have Rseg1: "RightNodes (Trans (seg M 0 m')) = [entry M 1 m']"
        using Rsegm' b0e by simp
      \<comment> \<open>but a \<open>\<ge> 2\<close>-column reduced mono slice has a \<open>\<ge> 2\<close>-node right spine\<close>
      define S where "S = seg M 0 m'"
      have SR: "S \<in> RT_PS" using seg_0_RT_PS[OF MR m'le] S_def by simp
      have m'Lng: "m' < Lng M" using m'lt by linarith
      have Smono: "monoT S"
        using m_6_2_mono_prefix[OF MP m'pos m'Lng] S_def by simp
      obtain ks where raS: "RightAnces S = map (entry S 1) ks"
        and chain: "s84c3_chainOK S ks"
        using s84c3_RightAnces_chain[rule_format, OF SR Smono] by blast
      have raRN: "RightAnces S = RightNodes (Trans S)"
        by (rule m_7_4_RightAnces_RightNodes[OF SR])
      have LS: "Lng S = Suc m'" using S_def by (simp add: seg_def)
      have kne: "ks \<noteq> []" and khd: "hd ks = 0" and klast: "last ks = Lng S - 1"
        using chain by (simp_all add: s84c3_chainOK_def)
      have "length ks \<ge> 2"
      proof (rule ccontr)
        assume "\<not> length ks \<ge> 2"
        hence l2: "length ks \<le> 1" by linarith
        have "length ks \<noteq> 0" using kne by simp
        hence "length ks = 1" using l2 by linarith
        then obtain k where "ks = [k]"
          by (metis One_nat_def length_0_conv length_Suc_conv)
        hence "hd ks = last ks" by simp
        hence "0 = m'" using khd klast LS by simp
        thus False using m'pos by simp
      qed
      hence "length (RightNodes (Trans S)) \<ge> 2" using raS raRN by simp
      thus False using Rseg1 S_def by simp
    qed
  qed
qed

text \<open>L6 conjunct (2) (content.md 4808): a UNIQUE \<open>(s'\<^sub>1,b'\<^sub>1)\<close> such that
  \<open>(D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>3\<^esub> s'\<^sub>1, c\<^sub>2, b'\<^sub>1)\<close> and \<open>(D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>3\<^esub> s'\<^sub>1, c\<^sub>1, b'\<^sub>1)\<close> are
  scb-decompositions of \<open>Trans N\<close> and \<open>Trans (Pred N)\<close> respectively
  (\<open>N = (M\<^sub>j)\<^bsub>j=j\<^sub>-\<^sub>3\<^esub>\<^bsup>j\<^sub>1\<^esup>\<close>).  Engine: @{thm [source] Mark_nest_common_marked}
  at \<open>(j\<^sub>-\<^sub>3, j\<^sub>-\<^sub>1)\<close>, with \<open>Mark M j\<^sub>-\<^sub>3 = Trans N\<close>, \<open>Mark M j\<^sub>-\<^sub>1 = c\<^sub>2\<close>
  (右端第2基点), \<open>Mark (Pred M) j\<^sub>-\<^sub>3 = Trans (Pred N)\<close>,
  \<open>Mark (Pred M) j\<^sub>-\<^sub>1 = c\<^sub>1\<close> (definition); head exposure by
  @{thm [source] Mark_leftend_form}, nontriviality by
  @{thm [source] s84d_Mark_neq} + @{thm [source] m_7_2_scb_triviality}.
  Empirical: L6u1/L6_2h/L6_2 1053/1053 (III) + the condIV & \<open>j\<^sub>-\<^sub>3 < j\<^sub>-\<^sub>1\<close>
  instances (python/_r15_s4d_condIV_L6.py).  Needs only \<open>j\<^sub>-\<^sub>3 < j\<^sub>-\<^sub>1\<close>, not
  condition (III)/(IV).\<close>

lemma s84d_dec2_nest_scb:
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS"
    and j1gt: "1 < Lng M - 1" and hp: "hasParent M 1 (Lng M - 1)"
    and ltJ: "s84x_jm3 M < transJm1 M"
  shows "\<exists>!sb. scb_decomp (Trans (s84x_N M))
                 (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst sb)
                 (flatBT (transC2 M)) (snd sb)
             \<and> scb_decomp (Trans (Pred (s84x_N M)))
                 (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst sb)
                 (flatBT (transC1 M)) (snd sb)"
proof -
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have L: "1 < Lng M" using j1gt by linarith
  have J1pos: "transJ1 M > 0" using j1gt by (simp add: transJ1_def)
  have LP: "Lng (Pred M) = Lng M - 1" using L by (simp add: Pred_def)
  have T1: "transT1 M \<noteq> 0\<^sub>B"
  proof -
    have "\<not> zeroT (Pred M)" using LP j1gt by (auto simp: zeroT_def)
    thus ?thesis
      using m_7_3_Trans_zeroT[OF Pred_RT_PS[OF MR]] by (simp add: transT1_def)
  qed
  have mM3: "(M, s84x_jm3 M) \<in> Marked" and jm3le2: "s84x_jm3 M \<le> s84x_jm2 M"
    and jm2lt: "s84x_jm2 M < Lng M - 1"
    using s84d_jm3_Marked[OF MR MT hp] by simp_all
  have mM1: "(M, transJm1 M) \<in> Marked" and jm1lt: "transJm1 M < Lng M - 1"
    using s84d_jm1_Marked[OF MR MP L] by simp_all
  have jm3lt: "s84x_jm3 M < Lng M - 1" using jm3le2 jm2lt by linarith
  have jm3ltP: "s84x_jm3 M < Lng M - 1 - 1" using ltJ jm1lt by linarith
  \<comment> \<open>the nest engine at \<open>(j\<^sub>-\<^sub>3, j\<^sub>-\<^sub>1)\<close>\<close>
  have nest: "\<exists>!sb. scb_decomp (Mark (Pred M) (s84x_jm3 M)) (fst sb)
                      (flatBT (Mark (Pred M) (transJm1 M))) (snd sb)
                  \<and> scb_decomp (Mark M (s84x_jm3 M)) (fst sb)
                      (flatBT (Mark M (transJm1 M))) (snd sb)"
    by (rule Mark_nest_common_marked[OF MR mM3 mM1 _ jm1lt]) (use ltJ in simp)
  \<comment> \<open>value rewrites\<close>
  have rm2: "Mark M (transJm1 M) = transC2 M"
    by (rule m_7_3_Mark_rightmost2[OF MR MP J1pos T1])
  have c1v: "Mark (Pred M) (transJm1 M) = transC1 M"
    by (simp add: transC1_def)
  have reprM: "Mark M (s84x_jm3 M) = Trans (s84x_N M)"
    using m_7_4_Mark_Trans_repr[OF mM3 MR jm3lt] by (simp add: s84x_N_def)
  have mM3P: "(Pred M, s84x_jm3 M) \<in> Marked"
    by (rule Marked_Pred[OF MT L mM3 jm3lt])
  have reprP: "Mark (Pred M) (s84x_jm3 M) = Trans (Pred (s84x_N M))"
  proof -
    have jm3ltP': "s84x_jm3 M < Lng (Pred M) - 1" using jm3ltP LP by simp
    have r0: "Mark (Pred M) (s84x_jm3 M)
            = Trans (seg (Pred M) (s84x_jm3 M) (Lng (Pred M) - 1))"
      by (rule m_7_4_Mark_Trans_repr[OF mM3P Pred_RT_PS[OF MR] jm3ltP'])
    have segP: "seg (Pred M) (s84x_jm3 M) (Lng (Pred M) - 1)
              = seg M (s84x_jm3 M) (Lng M - 1 - 1)"
    proof -
      have pb: "Pred M = butlast M" using L by (simp add: Pred_def)
      have "\<And>j. j \<in> set [s84x_jm3 M..<Suc (Lng M - 1 - 1)]
              \<Longrightarrow> (Pred M) ! j = M ! j"
        using pb j1gt by (auto simp: nth_butlast)
      thus ?thesis using LP unfolding seg_def by (intro map_cong) simp_all
    qed
    have blN: "Pred (s84x_N M) = seg M (s84x_jm3 M) (Lng M - 1 - 1)"
    proof -
      have LN: "Lng (s84x_N M) = Suc (Lng M - 1) - s84x_jm3 M"
        by (simp add: s84x_N_def seg_def del: upt_Suc)
      have "1 < Lng (s84x_N M)" using LN jm3lt by linarith
      hence "Pred (s84x_N M) = butlast (s84x_N M)" by (simp add: Pred_def)
      also have "\<dots> = seg M (s84x_jm3 M) (Lng M - 1 - 1)"
        using s84c2_seg_butlast[OF jm3lt] by (simp add: s84x_N_def)
      finally show ?thesis .
    qed
    show ?thesis using r0 segP blN by simp
  qed
  \<comment> \<open>nontriviality and head exposure, then assembly\<close>
  show ?thesis
  proof (rule ex1E[OF nest])
    fix sb
    assume A: "scb_decomp (Mark (Pred M) (s84x_jm3 M)) (fst sb)
                 (flatBT (Mark (Pred M) (transJm1 M))) (snd sb)
             \<and> scb_decomp (Mark M (s84x_jm3 M)) (fst sb)
                 (flatBT (Mark M (transJm1 M))) (snd sb)"
      and U: "\<forall>y. scb_decomp (Mark (Pred M) (s84x_jm3 M)) (fst y)
                    (flatBT (Mark (Pred M) (transJm1 M))) (snd y)
                \<and> scb_decomp (Mark M (s84x_jm3 M)) (fst y)
                    (flatBT (Mark M (transJm1 M))) (snd y) \<longrightarrow> y = sb"
    define s where "s = fst sb"
    define b where "b = snd sb"
    have dP: "scb_decomp (Mark (Pred M) (s84x_jm3 M)) s
                (flatBT (Mark (Pred M) (transJm1 M))) b"
      and dM: "scb_decomp (Mark M (s84x_jm3 M)) s (flatBT (Mark M (transJm1 M))) b"
      using A s_def b_def by simp_all
    have neq: "Mark M (s84x_jm3 M) \<noteq> Mark M (transJm1 M)"
      by (rule s84d_Mark_neq[OF MR MP mM3 mM1 ltJ jm1lt])
    have sne: "s \<noteq> []"
    proof
      assume se: "s = []"
      have "(Mark M (s84x_jm3 M), Mark M (transJm1 M)) \<in> MarkedB"
        using dM unfolding MarkedB_def by auto
      hence "(Mark M (s84x_jm3 M) = Mark M (transJm1 M))
           \<longleftrightarrow> (\<exists>b'. scb_decomp (Mark M (s84x_jm3 M)) []
                      (flatBT (Mark M (transJm1 M))) b')"
        using m_7_2_scb_triviality(2) by blast
      moreover have "\<exists>b'. scb_decomp (Mark M (s84x_jm3 M)) []
                            (flatBT (Mark M (transJm1 M))) b'"
        using dM se by auto
      ultimately show False using neq by simp
    qed
    define body where "body = bpHeadT (transC2 M)"
    have c2b: "transC2 M = Dpt (transV M) body"
      using transC2_single_principal_head(2)[OF MR MP J1pos T1] body_def by simp
    have c2flat: "flatBT (transC2 M) = Dsym (transV M) # flatBT body"
      by (subst c2b) simp
    have flatEq: "flatBT (Mark M (s84x_jm3 M)) = s @ flatBT (transC2 M) @ b"
      using dM rm2 by (simp add: scb_decomp_def)
    have lef: "Mark M (s84x_jm3 M) = 0\<^sub>B
             \<or> (\<exists>t. Mark M (s84x_jm3 M) = Dpt (enat (entry M 1 (s84x_jm3 M))) t)"
      using Mark_leftend_form mM3 MR by blast
    have Mne: "Mark M (s84x_jm3 M) \<noteq> 0\<^sub>B"
    proof
      assume z: "Mark M (s84x_jm3 M) = 0\<^sub>B"
      have zeq: "[Zsym] = s @ flatBT (transC2 M) @ b" using flatEq z by simp
      have "Dsym (transV M) \<in> set [Zsym]"
        by (subst zeq) (simp add: c2flat)
      thus False by simp
    qed
    obtain t where Mform:
      "Mark M (s84x_jm3 M) = Dpt (enat (entry M 1 (s84x_jm3 M))) t"
      using lef Mne by blast
    have hdS: "hd s = Dsym (enat (entry M 1 (s84x_jm3 M)))"
    proof -
      have "Dsym (enat (entry M 1 (s84x_jm3 M))) # flatBT t
          = s @ flatBT (transC2 M) @ b" using flatEq Mform by simp
      hence "hd (s @ flatBT (transC2 M) @ b)
           = Dsym (enat (entry M 1 (s84x_jm3 M)))" by (metis list.sel(1))
      thus ?thesis using sne by (simp add: hd_append)
    qed
    have scons: "s = Dsym (enat (entry M 1 (s84x_jm3 M))) # tl s"
      using sne hdS by (metis list.exhaust_sel)
    show ?thesis
    proof (rule ex1I[of _ "(tl s, b)"])
      have dM': "scb_decomp (Trans (s84x_N M))
                   (Dsym (enat (entry M 1 (s84x_jm3 M))) # tl s)
                   (flatBT (transC2 M)) b"
        using dM scons rm2 reprM by metis
      have dP': "scb_decomp (Trans (Pred (s84x_N M)))
                   (Dsym (enat (entry M 1 (s84x_jm3 M))) # tl s)
                   (flatBT (transC1 M)) b"
        using dP scons c1v reprP by metis
      show "scb_decomp (Trans (s84x_N M))
              (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst (tl s, b))
              (flatBT (transC2 M)) (snd (tl s, b))
          \<and> scb_decomp (Trans (Pred (s84x_N M)))
              (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst (tl s, b))
              (flatBT (transC1 M)) (snd (tl s, b))"
        using dM' dP' by simp
    next
      fix y
      assume Hy: "scb_decomp (Trans (s84x_N M))
                    (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y)
                    (flatBT (transC2 M)) (snd y)
                \<and> scb_decomp (Trans (Pred (s84x_N M)))
                    (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y)
                    (flatBT (transC1 M)) (snd y)"
      have Hy': "scb_decomp (Mark (Pred M) (s84x_jm3 M))
                   (fst (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y, snd y))
                   (flatBT (Mark (Pred M) (transJm1 M)))
                   (snd (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y, snd y))
               \<and> scb_decomp (Mark M (s84x_jm3 M))
                   (fst (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y, snd y))
                   (flatBT (Mark M (transJm1 M)))
                   (snd (Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y, snd y))"
        using Hy rm2 c1v reprM reprP by simp
      have "(Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y, snd y) = sb"
        using U Hy' by blast
      hence "Dsym (enat (entry M 1 (s84x_jm3 M))) # fst y = s \<and> snd y = b"
        using s_def b_def by (metis fst_conv snd_conv)
      thus "y = (tl s, b)"
        by (metis list.sel(3) prod.collapse fst_conv snd_conv)
    qed
  qed
qed

subsection \<open>s84d: list-algebra helpers for the replicate formulas\<close>

lemma s84d_rep_shift:
  "xs @ concat (replicate m xs) = concat (replicate m xs) @ xs"
proof (induction m)
  case 0 show ?case by simp
next
  case (Suc m)
  have "xs @ concat (replicate (Suc m) xs) = xs @ (xs @ concat (replicate m xs))"
    by simp
  also have "\<dots> = xs @ (concat (replicate m xs) @ xs)" using Suc.IH by simp
  also have "\<dots> = (xs @ concat (replicate m xs)) @ xs" by simp
  also have "\<dots> = concat (replicate (Suc m) xs) @ xs" by simp
  finally show ?case .
qed

lemma s84d_concat_rep_snoc:
  assumes "1 \<le> n"
  shows "concat (replicate n xs) = concat (replicate (n - 1) xs) @ xs"
proof -
  obtain m where n: "n = Suc m" using assms by (cases n) auto
  have "concat (replicate (Suc m) xs) = xs @ concat (replicate m xs)" by simp
  also have "\<dots> = concat (replicate m xs) @ xs" by (rule s84d_rep_shift)
  finally show ?thesis using n by simp
qed

lemma s84d_set_concat_rep: "set (concat (replicate n xs)) \<subseteq> set xs"
  by (induction n) auto

subsection \<open>s84d: the \<open>L\<^sub>1\<close> recursion-data congruences\<close>

text \<open>Under the L5 hypothesis set, \<open>M\<close> satisfies (III), (IV) or (V), and the
  interior regime \<open>j\<^sub>-\<^sub>2 + 1 < j\<^sub>1\<close> is FORCED (under (III)/(IV) \<open>j\<^sub>-\<^sub>2 < j\<^sub>0 < j\<^sub>1\<close>
  by 展開規則の基本性質 (1); under (V) \<open>j\<^sub>-\<^sub>2 = j\<^sub>0\<close> and \<open>j\<^sub>0 + 1 < j\<^sub>1\<close> by the
  condition itself) — so the rightend-replacement lemma always applies.\<close>

lemma s84d_L5_branch:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
  shows "transCondIII M \<or> transCondIV M \<or> transCondV M"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have j1gt: "1 < Lng M - 1" using s84d_L4_regime[OF MST MPT hp nVI] by simp
  have L: "1 < Lng M" using j1gt by linarith
  have e1pos: "0 < entry M 1 (Lng M - 1)" by (rule s84c1_e1j1_pos[OF hp])
  have j0lt: "transJ0 M < Lng M - 1"
    by (rule s84c1_nextR0_j0(2)[OF MPT]) (use j1gt in linarith)
  show ?thesis
  proof (cases "entry M 1 (transJ0 M) \<ge> entry M 1 (Lng M - 1)")
    case True
    show ?thesis
    proof (cases "adm M (transJ0 M)")
      case True'': True
      have "transCondIII M"
        unfolding transCondIII_def transJ0_def transJ1_def
        using e1pos True True'' by (simp add: transJ0_def transJ1_def)
      thus ?thesis by simp
    next
      case False
      have "transCondIV M"
        unfolding transCondIV_def
        using e1pos True False by (simp add: transJ0_def transJ1_def)
      thus ?thesis by simp
    qed
  next
    case False
    have estep: "entry M 1 (transJ0 M) + 1 = entry M 1 (Lng M - 1)"
      using row1_last_bound[OF MR MPT L] False
      by (simp add: transJ0_def transJ1_def)
    have "transJ0 M + 1 \<noteq> Lng M - 1"
    proof
      assume h: "transJ0 M + 1 = Lng M - 1"
      have "transCondVI M"
        unfolding transCondVI_def
        using e1pos estep h by (simp add: transJ0_def transJ1_def)
      thus False using nVI by simp
    qed
    hence "transJ0 M + 1 < Lng M - 1" using j0lt by linarith
    hence "transCondV M"
      unfolding transCondV_def
      using e1pos estep by (simp add: transJ0_def transJ1_def)
    thus ?thesis by simp
  qed
qed

lemma s84d_L5_rng:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
  shows "s84x_jm2 M + 1 < Lng M - 1"
proof -
  have j1gt: "1 < Lng M - 1" using s84d_L4_regime[OF MST MPT hp nVI] by simp
  have j0lt: "transJ0 M < Lng M - 1"
    by (rule s84c1_nextR0_j0(2)[OF MPT]) (use j1gt in linarith)
  from s84d_L5_branch[OF MST MPT hp nVI]
  show ?thesis
  proof (elim disjE)
    assume "transCondIII M"
    hence "s84x_jm2 M < transJ0 M"
      using m_8_4_oper_props_1(1)[OF MST MPT hp j1gt] by simp
    thus ?thesis using j0lt by linarith
  next
    assume "transCondIV M"
    hence "s84x_jm2 M < transJ0 M"
      using m_8_4_oper_props_1(1)[OF MST MPT hp j1gt] by simp
    thus ?thesis using j0lt by linarith
  next
    assume V: "transCondV M"
    hence "s84x_jm2 M = transJ0 M"
      using m_8_4_oper_props_1(2)[OF MST MPT hp j1gt] by simp
    moreover have "transJ0 M + 1 < Lng M - 1"
      using V by (simp add: transCondV_def transJ0_def transJ1_def)
    ultimately show ?thesis by simp
  qed
qed

text \<open>\<open>L\<^sub>1 = M[1] \<oplus> ((M\<^bsub>0,j\<^sub>1\<^esub>, M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>))\<close> shares ALL the surgery recursion data
  with \<open>M\<close>: predecessor, \<open>j\<^sub>0\<close>, \<open>j\<^sub>-\<^sub>1\<close>, \<open>c\<^sub>1\<close>, \<open>v\<close>, \<open>t\<^sub>2\<close>, \<open>t\<^sub>1\<close> (validated
  B_jm1/B_c1/B_s1b1 496/496).  The \<open>Adm\<close>-agreement at \<open>j\<^sub>0\<close> is by row-1 edge
  congruence below \<open>j\<^sub>1\<close>; at the corner \<open>j\<^sub>0 + 1 = j\<^sub>1\<close> both sides are
  admissible (a row-1 edge \<open>(1,j\<^sub>0) \<rightarrow> (1,j\<^sub>1)\<close> would need
  \<open>M\<^bsub>1,j\<^sub>0\<^esub> < M\<^bsub>1,j\<^sub>1\<^esub>\<close> resp. \<open>M\<^bsub>1,j\<^sub>0\<^esub> < M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>\<close>, contradicting the
  dichotomy resp. \<open>M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub> \<le> M\<^bsub>1,j\<^sub>0\<^esub>\<close>).\<close>

lemma s84d_L1_data:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
  shows "s84x_L M 1 \<in> RT_PS"
    and "s84x_L M 1 \<in> PT_PS"
    and "Pred (s84x_L M 1) = Pred M"
    and "Lng (s84x_L M 1) = Lng M"
    and "transJ0 (s84x_L M 1) = transJ0 M"
    and "transJm1 (s84x_L M 1) = transJm1 M"
    and "transC1 (s84x_L M 1) = transC1 M"
    and "transV (s84x_L M 1) = transV M"
    and "transT2 (s84x_L M 1) = transT2 M"
    and "transT1 (s84x_L M 1) = transT1 M"
    and "0 < transJ1 (s84x_L M 1)"
proof -
  let ?L = "s84x_L M 1"
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MPT by (simp add: PT_PS_def)
  have j1gt: "1 < Lng M - 1" using s84d_L4_regime[OF MST MPT hp nVI] by simp
  have j1gt0: "0 < Lng M - 1" using j1gt by simp
  have L: "1 < Lng M" using j1gt by linarith
  show L1RT: "?L \<in> RT_PS" by (rule m_8_4_oper_props_2(1)[OF MST MPT hp j1gt]) simp
  have L1mono: "monoT ?L" by (rule m_8_4_oper_props_2(2)[OF MST MPT hp j1gt]) simp
  show L1PT: "?L \<in> PT_PS"
    using L1RT L1mono by (simp add: PT_PS_def RT_PS_def)
  show PredL1: "Pred ?L = Pred M"
    using s84c1_Pred_L[OF hp j1gt0, of 1] m_8_4_oper1_eq_Pred[OF MT] by simp
  show LngL1: "Lng ?L = Lng M" by (rule s84c1_L1_Lng[OF MT hp j1gt0])
  show T1L1: "transT1 ?L = transT1 M" by (simp only: transT1_def PredL1)
  show J1posL1: "0 < transJ1 ?L" using LngL1 j1gt by (simp add: transJ1_def)
  \<comment> \<open>row-0 parent congruence\<close>
  have E0: "\<And>j. j < Lng M \<Longrightarrow> entry ?L 0 j = entry M 0 j"
    by (rule s84c1_L1_entry0[OF MT hp j1gt0])
  have E1: "\<And>j. j < Lng M - 1 \<Longrightarrow> entry ?L 1 j = entry M 1 j"
    by (rule s84c1_L1_entry1_lt[OF MT hp j1gt0])
  have E1j1: "entry ?L 1 (Lng M - 1) = entry M 1 (s84x_jm2 M)"
    by (rule s84c1_L1_entry1_j1[OF MT hp j1gt0])
  have n0cong: "\<And>a b. nextrel0 ?L a b \<longleftrightarrow> nextrel0 M a b"
    by (rule s84c1_nextrel0_cong[OF LngL1 E0])
  have hp0M: "hasParent M 0 (Lng M - 1)" by (rule s84c1_hp0[OF MPT j1gt0])
  have edge0M: "nextR M 0 (transJ0 M) (Lng M - 1)"
    by (rule s84c1_nextR0_j0(1)[OF MPT j1gt0])
  have j0lt: "transJ0 M < Lng M - 1"
    by (rule s84c1_nextR0_j0(2)[OF MPT j1gt0])
  have pL1: "parent ?L 0 (Lng M - 1) = transJ0 M"
  proof (rule parent0_eqI)
    show "nextR ?L 0 (transJ0 M) (Lng M - 1)"
      using edge0M n0cong by (simp add: nextR_def)
    fix b assume "nextR ?L 0 b (Lng M - 1)"
    hence "nextR M 0 b (Lng M - 1)" using n0cong by (simp add: nextR_def)
    thus "b = transJ0 M" using hp0M edge0M unfolding hasParent_def by blast
  qed
  show tJ0: "transJ0 ?L = transJ0 M"
    using pL1 LngL1 by (simp add: transJ0_def transJ1_def)
  \<comment> \<open>\<open>Adm\<close> agreement at \<open>j\<^sub>0\<close>\<close>
  have n1c: "\<And>a b. b < Lng M - 1 \<Longrightarrow> nextrel1 ?L a b \<longleftrightarrow> nextrel1 M a b"
    by (rule s84c1_nextrel1_cong[OF LngL1 E0 E1])
  have admcong: "\<And>j. j + 1 < Lng M - 1 \<Longrightarrow> adm ?L j \<longleftrightarrow> adm M j"
  proof -
    fix j assume jlt: "j + 1 < Lng M - 1"
    have b1: "j < Lng M - 1" and b2: "j + 1 < Lng M - 1" using jlt by simp_all
    show "adm ?L j \<longleftrightarrow> adm M j"
      unfolding adm_def nadm_def nextR_def
      using n1c[OF b1, of "j - 1"] n1c[OF b2, of j] LngL1 by simp
  qed
  have e1le: "entry M 1 (s84x_jm2 M) \<le> entry M 1 (transJ0 M)"
    by (rule s84c1_e1_jm2_le_j0[OF MPT hp j1gt0])
  have AdmL1: "Adm ?L (transJ0 M) = Adm M (transJ0 M)"
  proof (cases "transJ0 M + 1 < Lng M - 1")
    case interior: True
    have admj0: "adm ?L (transJ0 M) \<longleftrightarrow> adm M (transJ0 M)"
      by (rule admcong[OF interior])
    show ?thesis
    proof (cases "adm M (transJ0 M)")
      case True
      thus ?thesis using admj0 by (simp add: Adm_def)
    next
      case False
      have seteq: "{j'. adm ?L j' \<and> j' < transJ0 M} = {j'. adm M j' \<and> j' < transJ0 M}"
      proof -
        have "\<And>j'. j' < transJ0 M \<Longrightarrow> adm ?L j' \<longleftrightarrow> adm M j'"
        proof -
          fix j' assume "j' < transJ0 M"
          hence "j' + 1 < Lng M - 1" using j0lt by linarith
          thus "adm ?L j' \<longleftrightarrow> adm M j'" by (rule admcong)
        qed
        thus ?thesis by auto
      qed
      show ?thesis using False admj0 seteq by (simp add: Adm_def)
    qed
  next
    case corner: False
    hence j0Suc: "transJ0 M + 1 = Lng M - 1" using j0lt by linarith
    have e1pos: "0 < entry M 1 (Lng M - 1)" by (rule s84c1_e1j1_pos[OF hp])
    have admM: "adm M (transJ0 M)"
    proof (rule ccontr)
      assume "\<not> adm M (transJ0 M)"
      hence "nextR M 1 (transJ0 M) (transJ0 M + 1)"
        using j0lt by (auto simp: adm_def nadm_def)
      hence e1st: "entry M 1 (transJ0 M) < entry M 1 (Lng M - 1)"
        using j0Suc by (simp add: nextR_def nextrel1_def)
      have "entry M 1 (transJ0 M) \<ge> entry M 1 (Lng M - 1)
          \<or> entry M 1 (transJ0 M) + 1 = entry M 1 (Lng M - 1)"
        using row1_last_bound[OF MR MPT L] by (simp add: transJ0_def transJ1_def)
      hence estep: "entry M 1 (transJ0 M) + 1 = entry M 1 (Lng M - 1)"
        using e1st by linarith
      have "transCondVI M"
        unfolding transCondVI_def
        using e1pos estep j0Suc by (simp add: transJ0_def transJ1_def)
      thus False using nVI by simp
    qed
    have admL: "adm ?L (transJ0 M)"
    proof (rule ccontr)
      assume "\<not> adm ?L (transJ0 M)"
      hence "nextR ?L 1 (transJ0 M) (transJ0 M + 1)"
        using LngL1 j0lt by (auto simp: adm_def nadm_def)
      hence "entry ?L 1 (transJ0 M) < entry ?L 1 (Lng M - 1)"
        using j0Suc by (simp add: nextR_def nextrel1_def)
      hence "entry M 1 (transJ0 M) < entry M 1 (s84x_jm2 M)"
        using E1[OF j0lt] E1j1 by simp
      thus False using e1le by simp
    qed
    show ?thesis using admM admL by (simp add: Adm_def)
  qed
  show tJm1: "transJm1 ?L = transJm1 M"
    using AdmL1 tJ0 by (simp add: transJm1_def)
  show tC1: "transC1 ?L = transC1 M"
    unfolding transC1_def PredL1 tJm1 by (rule refl)
  show "transV ?L = transV M" unfolding transV_def tC1 by (rule refl)
  show "transT2 ?L = transT2 M" unfolding transT2_def tC1 by (rule refl)
qed

text \<open>The \<open>L\<^sub>1\<close> instance of the hole engine: \<open>transC2 L\<^sub>1 = s84d_c2hole M (M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>)\<close>
  (validated B_hole 496/496).  Case split on \<open>adm M j\<^sub>0\<close>; the regularity
  hypothesis \<open>j\<^sub>-\<^sub>2 < j\<^sub>0 \<or> adm M j\<^sub>0\<close> aligns the branch of \<open>L\<^sub>1\<close> (基本性質 (4))
  with the branch of \<open>M\<close> (under (V), \<open>j\<^sub>-\<^sub>2 = j\<^sub>0\<close> forces \<open>adm M j\<^sub>0\<close>).\<close>

lemma s84d_c2hole_L1:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
    and reg: "s84x_jm2 M < transJ0 M \<or> adm M (transJ0 M)"
  shows "transC2 (s84x_L M 1) = s84d_c2hole M (entry M 1 (s84x_jm2 M))"
proof -
  let ?L = "s84x_L M 1"
  have MT: "M \<in> T_PS" using MPT by (simp add: PT_PS_def)
  have j1gt: "1 < Lng M - 1" using s84d_L4_regime[OF MST MPT hp nVI] by simp
  have j1gt0: "0 < Lng M - 1" using j1gt by simp
  note data = s84d_L1_data[OF MST MPT hp nVI]
  have LngL1: "Lng ?L = Lng M" by (rule data(4))
  have tJ0: "transJ0 ?L = transJ0 M" by (rule data(5))
  have tV: "transV ?L = transV M" by (rule data(8))
  have tT2: "transT2 ?L = transT2 M" by (rule data(9))
  have E1: "\<And>j. j < Lng M - 1 \<Longrightarrow> entry ?L 1 j = entry M 1 j"
    by (rule s84c1_L1_entry1_lt[OF MT hp j1gt0])
  have E1j1: "entry ?L 1 (Lng M - 1) = entry M 1 (s84x_jm2 M)"
    by (rule s84c1_L1_entry1_j1[OF MT hp j1gt0])
  have j0lt: "transJ0 M < Lng M - 1"
    by (rule s84c1_nextR0_j0(2)[OF MPT j1gt0])
  have eJ0: "entry ?L 1 (transJ0 ?L) = entry M 1 (transJ0 M)"
    using tJ0 E1[OF j0lt] by simp
  have e1le: "entry M 1 (s84x_jm2 M) \<le> entry M 1 (transJ0 M)"
    by (rule s84c1_e1_jm2_le_j0[OF MPT hp j1gt0])
  have e1pos: "0 < entry M 1 (Lng M - 1)" by (rule s84c1_e1j1_pos[OF hp])
  have atL: "transC2 ?L = s84d_c2hole ?L (entry M 1 (s84x_jm2 M))"
    using s84d_c2hole_at_j1[of ?L] LngL1 E1j1 by simp
  have branch: "transCondIII M \<or> transCondIV M \<or> transCondV M"
    by (rule s84d_L5_branch[OF MST MPT hp nVI])
  show ?thesis
  proof (cases "adm M (transJ0 M)")
    case admj0: True
    \<comment> \<open>\<open>M\<close> takes the shared branch: (IV) is excluded by \<open>adm\<close>\<close>
    have gM: "transCondI M \<or> transCondIII M \<or> transCondV M"
      using branch admj0 by (auto simp: transCondIV_def transJ0_def transJ1_def)
    have gL: "transCondI ?L \<or> transCondIII ?L"
      by (rule m_8_4_oper_props_4(1)[OF MST MPT hp j1gt]) (use admj0 in blast)
    have hL: "s84d_c2hole ?L (entry M 1 (s84x_jm2 M))
            = Dpt (transV ?L) (transT2 ?L +\<^sub>B Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B)"
      using gL by (auto simp: s84d_c2hole_def Let_def)
    have hM: "s84d_c2hole M (entry M 1 (s84x_jm2 M))
            = Dpt (transV M) (transT2 M +\<^sub>B Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B)"
      using gM by (auto simp: s84d_c2hole_def Let_def)
    show ?thesis using atL hL hM tV tT2 by simp
  next
    case nadmj0: False
    \<comment> \<open>\<open>M \<in> (IV)\<close>; \<open>L\<^sub>1 \<in> (II)/(IV)\<close>: both take the surgery branch\<close>
    have MIV: "transCondIV M"
    proof -
      have nIII: "\<not> transCondIII M"
        using nadmj0 by (simp add: transCondIII_def transJ0_def transJ1_def)
      have nV: "\<not> transCondV M"
      proof
        assume V: "transCondV M"
        have "s84x_jm2 M = transJ0 M"
          using m_8_4_oper_props_1(2)[OF MST MPT hp j1gt] V by simp
        thus False using reg nadmj0 by simp
      qed
      show ?thesis using branch nIII nV by blast
    qed
    have e1ge: "entry M 1 (Lng M - 1) \<le> entry M 1 (transJ0 M)"
      using MIV by (simp add: transCondIV_def transJ0_def transJ1_def)
    have gM: "\<not> (transCondI M \<or> transCondIII M \<or> transCondV M)"
    proof -
      have "\<not> transCondI M"
        using e1pos by (simp add: transCondI_def transJ1_def)
      moreover have "\<not> transCondIII M"
        using nadmj0 by (simp add: transCondIII_def transJ0_def transJ1_def)
      moreover have "\<not> transCondV M"
      proof
        assume "transCondV M"
        hence "entry M 1 (transJ0 M) + 1 = entry M 1 (Lng M - 1)"
          by (simp add: transCondV_def transJ0_def transJ1_def)
        thus False using e1ge by simp
      qed
      ultimately show ?thesis by blast
    qed
    have gL24: "transCondII ?L \<or> transCondIV ?L"
      by (rule m_8_4_oper_props_4(2)[OF MST MPT hp j1gt nVI nadmj0])
    have nadmL: "\<not> adm ?L (transJ0 ?L)"
      using gL24 by (auto simp: transCondII_def transCondIV_def
                                transJ0_def transJ1_def)
    have gL: "\<not> (transCondI ?L \<or> transCondIII ?L \<or> transCondV ?L)"
    proof -
      have "\<not> transCondI ?L" and "\<not> transCondIII ?L"
        using nadmL by (auto simp: transCondI_def transCondIII_def
                                   transJ0_def transJ1_def)
      moreover have "\<not> transCondV ?L"
      proof
        assume "transCondV ?L"
        hence "entry ?L 1 (transJ0 ?L) + 1 = entry ?L 1 (Lng ?L - 1)"
          by (simp add: transCondV_def transJ0_def transJ1_def)
        hence "entry M 1 (transJ0 M) + 1 = entry M 1 (s84x_jm2 M)"
          using eJ0 E1j1 LngL1 by simp
        thus False using e1le by simp
      qed
      ultimately show ?thesis by blast
    qed
    have nVIL: "\<not> transCondVI ?L"
    proof
      assume "transCondVI ?L"
      hence "entry ?L 1 (transJ0 ?L) + 1 = entry ?L 1 (Lng ?L - 1)"
        by (simp add: transCondVI_def transJ0_def transJ1_def)
      hence "entry M 1 (transJ0 M) + 1 = entry M 1 (s84x_jm2 M)"
        using eJ0 E1j1 LngL1 by simp
      thus False using e1le by simp
    qed
    show ?thesis
    proof (cases "transT2 M = 0\<^sub>B")
      case t2z: True
      have t2zL: "transT2 ?L = 0\<^sub>B" using tT2 t2z by simp
      have hL: "s84d_c2hole ?L (entry M 1 (s84x_jm2 M))
              = Dpt (transV ?L) (Dpt (enat (entry ?L 1 (transJ0 ?L)))
                                     (Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B))"
        using gL nVIL t2zL by (simp add: s84d_c2hole_def Let_def)
      have hM: "s84d_c2hole M (entry M 1 (s84x_jm2 M))
              = Dpt (transV M) (Dpt (enat (entry M 1 (transJ0 M)))
                                    (Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B))"
        using gM nVI t2z by (simp add: s84d_c2hole_def Let_def)
      show ?thesis using atL hL hM tV eJ0 by simp
    next
      case t2n: False
      have t2nL: "transT2 ?L \<noteq> 0\<^sub>B" using tT2 t2n by simp
      define t2 where "t2 = transT2 M"
      define JJ1 where "JJ1 = Lng (PB t2) - 1"
      define pj where "pj = PB t2 ! JJ1"
      define ldj where "ldj = (bpHeadV pj = enat (entry M 1 (transJ0 M)))"
      define t3 where "t3 = (if ldj then SigmaB (take JJ1 (PB t2)) else t2)"
      define t4 where "t4 = (if ldj then bpHeadT pj else t2)"
      have hM: "s84d_c2hole M (entry M 1 (s84x_jm2 M))
              = Dpt (transV M)
                  (t3 +\<^sub>B Dpt (enat (entry M 1 (transJ0 M)))
                          (t4 +\<^sub>B Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B))"
        using gM nVI t2n
        by (simp add: s84d_c2hole_def Let_def t3_def t4_def ldj_def pj_def
                      JJ1_def t2_def)
      have hL: "s84d_c2hole ?L (entry M 1 (s84x_jm2 M))
              = Dpt (transV ?L)
                  (t3 +\<^sub>B Dpt (enat (entry ?L 1 (transJ0 ?L)))
                          (t4 +\<^sub>B Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B))"
        using gL nVIL t2nL tT2 eJ0
        by (simp add: s84d_c2hole_def Let_def t3_def t4_def ldj_def pj_def
                      JJ1_def t2_def)
      show ?thesis using atL hL hM tV eJ0 by simp
    qed
  qed
qed

subsection \<open>s84d: L5 補題（条件(III)～(V)の下での各種scb分解）, modulo the
  §8.2 terminal-slice transport\<close>

text \<open>The FULL conclusion of L5 (content.md 4702, conjuncts (1)–(5); stage-1
  statement \<open>m_8_4_various_scb_IIIV\<close>) from the two BLOCKED transport facts as
  explicit hypotheses: \<open>d2\<close> = L4 part (2) (the \<open>c\<^sub>2\<close>-decomposition transported
  to \<open>Trans N'\<close> with head \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>2\<^esub>\<close>) and \<open>d3\<close> = L4 part (3)
  (\<open>Trans (Pred N') = D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>2\<^esub> t\<^sub>2\<close>) — both are consequences of the unproven
  \<open>p_8_2_condV_terminal_slice_Trans\<close> (pss_paper 1604), the SINGLE remaining
  residual of the §8.4 various-scb cluster.  Everything else of the article's
  proof is discharged here: (1) by @{thm [source] s84d_c2_rightmost_scb},
  (2b) (\<open>Trans L'\<close>) by @{thm [source] m_8_4_rightend_Trans} (the interior
  regime is forced, @{thm [source] s84d_L5_rng}), the \<open>L\<^sub>n\<close>/\<open>M[n]\<close> formulas
  (4)(5) by induction gluing @{thm [source] m_8_4_oper_props_5} with the
  \<open>L\<^sub>1\<close> base case (@{thm [source] s84d_c2hole_L1} + the hole engine).
  Empirical: all conjuncts 496/496 + 387/387, formulas 1341/1341 + 1096/1096
  (python/_r15_s4d_validate.py, _r15_s4d_condIV_L6.py).\<close>

lemma m_8_4_various_scb_IIIV_from_slice:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and nVI: "\<not> transCondVI M"
    and reg: "s84x_jm2 M < transJ0 M \<or> adm M (transJ0 M)"
    and admeq: "Adm M (s84x_jm2 M) = transJm1 M"
    and n1: "n \<ge> 1"
    and d1: "scb_decomp (transC2 M)
               (Dsym (enat (entry M 1 (transJm1 M))) # s1')
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b1'"
    and d2: "scb_decomp (Trans (s84x_Np M))
               (Dsym (enat (entry M 1 (s84x_jm2 M))) # s1')
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b1'"
    and d3: "Trans (Pred (s84x_Np M)) = Dpt (enat (entry M 1 (s84x_jm2 M))) (transT2 M)"
  shows "\<exists>!sb. scb_decomp (transC2 M)
                 (Dsym (enat (entry M 1 (transJm1 M))) # fst sb)
                 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) (snd sb)
             \<and> scb_decomp (Trans (s84x_Np M))
                 (Dsym (enat (entry M 1 (s84x_jm2 M))) # fst sb)
                 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) (snd sb)
             \<and> scb_decomp (Trans (s84x_Lp M))
                 (Dsym (enat (entry M 1 (s84x_jm2 M))) # fst sb)
                 (flatBT (Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B)) (snd sb)
             \<and> Trans (Pred (s84x_Np M))
                 = Dpt (enat (entry M 1 (s84x_jm2 M))) (transT2 M)
             \<and> flatBT (Trans (s84x_L M n))
                 = s84x_s1 M @ Dsym (enat (entry M 1 (transJm1 M)))
                     # concat (replicate n
                         (fst sb @ [Dsym (enat (entry M 1 (s84x_jm2 M)))]))
                     @ [Zsym] @ concat (replicate n (snd sb)) @ s84x_b1 M
             \<and> flatBT (Trans ((M::pairseq)[n]))
                 = s84x_s1 M @ Dsym (enat (entry M 1 (transJm1 M)))
                     # concat (replicate (n - 1)
                         (fst sb @ [Dsym (enat (entry M 1 (s84x_jm2 M)))]))
                     @ flatBT (transT2 M)
                     @ concat (replicate (n - 1) (snd sb)) @ s84x_b1 M"
proof -
  let ?e1jm1 = "entry M 1 (transJm1 M)"
  let ?e1jm2 = "entry M 1 (s84x_jm2 M)"
  let ?e1j1 = "entry M 1 (Lng M - 1)"
  let ?blkS = "s1' @ [Dsym (enat ?e1jm2)]"
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MPT by (simp add: PT_PS_def)
  have j1gt: "1 < Lng M - 1" and T1: "transT1 M \<noteq> 0\<^sub>B"
    using s84d_L4_regime[OF MST MPT hp nVI] by simp_all
  have j1gt0: "0 < Lng M - 1" using j1gt by simp
  have J1pos: "transJ1 M > 0" using j1gt by (simp add: transJ1_def)
  have rng: "s84x_jm2 M + 1 < Lng M - 1" by (rule s84d_L5_rng[OF MST MPT hp nVI])
  have T1ne: "Trans (Pred M) \<noteq> Trm []" using T1 by (simp add: transT1_def)
  \<comment> \<open>the shared surgery wrappers \<open>(s\<^sub>1, b\<^sub>1)\<close> and the \<open>THE\<close>-pinning\<close>
  obtain s1 b1 where
    dc1: "scb_decomp (Trans (Pred M)) s1 (flatBT (transC1 M)) b1"
    and dc2M: "scb_decomp (Trans M) s1 (flatBT (transC2 M)) b1"
    by (rule s84c2_Trans_c2_decomp[OF MR MPT J1pos T1])
  have s1b1ex1: "\<exists>!sb. scb_decomp (transT1 M) (fst sb) (flatBT (transC1 M)) (snd sb)"
  proof (rule ex1I[of _ "(s1, b1)"])
    show "scb_decomp (transT1 M) (fst (s1, b1)) (flatBT (transC1 M)) (snd (s1, b1))"
      using dc1 by (simp add: transT1_def)
  next
    fix y
    assume "scb_decomp (transT1 M) (fst y) (flatBT (transC1 M)) (snd y)"
    hence "fst y = s1 \<and> snd y = b1"
      using m_7_2_scb_unique_sb[OF _ dc1 T1ne] by (simp add: transT1_def)
    thus "y = (s1, b1)" by (simp add: prod_eq_iff)
  qed
  have theSB: "(THE sb. scb_decomp (transT1 M) (fst sb) (flatBT (transC1 M)) (snd sb))
             = (s1, b1)"
    by (rule the1_equality[OF s1b1ex1]) (use dc1 in \<open>simp add: transT1_def\<close>)
  have s1val: "s84x_s1 M = s1" and b1val: "s84x_b1 M = b1"
    using theSB by (simp_all add: s84x_s1_def s84x_b1_def)
  \<comment> \<open>pin \<open>(s1', b1')\<close> against the hole engine\<close>
  have vval: "transV M = enat ?e1jm1"
    by (rule m_8_5_scbdec_c1_shape(1)[OF MR MPT J1pos T1])
  have c1shape: "transC1 M = Dpt (enat ?e1jm1) (transT2 M)"
    by (rule m_8_5_scbdec_c1_shape(2)[OF MR MPT J1pos T1])
  obtain w w' where
    W: "\<forall>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
              (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
    using s84d_c2hole_scb[OF MR MPT J1pos T1] by blast
  have Wj1: "scb_decomp (transC2 M) (Dsym (enat ?e1jm1) # w)
               (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) w'"
    using W[rule_format, of ?e1j1]
    unfolding s84d_c2hole_at_j1[symmetric] vval .
  define body where "body = bpHeadT (transC2 M)"
  have c2b: "transC2 M = Dpt (transV M) body"
    using transC2_single_principal_head(2)[OF MR MPT J1pos T1] body_def by simp
  have c2ne: "transC2 M \<noteq> Trm []" by (subst c2b) simp
  have pinW: "s1' = w \<and> b1' = w'"
    using m_7_2_scb_unique_sb[OF d1 Wj1 c2ne] by simp
  have Wjm2: "scb_decomp (s84d_c2hole M ?e1jm2) (Dsym (enat ?e1jm1) # s1')
                (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) b1'"
    using W[rule_format, of ?e1jm2] pinW vval by simp
  \<comment> \<open>conjunct (3): \<open>Trans L'\<close> via the rightend replacement (interior forced)\<close>
  have TNne: "Trans (s84x_Np M) \<noteq> Trm []"
  proof
    assume z: "Trans (s84x_Np M) = Trm []"
    have "flatBT (Trans (s84x_Np M))
        = (Dsym (enat ?e1jm2) # s1') @ flatBT (Dpt (enat ?e1j1) 0\<^sub>B) @ b1'"
      using d2 by (simp add: scb_decomp_def)
    hence "[Zsym] = Dsym (enat ?e1jm2) # s1' @ flatBT (Dpt (enat ?e1j1) 0\<^sub>B) @ b1'"
      using z by simp
    thus False by simp
  qed
  have cj3: "scb_decomp (Trans (s84x_Lp M)) (Dsym (enat ?e1jm2) # s1')
               (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) b1'"
  proof -
    obtain sb where
      re1: "scb_decomp (Trans (s84x_Np M)) (fst sb)
              (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (snd sb)"
      and re2: "scb_decomp (Trans (s84x_Lp M)) (fst sb)
                  (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sb)"
      using ex1_implies_ex[OF m_8_4_rightend_Trans[OF MST MPT hp rng]] by auto
    have "fst sb = Dsym (enat ?e1jm2) # s1' \<and> snd sb = b1'"
      using m_7_2_scb_unique_sb[OF re1 d2 TNne] by simp
    thus ?thesis using re2 by simp
  qed
  \<comment> \<open>the \<open>L\<^sub>1\<close> base case\<close>
  note data = s84d_L1_data[OF MST MPT hp nVI]
  have L1T1ne: "transT1 (s84x_L M 1) \<noteq> 0\<^sub>B" using data(10) T1 by simp
  obtain s1L b1L where
    dc1L: "scb_decomp (Trans (Pred (s84x_L M 1))) s1L
             (flatBT (transC1 (s84x_L M 1))) b1L"
    and dc2L: "scb_decomp (Trans (s84x_L M 1)) s1L
                 (flatBT (transC2 (s84x_L M 1))) b1L"
    by (rule s84c2_Trans_c2_decomp[OF data(1) data(2) data(11) L1T1ne])
  have dc1L': "scb_decomp (Trans (Pred M)) s1L (flatBT (transC1 M)) b1L"
    using dc1L data(3) data(7) by simp
  have sbL: "s1L = s1 \<and> b1L = b1"
    using m_7_2_scb_unique_sb[OF dc1L' dc1 T1ne] by simp
  have holeL1: "transC2 (s84x_L M 1) = s84d_c2hole M ?e1jm2"
    by (rule s84d_c2hole_L1[OF MST MPT hp nVI reg])
  have base5: "flatBT (Trans (s84x_L M 1))
             = s1 @ Dsym (enat ?e1jm1)
                 # concat (replicate 1 ?blkS) @ [Zsym]
                 @ concat (replicate 1 b1') @ b1"
  proof -
    have f1: "flatBT (Trans (s84x_L M 1))
            = s1 @ flatBT (transC2 (s84x_L M 1)) @ b1"
      using dc2L sbL by (simp add: scb_decomp_def)
    have f2: "flatBT (s84d_c2hole M ?e1jm2)
            = (Dsym (enat ?e1jm1) # s1') @ flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) @ b1'"
      using Wjm2 by (simp add: scb_decomp_def)
    show ?thesis using f1 f2 holeL1 by simp
  qed
  \<comment> \<open>auxiliary data for the induction\<close>
  have b1RP: "\<forall>x \<in> set b1. x = RP" using dc1 by (simp add: scb_decomp_def)
  have b1pRP: "\<forall>x \<in> set b1'. x = RP" using d1 by (simp add: scb_decomp_def)
  have ipta: "\<And>a::nat. isPTB_str (flatBT (Dpt (enat a) 0\<^sub>B))"
    by (rule isPTB_str_Dpt) simp_all
  have Lnne: "\<And>m. 1 \<le> m \<Longrightarrow> Trans (s84x_L M m) \<noteq> Trm []"
  proof -
    fix m :: nat assume m1: "1 \<le> m"
    have w1: "1 \<le> Lng M - 1 - s84x_jm2 M" using rng by linarith
    have "1 * 1 \<le> m * (Lng M - 1 - s84x_jm2 M)" by (rule mult_le_mono[OF m1 w1])
    hence "0 < Lng ((M::pairseq)[m])"
      using s84c1_Lng_oper[OF hp j1gt0, of m] by linarith
    hence "1 < Lng (s84x_L M m)" using s84c1_Lng_L[of M m] by simp
    hence "\<not> zeroT (s84x_L M m)" by (auto simp: zeroT_def)
    thus "Trans (s84x_L M m) \<noteq> Trm []"
      using m_7_3_Trans_zeroT[OF m_8_4_oper_props_2(1)[OF MST MPT hp j1gt m1]]
      by simp
  qed
  \<comment> \<open>formula (4): induction on \<open>m\<close>\<close>
  have F5: "\<And>m. 1 \<le> m \<Longrightarrow>
              flatBT (Trans (s84x_L M m))
            = s1 @ Dsym (enat ?e1jm1)
                # concat (replicate m ?blkS) @ [Zsym]
                @ concat (replicate m b1') @ b1"
  proof -
    fix m :: nat assume "1 \<le> m"
    thus "flatBT (Trans (s84x_L M m))
        = s1 @ Dsym (enat ?e1jm1)
            # concat (replicate m ?blkS) @ [Zsym]
            @ concat (replicate m b1') @ b1"
    proof (induction m)
      case 0 thus ?case by simp
    next
      case (Suc m)
      show ?case
      proof (cases "m = 0")
        case True
        thus ?thesis using base5 by simp
      next
        case False
        hence m1: "1 \<le> m" by simp
        have IH: "flatBT (Trans (s84x_L M m))
                = s1 @ Dsym (enat ?e1jm1)
                    # concat (replicate m ?blkS) @ [Zsym]
                    @ concat (replicate m b1') @ b1"
          using Suc.IH m1 by simp
        \<comment> \<open>re-read the IH string as an scb-decomposition around \<open>D\<^bsub>j\<^sub>-\<^sub>2\<^esub> 0\<close>\<close>
        define S where
          "S = s1 @ Dsym (enat ?e1jm1) # concat (replicate (m - 1) ?blkS) @ s1'"
        define B where "B = concat (replicate m b1') @ b1"
        have splitS: "Dsym (enat ?e1jm1) # concat (replicate m ?blkS) @ [Zsym]
                    = (Dsym (enat ?e1jm1) # concat (replicate (m - 1) ?blkS) @ s1')
                      @ [Dsym (enat ?e1jm2), Zsym]"
        proof -
          have "concat (replicate m ?blkS)
              = concat (replicate (m - 1) ?blkS) @ ?blkS"
            by (rule s84d_concat_rep_snoc[OF m1])
          thus ?thesis by simp
        qed
        have flatD: "flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) = [Dsym (enat ?e1jm2), Zsym]"
          by simp
        have flatSplit: "flatBT (Trans (s84x_L M m))
                       = S @ flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) @ B"
          using IH splitS by (simp add: S_def B_def flatD)
        have BRP: "\<forall>x \<in> set B. x = RP"
        proof
          fix x assume "x \<in> set B"
          hence "x \<in> set (concat (replicate m b1')) \<or> x \<in> set b1"
            by (auto simp: B_def)
          thus "x = RP" using s84d_set_concat_rep[of m b1'] b1pRP b1RP by auto
        qed
        have dLm: "scb_decomp (Trans (s84x_L M m)) S
                     (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) B"
          unfolding scb_decomp_def using flatSplit BRP ipta by simp
        \<comment> \<open>glue with 基本性質 (5) at \<open>Suc m\<close>\<close>
        have Sm2: "1 < Suc m" using m1 by simp
        obtain sbx where
          p51: "scb_decomp (Trans (s84x_L M (Suc m - 1))) (fst sbx)
                  (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbx)"
          and p52: "scb_decomp (Trans (s84x_L M (Suc m))) (fst sbx)
                      (flatBT (Trans (s84x_Lp M))) (snd sbx)"
          using ex1_implies_ex[OF m_8_4_oper_props_5[OF MST MPT hp j1gt Sm2]]
          by auto
        have p51': "scb_decomp (Trans (s84x_L M m)) (fst sbx)
                      (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbx)"
          using p51 by simp
        have pinX: "fst sbx = S \<and> snd sbx = B"
          using m_7_2_scb_unique_sb[OF p51' dLm Lnne[OF m1]] by simp
        have fSuc: "flatBT (Trans (s84x_L M (Suc m)))
                  = S @ flatBT (Trans (s84x_Lp M)) @ B"
          using p52 pinX by (simp add: scb_decomp_def)
        have fLp: "flatBT (Trans (s84x_Lp M))
                 = Dsym (enat ?e1jm2) # s1' @ [Dsym (enat ?e1jm2), Zsym] @ b1'"
          using cj3 by (simp add: scb_decomp_def)
        \<comment> \<open>reassemble to the \<open>Suc m\<close> formula\<close>
        have blkgrow: "concat (replicate (m - 1) ?blkS) @ s1' @ [Dsym (enat ?e1jm2)]
                     = concat (replicate m ?blkS)"
          using s84d_concat_rep_snoc[OF m1, of ?blkS] by simp
        have bgrow: "b1' @ concat (replicate m b1') = concat (replicate (Suc m) b1')"
          by simp
        have "flatBT (Trans (s84x_L M (Suc m)))
            = s1 @ Dsym (enat ?e1jm1)
                # concat (replicate (m - 1) ?blkS) @ s1'
                @ (Dsym (enat ?e1jm2) # s1' @ [Dsym (enat ?e1jm2), Zsym] @ b1')
                @ concat (replicate m b1') @ b1"
          using fSuc fLp by (simp add: S_def B_def)
        also have "\<dots> = s1 @ Dsym (enat ?e1jm1)
                # (concat (replicate (m - 1) ?blkS) @ s1' @ [Dsym (enat ?e1jm2)])
                @ (s1' @ [Dsym (enat ?e1jm2)]) @ [Zsym]
                @ (b1' @ concat (replicate m b1')) @ b1"
          by simp
        also have "\<dots> = s1 @ Dsym (enat ?e1jm1)
                # concat (replicate m ?blkS) @ ?blkS @ [Zsym]
                @ concat (replicate (Suc m) b1') @ b1"
          using blkgrow bgrow by simp
        also have "\<dots> = s1 @ Dsym (enat ?e1jm1)
                # concat (replicate (Suc m) ?blkS) @ [Zsym]
                @ concat (replicate (Suc m) b1') @ b1"
          using s84d_concat_rep_snoc[of "Suc m" ?blkS] by simp
        finally show ?thesis .
      qed
    qed
  qed
  \<comment> \<open>formula (5)\<close>
  have F6: "\<And>m. 1 \<le> m \<Longrightarrow>
              flatBT (Trans ((M::pairseq)[m]))
            = s1 @ Dsym (enat ?e1jm1)
                # concat (replicate (m - 1) ?blkS) @ flatBT (transT2 M)
                @ concat (replicate (m - 1) b1') @ b1"
  proof -
    fix m :: nat assume m1: "1 \<le> m"
    show "flatBT (Trans ((M::pairseq)[m]))
        = s1 @ Dsym (enat ?e1jm1)
            # concat (replicate (m - 1) ?blkS) @ flatBT (transT2 M)
            @ concat (replicate (m - 1) b1') @ b1"
    proof (cases "m = 1")
      case True
      have "flatBT (Trans ((M::pairseq)[1])) = flatBT (Trans (Pred M))"
        using m_8_4_oper1_eq_Pred[OF MT] by simp
      also have "\<dots> = s1 @ flatBT (transC1 M) @ b1"
        using dc1 by (simp add: scb_decomp_def)
      also have "\<dots> = s1 @ Dsym (enat ?e1jm1) # flatBT (transT2 M) @ b1"
        using c1shape by simp
      finally show ?thesis using True by simp
    next
      case False
      hence m2: "1 < m" using m1 by simp
      have m11: "1 \<le> m - 1" using m2 by simp
      have IH5: "flatBT (Trans (s84x_L M (m - 1)))
               = s1 @ Dsym (enat ?e1jm1)
                   # concat (replicate (m - 1) ?blkS) @ [Zsym]
                   @ concat (replicate (m - 1) b1') @ b1"
        by (rule F5[OF m11])
      define S where
        "S = s1 @ Dsym (enat ?e1jm1) # concat (replicate (m - 1 - 1) ?blkS) @ s1'"
      define B where "B = concat (replicate (m - 1) b1') @ b1"
      have splitS: "Dsym (enat ?e1jm1) # concat (replicate (m - 1) ?blkS) @ [Zsym]
                  = (Dsym (enat ?e1jm1) # concat (replicate (m - 1 - 1) ?blkS) @ s1')
                    @ [Dsym (enat ?e1jm2), Zsym]"
      proof -
        have "concat (replicate (m - 1) ?blkS)
            = concat (replicate (m - 1 - 1) ?blkS) @ ?blkS"
          by (rule s84d_concat_rep_snoc[OF m11])
        thus ?thesis by simp
      qed
      have flatSplit: "flatBT (Trans (s84x_L M (m - 1)))
                     = S @ flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) @ B"
        using IH5 splitS by (simp add: S_def B_def)
      have BRP: "\<forall>x \<in> set B. x = RP"
      proof
        fix x assume "x \<in> set B"
        hence "x \<in> set (concat (replicate (m - 1) b1')) \<or> x \<in> set b1"
          by (auto simp: B_def)
        thus "x = RP" using s84d_set_concat_rep[of "m - 1" b1'] b1pRP b1RP by auto
      qed
      have dLm: "scb_decomp (Trans (s84x_L M (m - 1))) S
                   (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) B"
        unfolding scb_decomp_def using flatSplit BRP ipta by simp
      \<comment> \<open>基本性質 (5) at \<open>m\<close>, conjunct (5-3) under the derived nonzero guard\<close>
      have nzPredNp: "\<not> zeroT (Pred (s84x_Np M))"
      proof -
        have LNp: "Lng (s84x_Np M) = Suc (Lng M - 1) - s84x_jm2 M"
          by (simp add: s84x_Np_def seg_def del: upt_Suc)
        have "2 < Lng (s84x_Np M)" using LNp rng by linarith
        hence "1 < Lng (Pred (s84x_Np M))" by (simp add: Pred_def)
        thus ?thesis by (auto simp: zeroT_def)
      qed
      obtain sbx where
        p51: "scb_decomp (Trans (s84x_L M (m - 1))) (fst sbx)
                (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbx)"
        and p53: "\<not> zeroT (Pred (s84x_Np M)) \<longrightarrow>
                    scb_decomp (Trans ((M::pairseq)[m])) (fst sbx)
                      (flatBT (Trans (Pred (s84x_Np M)))) (snd sbx)"
        using ex1_implies_ex[OF m_8_4_oper_props_5[OF MST MPT hp j1gt m2]]
        by auto
      have pinX: "fst sbx = S \<and> snd sbx = B"
        using m_7_2_scb_unique_sb[OF p51 dLm Lnne[OF m11]] by simp
      have fM: "flatBT (Trans ((M::pairseq)[m]))
              = S @ flatBT (Trans (Pred (s84x_Np M))) @ B"
        using p53 nzPredNp pinX by (simp add: scb_decomp_def)
      have fPredNp: "flatBT (Trans (Pred (s84x_Np M)))
                   = Dsym (enat ?e1jm2) # flatBT (transT2 M)"
        using d3 by simp
      have blkgrow: "concat (replicate (m - 1 - 1) ?blkS) @ s1' @ [Dsym (enat ?e1jm2)]
                   = concat (replicate (m - 1) ?blkS)"
        using s84d_concat_rep_snoc[OF m11, of ?blkS] by simp
      have "flatBT (Trans ((M::pairseq)[m]))
          = s1 @ Dsym (enat ?e1jm1)
              # (concat (replicate (m - 1 - 1) ?blkS) @ s1' @ [Dsym (enat ?e1jm2)])
              @ flatBT (transT2 M) @ concat (replicate (m - 1) b1') @ b1"
        using fM fPredNp by (simp add: S_def B_def)
      thus ?thesis using blkgrow by simp
    qed
  qed
  \<comment> \<open>assemble the unique tuple\<close>
  show ?thesis
  proof (rule ex1I[of _ "(s1', b1')"])
    show "scb_decomp (transC2 M)
            (Dsym (enat ?e1jm1) # fst (s1', b1'))
            (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (snd (s1', b1'))
        \<and> scb_decomp (Trans (s84x_Np M))
            (Dsym (enat ?e1jm2) # fst (s1', b1'))
            (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (snd (s1', b1'))
        \<and> scb_decomp (Trans (s84x_Lp M))
            (Dsym (enat ?e1jm2) # fst (s1', b1'))
            (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd (s1', b1'))
        \<and> Trans (Pred (s84x_Np M)) = Dpt (enat ?e1jm2) (transT2 M)
        \<and> flatBT (Trans (s84x_L M n))
            = s84x_s1 M @ Dsym (enat ?e1jm1)
                # concat (replicate n (fst (s1', b1') @ [Dsym (enat ?e1jm2)]))
                @ [Zsym] @ concat (replicate n (snd (s1', b1'))) @ s84x_b1 M
        \<and> flatBT (Trans ((M::pairseq)[n]))
            = s84x_s1 M @ Dsym (enat ?e1jm1)
                # concat (replicate (n - 1) (fst (s1', b1') @ [Dsym (enat ?e1jm2)]))
                @ flatBT (transT2 M)
                @ concat (replicate (n - 1) (snd (s1', b1'))) @ s84x_b1 M"
      using d1 d2 cj3 d3 F5[OF n1] F6[OF n1] s1val b1val by simp
  next
    fix y
    assume Hy: "scb_decomp (transC2 M)
                  (Dsym (enat ?e1jm1) # fst y)
                  (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (snd y)
              \<and> scb_decomp (Trans (s84x_Np M))
                  (Dsym (enat ?e1jm2) # fst y)
                  (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (snd y)
              \<and> scb_decomp (Trans (s84x_Lp M))
                  (Dsym (enat ?e1jm2) # fst y)
                  (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd y)
              \<and> Trans (Pred (s84x_Np M)) = Dpt (enat ?e1jm2) (transT2 M)
              \<and> flatBT (Trans (s84x_L M n))
                  = s84x_s1 M @ Dsym (enat ?e1jm1)
                      # concat (replicate n (fst y @ [Dsym (enat ?e1jm2)]))
                      @ [Zsym] @ concat (replicate n (snd y)) @ s84x_b1 M
              \<and> flatBT (Trans ((M::pairseq)[n]))
                  = s84x_s1 M @ Dsym (enat ?e1jm1)
                      # concat (replicate (n - 1) (fst y @ [Dsym (enat ?e1jm2)]))
                      @ flatBT (transT2 M)
                      @ concat (replicate (n - 1) (snd y)) @ s84x_b1 M"
    have "Dsym (enat ?e1jm1) # fst y = Dsym (enat ?e1jm1) # s1' \<and> snd y = b1'"
      using m_7_2_scb_unique_sb[OF _ d1 c2ne] Hy by blast
    thus "y = (s1', b1')" by (simp add: prod_eq_iff)
  qed
qed

subsection \<open>s84d: L6 補題（条件(III)か(IV)の下での各種scb分解）, modulo the
  §8.2 terminal-slice transport\<close>

text \<open>The FULL conclusion of L6 (content.md 4802, conjuncts (1)–(6); stage-1
  statement \<open>m_8_4_various_scb_IIIIV\<close>) from the two BLOCKED transport facts
  as explicit hypotheses: \<open>d4a\<close>/\<open>d4b\<close> = the article's conjunct (4) transports
  of the nest wrapper \<open>(s'\<^sub>1, b'\<^sub>1)\<close> from head \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>3\<^esub>\<close> (on \<open>Trans N\<close>) to
  head \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>2\<^esub>\<close> (on \<open>Trans N'\<close>/\<open>Trans (Pred N')\<close>) — consequences of the
  unproven \<open>p_8_2_condV_terminal_slice_Trans\<close> (pss_paper 1604), the SAME
  single residual as L5.  The hypothesis \<open>d2\<close> merely NAMES the (provable,
  @{thm [source] s84d_dec2_nest_scb}) nest wrapper so \<open>d4a\<close>/\<open>d4b\<close> can refer
  to it.  Everything else of the article's proof is discharged here:
  (1) by @{thm [source] s84d_dec1_Trans_N_scb}, (2) by
  @{thm [source] s84d_dec2_nest_scb}, (3) by the hole engine
  (@{thm [source] s84d_c2hole_scb}), the \<open>Trans L'\<close> part of (4) by
  @{thm [source] m_7_2_scb_compose} + @{thm [source] m_8_4_rightend_Trans}
  (the interior regime \<open>j\<^sub>-\<^sub>2 + 1 < j\<^sub>1\<close> is forced under (III)/(IV) by
  展開規則の基本性質 (1)), and the \<open>L\<^sub>n\<close>/\<open>M[n]\<close> formulas (5)(6) by the same
  induction as L5 gluing @{thm [source] m_8_4_oper_props_5} with the \<open>L\<^sub>1\<close>
  base case.  The round-14 hypothesis that the condIV branch is vacuous is
  REFUTED (python/_r15_s4d_condIV_L6.py): genuine condIV instances with
  \<open>j\<^sub>-\<^sub>3 < j\<^sub>-\<^sub>1\<close> exist, e.g. \<open>(0,0)(1,1)(2,2)(3,3)(3,2)(4,1)(5,2)(6,3)(6,1)\<close>.
  Empirical: all conjuncts 1053/1053 (condIII regime) + the condIV regime
  instances (python/_r15_s4d_validate.py L6_*, _r15_s4d_condIV_L6.py).\<close>

lemma m_8_4_various_scb_IIIIV_from_slice:
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and j1gt: "1 < Lng M - 1"
    and branch: "transCondIII M \<or> transCondIV M"
    and ltJ: "s84x_jm3 M < transJm1 M"
    and n1: "n \<ge> 1"
    and d2: "scb_decomp (Trans (s84x_N M))
               (Dsym (enat (entry M 1 (s84x_jm3 M))) # s1')
               (flatBT (transC2 M)) b1'"
    and d4a: "scb_decomp (Trans (Pred (s84x_Np M)))
                (Dsym (enat (entry M 1 (s84x_jm2 M))) # s1')
                (flatBT (transC1 M)) b1'"
    and d4b: "scb_decomp (Trans (s84x_Np M))
                (Dsym (enat (entry M 1 (s84x_jm2 M))) # s1')
                (flatBT (transC2 M)) b1'"
  shows "\<exists>!x. case x of (u0, u1, u2, v2, v1, v0) \<Rightarrow>
         scb_decomp (Trans M) u0 (flatBT (Trans (s84x_N M))) v0
       \<and> scb_decomp (Trans (Pred (s84x_N M)))
           (Dsym (enat (entry M 1 (s84x_jm3 M))) # u1) (flatBT (transC1 M)) v1
       \<and> scb_decomp (Trans (s84x_N M))
           (Dsym (enat (entry M 1 (s84x_jm3 M))) # u1) (flatBT (transC2 M)) v1
       \<and> scb_decomp (transC2 M) u2
           (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) v2
       \<and> scb_decomp (Trans (Pred (s84x_Np M)))
           (Dsym (enat (entry M 1 (s84x_jm2 M))) # u1) (flatBT (transC1 M)) v1
       \<and> scb_decomp (Trans (s84x_Np M))
           (Dsym (enat (entry M 1 (s84x_jm2 M))) # u1) (flatBT (transC2 M)) v1
       \<and> scb_decomp (Trans (s84x_Lp M))
           (Dsym (enat (entry M 1 (s84x_jm2 M))) # u1 @ u2)
           (flatBT (Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B)) (v2 @ v1)
       \<and> flatBT (Trans (s84x_L M n))
           = u0 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
               # concat (replicate n
                   (u1 @ u2 @ [Dsym (enat (entry M 1 (s84x_jm2 M)))]))
               @ [Zsym] @ concat (replicate n (v2 @ v1)) @ v0
       \<and> flatBT (Trans ((M::pairseq)[n]))
           = u0 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
               # concat (replicate (n - 1)
                   (u1 @ u2 @ [Dsym (enat (entry M 1 (s84x_jm2 M)))]))
               @ u1 @ flatBT (transC1 M) @ v1
               @ concat (replicate (n - 1) (v2 @ v1)) @ v0"
proof -
  let ?e1jm3 = "entry M 1 (s84x_jm3 M)"
  let ?e1jm2 = "entry M 1 (s84x_jm2 M)"
  let ?e1jm1 = "entry M 1 (transJm1 M)"
  let ?e1j1 = "entry M 1 (Lng M - 1)"
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MPT by (simp add: PT_PS_def)
  have j1gt0: "0 < Lng M - 1" using j1gt by simp
  have J1pos: "transJ1 M > 0" using j1gt by (simp add: transJ1_def)
  have nVI: "\<not> transCondVI M"
  proof
    assume VI: "transCondVI M"
    have "entry M 1 (parent M 0 (Lng M - 1)) + 1 = entry M 1 (Lng M - 1)"
      using VI by (simp add: transCondVI_def)
    moreover have "entry M 1 (parent M 0 (Lng M - 1)) \<ge> entry M 1 (Lng M - 1)"
      using branch by (auto simp: transCondIII_def transCondIV_def)
    ultimately show False by simp
  qed
  have T1: "transT1 M \<noteq> 0\<^sub>B" using s84d_L4_regime(2)[OF MST MPT hp nVI] .
  have T1ne: "Trans (Pred M) \<noteq> Trm []" using T1 by (simp add: transT1_def)
  have jm2ltj0: "s84x_jm2 M < transJ0 M"
    by (rule m_8_4_oper_props_1(1)[OF MST MPT hp j1gt branch])
  have j0lt: "transJ0 M < Lng M - 1"
    by (rule s84c1_nextR0_j0(2)[OF MPT j1gt0])
  have rng: "s84x_jm2 M + 1 < Lng M - 1" using jm2ltj0 j0lt by linarith
  have reg: "s84x_jm2 M < transJ0 M \<or> adm M (transJ0 M)" using jm2ltj0 by simp
  \<comment> \<open>the shared surgery wrappers \<open>(s\<^sub>1, b\<^sub>1)\<close> of \<open>M\<close>\<close>
  obtain s1 b1 where
    dc1: "scb_decomp (Trans (Pred M)) s1 (flatBT (transC1 M)) b1"
    and dc2M: "scb_decomp (Trans M) s1 (flatBT (transC2 M)) b1"
    by (rule s84c2_Trans_c2_decomp[OF MR MPT J1pos T1])
  \<comment> \<open>conjunct (1) witness \<open>(u\<^sub>0, v\<^sub>0) = (s0, b0)\<close>\<close>
  obtain sb0 where
    dTN0: "scb_decomp (Trans M) (fst sb0) (flatBT (Trans (s84x_N M))) (snd sb0)"
    using ex1_implies_ex[OF s84d_dec1_Trans_N_scb[OF MR MPT j1gt hp]] by auto
  define s0 where "s0 = fst sb0"
  define b0 where "b0 = snd sb0"
  have dTN: "scb_decomp (Trans M) s0 (flatBT (Trans (s84x_N M))) b0"
    using dTN0 s0_def b0_def by simp
  \<comment> \<open>nontriviality of the middles\<close>
  have TMne: "Trans M \<noteq> Trm []"
  proof -
    have "\<not> zeroT M" using j1gt by (auto simp: zeroT_def)
    thus ?thesis using m_7_3_Trans_zeroT[OF MR] by simp
  qed
  have TNne: "Trans (s84x_N M) \<noteq> Trm []"
  proof
    assume z: "Trans (s84x_N M) = Trm []"
    have "flatBT (Trans (s84x_N M))
        = (Dsym (enat ?e1jm3) # s1') @ flatBT (transC2 M) @ b1'"
      using d2 by (simp add: scb_decomp_def)
    hence "[Zsym] = Dsym (enat ?e1jm3) # s1' @ flatBT (transC2 M) @ b1'"
      using z by simp
    thus False by simp
  qed
  have TNpne: "Trans (s84x_Np M) \<noteq> Trm []"
  proof
    assume z: "Trans (s84x_Np M) = Trm []"
    have "flatBT (Trans (s84x_Np M))
        = (Dsym (enat ?e1jm2) # s1') @ flatBT (transC2 M) @ b1'"
      using d4b by (simp add: scb_decomp_def)
    hence "[Zsym] = Dsym (enat ?e1jm2) # s1' @ flatBT (transC2 M) @ b1'"
      using z by simp
    thus False by simp
  qed
  \<comment> \<open>conjunct (2): the nest wrapper, pinned against \<open>(s1', b1')\<close>\<close>
  obtain sbn where
    nA: "scb_decomp (Trans (s84x_N M)) (Dsym (enat ?e1jm3) # fst sbn)
           (flatBT (transC2 M)) (snd sbn)"
    and nB: "scb_decomp (Trans (Pred (s84x_N M))) (Dsym (enat ?e1jm3) # fst sbn)
               (flatBT (transC1 M)) (snd sbn)"
    using ex1_implies_ex[OF s84d_dec2_nest_scb[OF MR MPT j1gt hp ltJ]] by auto
  have pinN: "Dsym (enat ?e1jm3) # fst sbn = Dsym (enat ?e1jm3) # s1'
            \<and> snd sbn = b1'"
    by (rule m_7_2_scb_unique_sb[OF nA d2 TNne])
  have d2P: "scb_decomp (Trans (Pred (s84x_N M))) (Dsym (enat ?e1jm3) # s1')
               (flatBT (transC1 M)) b1'"
    using nB pinN by simp
  \<comment> \<open>conjunct (3) witness \<open>(u\<^sub>2, v\<^sub>2) = (s2, w')\<close> from the hole engine\<close>
  have vval: "transV M = enat ?e1jm1"
    by (rule m_8_5_scbdec_c1_shape(1)[OF MR MPT J1pos T1])
  obtain w w' where
    W: "\<forall>a. scb_decomp (s84d_c2hole M a) (Dsym (transV M) # w)
              (flatBT (Dpt (enat a) 0\<^sub>B)) w'"
    using s84d_c2hole_scb[OF MR MPT J1pos T1] by blast
  define s2 where "s2 = Dsym (enat ?e1jm1) # w"
  have Wj1: "scb_decomp (transC2 M) s2 (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) w'"
    unfolding s2_def
    using W[rule_format, of ?e1j1]
    unfolding s84d_c2hole_at_j1[symmetric] vval .
  have Wjm2: "scb_decomp (s84d_c2hole M ?e1jm2) s2
                (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) w'"
    unfolding s2_def using W[rule_format, of ?e1jm2] vval by simp
  \<comment> \<open>single-principal shapes of the middles\<close>
  define body where "body = bpHeadT (transC2 M)"
  have c2b: "transC2 M = Dpt (transV M) body"
    using transC2_single_principal_head(2)[OF MR MPT J1pos T1] body_def by simp
  have c2ne: "transC2 M \<noteq> Trm []" by (subst c2b) simp
  have c2prin: "\<exists>p. transC2 M = Trm [p]" using c2b by blast
  have mM3: "(M, s84x_jm3 M) \<in> Marked" and jm3le2: "s84x_jm3 M \<le> s84x_jm2 M"
    and jm2lt: "s84x_jm2 M < Lng M - 1"
    using s84d_jm3_Marked[OF MR MT hp] by simp_all
  have jm3lt: "s84x_jm3 M < Lng M - 1" using jm3le2 jm2lt by linarith
  have reprM: "Mark M (s84x_jm3 M) = Trans (s84x_N M)"
    using m_7_4_Mark_Trans_repr[OF mM3 MR jm3lt] by (simp add: s84x_N_def)
  have TNprin: "\<exists>p. Trans (s84x_N M) = Trm [p]"
  proof -
    have lef: "Mark M (s84x_jm3 M) = 0\<^sub>B
             \<or> (\<exists>t. Mark M (s84x_jm3 M) = Dpt (enat ?e1jm3) t)"
      using Mark_leftend_form mM3 MR by blast
    have Mne: "Mark M (s84x_jm3 M) \<noteq> 0\<^sub>B" using reprM TNne by simp
    obtain t where "Trans (s84x_N M) = Dpt (enat ?e1jm3) t"
      using lef Mne reprM by auto
    thus ?thesis by blast
  qed
  \<comment> \<open>the wrapper split \<open>s\<^sub>1 = s\<^sub>0 D\<^bsub>j\<^sub>-\<^sub>3\<^esub> s'\<^sub>1\<close>, \<open>b\<^sub>1 = b'\<^sub>1 b\<^sub>0\<close>\<close>
  have comp1: "scb_decomp (Trans M) (s0 @ Dsym (enat ?e1jm3) # s1')
                 (flatBT (transC2 M)) (b1' @ b0)"
    using m_7_2_scb_compose[OF TNprin dTN d2] by simp
  have pinS1: "s1 = s0 @ Dsym (enat ?e1jm3) # s1' \<and> b1 = b1' @ b0"
    by (rule m_7_2_scb_unique_sb[OF dc2M comp1 TMne])
  \<comment> \<open>conjunct (4) third part: \<open>Trans L'\<close> via compose + rightend replacement\<close>
  have comp4: "scb_decomp (Trans (s84x_Np M))
                 ((Dsym (enat ?e1jm2) # s1') @ s2)
                 (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (w' @ b1')"
    using m_7_2_scb_compose[OF c2prin d4b Wj1] by simp
  have cj7: "scb_decomp (Trans (s84x_Lp M)) (Dsym (enat ?e1jm2) # s1' @ s2)
               (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (w' @ b1')"
  proof -
    obtain sbr where
      re1: "scb_decomp (Trans (s84x_Np M)) (fst sbr)
              (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) (snd sbr)"
      and re2: "scb_decomp (Trans (s84x_Lp M)) (fst sbr)
                  (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbr)"
      using ex1_implies_ex[OF m_8_4_rightend_Trans[OF MST MPT hp rng]] by auto
    have "fst sbr = (Dsym (enat ?e1jm2) # s1') @ s2 \<and> snd sbr = w' @ b1'"
      by (rule m_7_2_scb_unique_sb[OF re1 comp4 TNpne])
    thus ?thesis using re2 by simp
  qed
  \<comment> \<open>the \<open>L\<^sub>1\<close> base case\<close>
  note data = s84d_L1_data[OF MST MPT hp nVI]
  have L1T1ne: "transT1 (s84x_L M 1) \<noteq> 0\<^sub>B" using data(10) T1 by simp
  obtain s1L b1L where
    dc1L: "scb_decomp (Trans (Pred (s84x_L M 1))) s1L
             (flatBT (transC1 (s84x_L M 1))) b1L"
    and dc2L: "scb_decomp (Trans (s84x_L M 1)) s1L
                 (flatBT (transC2 (s84x_L M 1))) b1L"
    by (rule s84c2_Trans_c2_decomp[OF data(1) data(2) data(11) L1T1ne])
  have dc1L': "scb_decomp (Trans (Pred M)) s1L (flatBT (transC1 M)) b1L"
    using dc1L data(3) data(7) by simp
  have sbL: "s1L = s1 \<and> b1L = b1"
    using m_7_2_scb_unique_sb[OF dc1L' dc1 T1ne] by simp
  have holeL1: "transC2 (s84x_L M 1) = s84d_c2hole M ?e1jm2"
    by (rule s84d_c2hole_L1[OF MST MPT hp nVI reg])
  let ?blk = "s1' @ s2 @ [Dsym (enat ?e1jm2)]"
  have base5: "flatBT (Trans (s84x_L M 1))
             = s0 @ Dsym (enat ?e1jm3)
                 # concat (replicate 1 ?blk) @ [Zsym]
                 @ concat (replicate 1 (w' @ b1')) @ b0"
  proof -
    have f1: "flatBT (Trans (s84x_L M 1))
            = s1 @ flatBT (transC2 (s84x_L M 1)) @ b1"
      using dc2L sbL by (simp add: scb_decomp_def)
    have f2: "flatBT (s84d_c2hole M ?e1jm2)
            = s2 @ flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) @ w'"
      using Wjm2 by (simp add: scb_decomp_def)
    show ?thesis using f1 f2 holeL1 pinS1 by simp
  qed
  \<comment> \<open>auxiliary data for the induction\<close>
  have b0RP: "\<forall>x \<in> set b0. x = RP" using dTN by (simp add: scb_decomp_def)
  have b1pRP: "\<forall>x \<in> set b1'. x = RP" using d2 by (simp add: scb_decomp_def)
  have w'RP: "\<forall>x \<in> set w'. x = RP" using Wj1 by (simp add: scb_decomp_def)
  have vRP: "\<forall>x \<in> set (w' @ b1'). x = RP" using b1pRP w'RP by auto
  have ipta: "\<And>a::nat. isPTB_str (flatBT (Dpt (enat a) 0\<^sub>B))"
    by (rule isPTB_str_Dpt) simp_all
  have Lnne: "\<And>m. 1 \<le> m \<Longrightarrow> Trans (s84x_L M m) \<noteq> Trm []"
  proof -
    fix m :: nat assume m1: "1 \<le> m"
    have w1: "1 \<le> Lng M - 1 - s84x_jm2 M" using rng by linarith
    have "1 * 1 \<le> m * (Lng M - 1 - s84x_jm2 M)" by (rule mult_le_mono[OF m1 w1])
    hence "0 < Lng ((M::pairseq)[m])"
      using s84c1_Lng_oper[OF hp j1gt0, of m] by linarith
    hence "1 < Lng (s84x_L M m)" using s84c1_Lng_L[of M m] by simp
    hence "\<not> zeroT (s84x_L M m)" by (auto simp: zeroT_def)
    thus "Trans (s84x_L M m) \<noteq> Trm []"
      using m_7_3_Trans_zeroT[OF m_8_4_oper_props_2(1)[OF MST MPT hp j1gt m1]]
      by simp
  qed
  \<comment> \<open>formula (5): induction on \<open>m\<close>\<close>
  have F5: "\<And>m. 1 \<le> m \<Longrightarrow>
              flatBT (Trans (s84x_L M m))
            = s0 @ Dsym (enat ?e1jm3)
                # concat (replicate m ?blk) @ [Zsym]
                @ concat (replicate m (w' @ b1')) @ b0"
  proof -
    fix m :: nat assume "1 \<le> m"
    thus "flatBT (Trans (s84x_L M m))
        = s0 @ Dsym (enat ?e1jm3)
            # concat (replicate m ?blk) @ [Zsym]
            @ concat (replicate m (w' @ b1')) @ b0"
    proof (induction m)
      case 0 thus ?case by simp
    next
      case (Suc m)
      show ?case
      proof (cases "m = 0")
        case True
        thus ?thesis using base5 by simp
      next
        case False
        hence m1: "1 \<le> m" by simp
        have IH: "flatBT (Trans (s84x_L M m))
                = s0 @ Dsym (enat ?e1jm3)
                    # concat (replicate m ?blk) @ [Zsym]
                    @ concat (replicate m (w' @ b1')) @ b0"
          using Suc.IH m1 by simp
        \<comment> \<open>re-read the IH string as an scb-decomposition around \<open>D\<^bsub>j\<^sub>-\<^sub>2\<^esub> 0\<close>\<close>
        define S where
          "S = s0 @ Dsym (enat ?e1jm3)
                 # concat (replicate (m - 1) ?blk) @ s1' @ s2"
        define B where "B = concat (replicate m (w' @ b1')) @ b0"
        have splitS: "Dsym (enat ?e1jm3) # concat (replicate m ?blk) @ [Zsym]
                    = (Dsym (enat ?e1jm3)
                        # concat (replicate (m - 1) ?blk) @ s1' @ s2)
                      @ [Dsym (enat ?e1jm2), Zsym]"
        proof -
          have "concat (replicate m ?blk)
              = concat (replicate (m - 1) ?blk) @ ?blk"
            by (rule s84d_concat_rep_snoc[OF m1])
          thus ?thesis by simp
        qed
        have flatD: "flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) = [Dsym (enat ?e1jm2), Zsym]"
          by simp
        have flatSplit: "flatBT (Trans (s84x_L M m))
                       = S @ flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) @ B"
          using IH splitS by (simp add: S_def B_def flatD)
        have BRP: "\<forall>x \<in> set B. x = RP"
        proof
          fix x assume "x \<in> set B"
          hence "x \<in> set (concat (replicate m (w' @ b1'))) \<or> x \<in> set b0"
            by (auto simp: B_def)
          thus "x = RP"
            using s84d_set_concat_rep[of m "w' @ b1'"] vRP b0RP by auto
        qed
        have dLm: "scb_decomp (Trans (s84x_L M m)) S
                     (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) B"
          unfolding scb_decomp_def using flatSplit BRP ipta by simp
        \<comment> \<open>glue with 基本性質 (5) at \<open>Suc m\<close>\<close>
        have Sm2: "1 < Suc m" using m1 by simp
        obtain sbx where
          p51: "scb_decomp (Trans (s84x_L M (Suc m - 1))) (fst sbx)
                  (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbx)"
          and p52: "scb_decomp (Trans (s84x_L M (Suc m))) (fst sbx)
                      (flatBT (Trans (s84x_Lp M))) (snd sbx)"
          using ex1_implies_ex[OF m_8_4_oper_props_5[OF MST MPT hp j1gt Sm2]]
          by auto
        have p51': "scb_decomp (Trans (s84x_L M m)) (fst sbx)
                      (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbx)"
          using p51 by simp
        have pinX: "fst sbx = S \<and> snd sbx = B"
          using m_7_2_scb_unique_sb[OF p51' dLm Lnne[OF m1]] by simp
        have fSuc: "flatBT (Trans (s84x_L M (Suc m)))
                  = S @ flatBT (Trans (s84x_Lp M)) @ B"
          using p52 pinX by (simp add: scb_decomp_def)
        have fLp: "flatBT (Trans (s84x_Lp M))
                 = Dsym (enat ?e1jm2)
                     # (s1' @ s2) @ [Dsym (enat ?e1jm2), Zsym] @ (w' @ b1')"
          using cj7 by (simp add: scb_decomp_def)
        \<comment> \<open>reassemble to the \<open>Suc m\<close> formula\<close>
        have blkgrow: "concat (replicate (m - 1) ?blk)
                         @ s1' @ s2 @ [Dsym (enat ?e1jm2)]
                     = concat (replicate m ?blk)"
          using s84d_concat_rep_snoc[OF m1, of ?blk] by simp
        have bgrow: "(w' @ b1') @ concat (replicate m (w' @ b1'))
                   = concat (replicate (Suc m) (w' @ b1'))"
          by simp
        have "flatBT (Trans (s84x_L M (Suc m)))
            = s0 @ Dsym (enat ?e1jm3)
                # concat (replicate (m - 1) ?blk) @ s1' @ s2
                @ (Dsym (enat ?e1jm2)
                    # (s1' @ s2) @ [Dsym (enat ?e1jm2), Zsym] @ (w' @ b1'))
                @ concat (replicate m (w' @ b1')) @ b0"
          using fSuc fLp by (simp add: S_def B_def)
        also have "\<dots> = s0 @ Dsym (enat ?e1jm3)
                # (concat (replicate (m - 1) ?blk)
                    @ s1' @ s2 @ [Dsym (enat ?e1jm2)])
                @ (s1' @ s2 @ [Dsym (enat ?e1jm2)]) @ [Zsym]
                @ ((w' @ b1') @ concat (replicate m (w' @ b1'))) @ b0"
          by simp
        also have "\<dots> = s0 @ Dsym (enat ?e1jm3)
                # concat (replicate m ?blk) @ ?blk @ [Zsym]
                @ concat (replicate (Suc m) (w' @ b1')) @ b0"
          using blkgrow bgrow by simp
        also have "\<dots> = s0 @ Dsym (enat ?e1jm3)
                # concat (replicate (Suc m) ?blk) @ [Zsym]
                @ concat (replicate (Suc m) (w' @ b1')) @ b0"
          using s84d_concat_rep_snoc[of "Suc m" ?blk] by simp
        finally show ?thesis .
      qed
    qed
  qed
  \<comment> \<open>formula (6)\<close>
  have F6: "\<And>m. 1 \<le> m \<Longrightarrow>
              flatBT (Trans ((M::pairseq)[m]))
            = s0 @ Dsym (enat ?e1jm3)
                # concat (replicate (m - 1) ?blk)
                @ s1' @ flatBT (transC1 M) @ b1'
                @ concat (replicate (m - 1) (w' @ b1')) @ b0"
  proof -
    fix m :: nat assume m1: "1 \<le> m"
    show "flatBT (Trans ((M::pairseq)[m]))
        = s0 @ Dsym (enat ?e1jm3)
            # concat (replicate (m - 1) ?blk)
            @ s1' @ flatBT (transC1 M) @ b1'
            @ concat (replicate (m - 1) (w' @ b1')) @ b0"
    proof (cases "m = 1")
      case True
      have "flatBT (Trans ((M::pairseq)[1])) = flatBT (Trans (Pred M))"
        using m_8_4_oper1_eq_Pred[OF MT] by simp
      also have "\<dots> = s1 @ flatBT (transC1 M) @ b1"
        using dc1 by (simp add: scb_decomp_def)
      also have "\<dots> = s0 @ Dsym (enat ?e1jm3)
                        # s1' @ flatBT (transC1 M) @ b1' @ b0"
        using pinS1 by simp
      finally show ?thesis using True by simp
    next
      case False
      hence m2: "1 < m" using m1 by simp
      have m11: "1 \<le> m - 1" using m2 by simp
      have IH5: "flatBT (Trans (s84x_L M (m - 1)))
               = s0 @ Dsym (enat ?e1jm3)
                   # concat (replicate (m - 1) ?blk) @ [Zsym]
                   @ concat (replicate (m - 1) (w' @ b1')) @ b0"
        by (rule F5[OF m11])
      define S where
        "S = s0 @ Dsym (enat ?e1jm3)
               # concat (replicate (m - 1 - 1) ?blk) @ s1' @ s2"
      define B where "B = concat (replicate (m - 1) (w' @ b1')) @ b0"
      have splitS: "Dsym (enat ?e1jm3)
                      # concat (replicate (m - 1) ?blk) @ [Zsym]
                  = (Dsym (enat ?e1jm3)
                      # concat (replicate (m - 1 - 1) ?blk) @ s1' @ s2)
                    @ [Dsym (enat ?e1jm2), Zsym]"
      proof -
        have "concat (replicate (m - 1) ?blk)
            = concat (replicate (m - 1 - 1) ?blk) @ ?blk"
          by (rule s84d_concat_rep_snoc[OF m11])
        thus ?thesis by simp
      qed
      have flatSplit: "flatBT (Trans (s84x_L M (m - 1)))
                     = S @ flatBT (Dpt (enat ?e1jm2) 0\<^sub>B) @ B"
        using IH5 splitS by (simp add: S_def B_def)
      have BRP: "\<forall>x \<in> set B. x = RP"
      proof
        fix x assume "x \<in> set B"
        hence "x \<in> set (concat (replicate (m - 1) (w' @ b1'))) \<or> x \<in> set b0"
          by (auto simp: B_def)
        thus "x = RP"
          using s84d_set_concat_rep[of "m - 1" "w' @ b1'"] vRP b0RP by auto
      qed
      have dLm: "scb_decomp (Trans (s84x_L M (m - 1))) S
                   (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) B"
        unfolding scb_decomp_def using flatSplit BRP ipta by simp
      \<comment> \<open>基本性質 (5) at \<open>m\<close>, conjunct (5-3) under the derived nonzero guard\<close>
      have nzPredNp: "\<not> zeroT (Pred (s84x_Np M))"
      proof -
        have LNp: "Lng (s84x_Np M) = Suc (Lng M - 1) - s84x_jm2 M"
          by (simp add: s84x_Np_def seg_def del: upt_Suc)
        have "2 < Lng (s84x_Np M)" using LNp rng by linarith
        hence "1 < Lng (Pred (s84x_Np M))" by (simp add: Pred_def)
        thus ?thesis by (auto simp: zeroT_def)
      qed
      obtain sbx where
        p51: "scb_decomp (Trans (s84x_L M (m - 1))) (fst sbx)
                (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sbx)"
        and p53: "\<not> zeroT (Pred (s84x_Np M)) \<longrightarrow>
                    scb_decomp (Trans ((M::pairseq)[m])) (fst sbx)
                      (flatBT (Trans (Pred (s84x_Np M)))) (snd sbx)"
        using ex1_implies_ex[OF m_8_4_oper_props_5[OF MST MPT hp j1gt m2]]
        by auto
      have pinX: "fst sbx = S \<and> snd sbx = B"
        using m_7_2_scb_unique_sb[OF p51 dLm Lnne[OF m11]] by simp
      have fM: "flatBT (Trans ((M::pairseq)[m]))
              = S @ flatBT (Trans (Pred (s84x_Np M))) @ B"
        using p53 nzPredNp pinX by (simp add: scb_decomp_def)
      have fPredNp: "flatBT (Trans (Pred (s84x_Np M)))
                   = Dsym (enat ?e1jm2) # s1' @ flatBT (transC1 M) @ b1'"
        using d4a by (simp add: scb_decomp_def)
      have blkgrow: "concat (replicate (m - 1 - 1) ?blk)
                       @ s1' @ s2 @ [Dsym (enat ?e1jm2)]
                   = concat (replicate (m - 1) ?blk)"
        using s84d_concat_rep_snoc[OF m11, of ?blk] by simp
      have "flatBT (Trans ((M::pairseq)[m]))
          = s0 @ Dsym (enat ?e1jm3)
              # (concat (replicate (m - 1 - 1) ?blk)
                  @ s1' @ s2 @ [Dsym (enat ?e1jm2)])
              @ s1' @ flatBT (transC1 M) @ b1'
              @ concat (replicate (m - 1) (w' @ b1')) @ b0"
        using fM fPredNp by (simp add: S_def B_def)
      thus ?thesis using blkgrow by simp
    qed
  qed
  \<comment> \<open>assemble the unique tuple\<close>
  have big:
    "scb_decomp (Trans M) s0 (flatBT (Trans (s84x_N M))) b0
   \<and> scb_decomp (Trans (Pred (s84x_N M)))
       (Dsym (enat ?e1jm3) # s1') (flatBT (transC1 M)) b1'
   \<and> scb_decomp (Trans (s84x_N M))
       (Dsym (enat ?e1jm3) # s1') (flatBT (transC2 M)) b1'
   \<and> scb_decomp (transC2 M) s2 (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) w'
   \<and> scb_decomp (Trans (Pred (s84x_Np M)))
       (Dsym (enat ?e1jm2) # s1') (flatBT (transC1 M)) b1'
   \<and> scb_decomp (Trans (s84x_Np M))
       (Dsym (enat ?e1jm2) # s1') (flatBT (transC2 M)) b1'
   \<and> scb_decomp (Trans (s84x_Lp M))
       (Dsym (enat ?e1jm2) # s1' @ s2)
       (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (w' @ b1')
   \<and> flatBT (Trans (s84x_L M n))
       = s0 @ Dsym (enat ?e1jm3)
           # concat (replicate n (s1' @ s2 @ [Dsym (enat ?e1jm2)]))
           @ [Zsym] @ concat (replicate n (w' @ b1')) @ b0
   \<and> flatBT (Trans ((M::pairseq)[n]))
       = s0 @ Dsym (enat ?e1jm3)
           # concat (replicate (n - 1) (s1' @ s2 @ [Dsym (enat ?e1jm2)]))
           @ s1' @ flatBT (transC1 M) @ b1'
           @ concat (replicate (n - 1) (w' @ b1')) @ b0"
    using dTN d2P d2 Wj1 d4a d4b cj7 F5[OF n1] F6[OF n1] by blast
  show ?thesis
  proof (rule ex1I[of _ "(s0, s1', s2, w', b1', b0)"])
    show "case (s0, s1', s2, w', b1', b0) of (u0, u1, u2, v2, v1, v0) \<Rightarrow>
         scb_decomp (Trans M) u0 (flatBT (Trans (s84x_N M))) v0
       \<and> scb_decomp (Trans (Pred (s84x_N M)))
           (Dsym (enat ?e1jm3) # u1) (flatBT (transC1 M)) v1
       \<and> scb_decomp (Trans (s84x_N M))
           (Dsym (enat ?e1jm3) # u1) (flatBT (transC2 M)) v1
       \<and> scb_decomp (transC2 M) u2 (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) v2
       \<and> scb_decomp (Trans (Pred (s84x_Np M)))
           (Dsym (enat ?e1jm2) # u1) (flatBT (transC1 M)) v1
       \<and> scb_decomp (Trans (s84x_Np M))
           (Dsym (enat ?e1jm2) # u1) (flatBT (transC2 M)) v1
       \<and> scb_decomp (Trans (s84x_Lp M))
           (Dsym (enat ?e1jm2) # u1 @ u2)
           (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (v2 @ v1)
       \<and> flatBT (Trans (s84x_L M n))
           = u0 @ Dsym (enat ?e1jm3)
               # concat (replicate n (u1 @ u2 @ [Dsym (enat ?e1jm2)]))
               @ [Zsym] @ concat (replicate n (v2 @ v1)) @ v0
       \<and> flatBT (Trans ((M::pairseq)[n]))
           = u0 @ Dsym (enat ?e1jm3)
               # concat (replicate (n - 1) (u1 @ u2 @ [Dsym (enat ?e1jm2)]))
               @ u1 @ flatBT (transC1 M) @ v1
               @ concat (replicate (n - 1) (v2 @ v1)) @ v0"
      using big by simp
  next
    fix y
    assume Hy: "case y of (u0, u1, u2, v2, v1, v0) \<Rightarrow>
         scb_decomp (Trans M) u0 (flatBT (Trans (s84x_N M))) v0
       \<and> scb_decomp (Trans (Pred (s84x_N M)))
           (Dsym (enat ?e1jm3) # u1) (flatBT (transC1 M)) v1
       \<and> scb_decomp (Trans (s84x_N M))
           (Dsym (enat ?e1jm3) # u1) (flatBT (transC2 M)) v1
       \<and> scb_decomp (transC2 M) u2 (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) v2
       \<and> scb_decomp (Trans (Pred (s84x_Np M)))
           (Dsym (enat ?e1jm2) # u1) (flatBT (transC1 M)) v1
       \<and> scb_decomp (Trans (s84x_Np M))
           (Dsym (enat ?e1jm2) # u1) (flatBT (transC2 M)) v1
       \<and> scb_decomp (Trans (s84x_Lp M))
           (Dsym (enat ?e1jm2) # u1 @ u2)
           (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (v2 @ v1)
       \<and> flatBT (Trans (s84x_L M n))
           = u0 @ Dsym (enat ?e1jm3)
               # concat (replicate n (u1 @ u2 @ [Dsym (enat ?e1jm2)]))
               @ [Zsym] @ concat (replicate n (v2 @ v1)) @ v0
       \<and> flatBT (Trans ((M::pairseq)[n]))
           = u0 @ Dsym (enat ?e1jm3)
               # concat (replicate (n - 1) (u1 @ u2 @ [Dsym (enat ?e1jm2)]))
               @ u1 @ flatBT (transC1 M) @ v1
               @ concat (replicate (n - 1) (v2 @ v1)) @ v0"
    obtain a1 a2 a3 a4 a5 a6 where yv: "y = (a1, a2, a3, a4, a5, a6)"
      using prod_cases6 by blast
    have hc1: "scb_decomp (Trans M) a1 (flatBT (Trans (s84x_N M))) a6"
      and hc3: "scb_decomp (Trans (s84x_N M))
                  (Dsym (enat ?e1jm3) # a2) (flatBT (transC2 M)) a5"
      and hc4: "scb_decomp (transC2 M) a3 (flatBT (Dpt (enat ?e1j1) 0\<^sub>B)) a4"
      using Hy yv by auto
    have p1: "a1 = s0 \<and> a6 = b0"
      by (rule m_7_2_scb_unique_sb[OF hc1 dTN TMne])
    have p2: "Dsym (enat ?e1jm3) # a2 = Dsym (enat ?e1jm3) # s1' \<and> a5 = b1'"
      by (rule m_7_2_scb_unique_sb[OF hc3 d2 TNne])
    have p3: "a3 = s2 \<and> a4 = w'"
      by (rule m_7_2_scb_unique_sb[OF hc4 Wj1 c2ne])
    show "y = (s0, s1', s2, w', b1', b0)"
      using yv p1 p2 p3 by simp
  qed
qed




(* ===== round 16 front E1: condV non-adm REACHABILITY refutation, adm-side
        HB discharge, exchange triple unconditional, dispatcher wiring ===== *)
section \<open>r16-E1: 条件(V) — 非許容 \<open>j\<^sub>0\<close> の到達可能性（反証）と許容側残差の完全解消\<close>

text \<open>REFUTATION (r16-E1, python/_r16_e1_admcheck.py, _r16_e1_chains.py,
  _r16_e1_nonadm_exch.py).  The rounds-14/15 working hypothesis "non-adm condV
  is unreachable in genuine \<open>ST\<^bsub>PS\<^esub>\<close>" (0/20049 shallow instances) is FALSE:
  genuine members of \<open>ST\<^bsub>PS\<^esub> \<inter> PT\<^bsub>PS\<^esub>\<close> satisfying \<open>transCondV M\<close> with
  \<open>\<not> adm M j\<^sub>0\<close> exist, all at \<open>Lng \<ge> 9\<close> — exactly the verify-rank-depth blind
  spot (same failure mode as the refuted round-14 condIV-vacuity).  Smallest
  found (explicit \<open>oper\<close> chain from \<open>diagSeq 0 3\<close>, replayed step-by-step, all
  intermediates reduced, yaBMS-oracle-confirmed standard):
    \<open>M = (0,0)(1,1)(2,2)(3,1)(4,0)(5,1)(6,2)(7,0)(6,2)\<close>
      \<open>= diagSeq 0 3 [2][2][2][2][2][1][2][2][2][1]\<close>,
    \<open>j\<^sub>0 = 5\<close>, \<open>M\<^bsub>1,j\<^sub>0\<^esub> = 1\<close>, \<open>M\<^bsub>1,j\<^sub>1\<^esub> = 2\<close>, \<open>nadm\<close> edges \<open>(1,4)\<rightarrow>(1,5)\<rightarrow>(1,6)\<close>.
  81 further distinct genuine non-adm instances over two seeds.  EMPIRICAL MAP
  of the non-adm branch (41 + 40 instances, two seeds, n \<in> {1,2,3}):
  \<^item> descent \<open>Trans(M[n]) < Trans M\<close>: 100%;
  \<^item> the printed 命題（条件(V)の下での交換関係） (1) index \<open>m\<^sub>n = n\<close> is FALSE for
    \<open>n \<ge> 2\<close> (0/79) — the A28 index shift propagates to the non-adm branch:
    min \<open>k\<close> with \<open>Trans(M[n]) \<le> Trans(M)[k]\<close> is EXACTLY \<open>n + 1 = m\<^sub>n + 1\<close>
    for \<open>n \<ge> 2\<close> (and \<open>1\<close> at \<open>n = 1\<close>, the \<open>Pred\<close> leaf);
  \<^item> the printed conclusion (3) \<open>Trans(M)[n] \<le> Trans(M[n+1])\<close>: 100% as printed;
  \<^item> part (3) of 補題（条件(V)の下での\<open>Joints\<close>と\<open>FirstNodes\<close>と\<open>t\<^sub>2\<close>の基本性質）
    (each component of \<open>t\<^sub>2\<close> is \<open>\<ge> D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0\<close>): 100% — consistent with the
    article (stated there for the non-adm case);
  \<^item> \<open>nextR M 1 j\<^sub>0 j\<^sub>1\<close>: 100% (and proven below without any adm hypothesis).
  CONSEQUENCES: (a) the s5b adm-case block keeps its hypothesis \<open>adm M j\<^sub>0\<close> —
  it is NOT dischargeable; (b) the dispatcher's \<open>exchV\<close> genuinely needs a
  non-adm leg (kept as a — now provably non-vacuous — hypothesis, weakened
  below); (c) the adm-regime residuals HB/t2lb were RE-VALIDATED DEEP
  (60/60 at \<open>Lng \<ge> 9\<close>) and are proven unconditionally below.\<close>

subsection \<open>The row-1 parent edge under condition (V) (no adm hypothesis)\<close>

text \<open>\<open>s85b_condV_bridge\<close> exports \<open>hasParent\<close> and the parent VALUE; the edge
  itself, needed as the \<open>nextR\<close> hypothesis of the Joints/FirstNodes lemma, is
  its \<open>THE\<close>-unfolding.\<close>

lemma e1x_condV_nextR1:
  fixes M :: pairseq
  assumes MP: "M \<in> PT_PS" and cond: "transCondV M"
  shows "nextR M 1 (transJ0 M) (Lng M - 1)"
proof -
  have hp1: "hasParent M 1 (Lng M - 1)" by (rule s85b_condV_bridge(3)[OF MP cond])
  have EXU: "\<exists>!p. nextR M 1 p (Lng M - 1)" using hp1 by (simp add: hasParent_def)
  have "nextR M 1 (parent M 1 (Lng M - 1)) (Lng M - 1)"
    using theI'[OF EXU] by (simp add: parent_def)
  moreover have "parent M 1 (Lng M - 1) = transJ0 M"
    using s85b_condV_bridge(4)[OF MP cond] by (simp add: s84x_jm2_def)
  ultimately show ?thesis by simp
qed

subsection \<open>Joints/FirstNodes basic lemma with hypotheses reduced to condition (V)\<close>

text \<open>The proven parts (1)–(2) of 補題（条件(V)の下での\<open>Joints\<close>と\<open>FirstNodes\<close>と
  \<open>t\<^sub>2\<close>の基本性質） (@{thm [source] m_8_5_Joints_FirstNodes_basic}) restated on
  the now-live regime \<open>transCondV M \<and> \<not> adm M j\<^sub>0\<close>: the \<open>nextR\<close> and gap
  hypotheses are DERIVED (@{thm [source] e1x_condV_nextR1},
  @{thm [source] s85b_condV_bridge}).\<close>

lemma m_8_5_Joints_FirstNodes_basic_condV:
  fixes M :: pairseq
  defines "j1 \<equiv> Lng M - 1"
    and "j0 \<equiv> parent M 0 (Lng M - 1)"
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and cond: "transCondV M"
    and nadm: "\<not> adm M j0"
  shows "Lng (Br (Red (seg M (Adm M j0) j1))) \<ge> 1"
    and "j0 - Adm M j0
           = Joints (Red (seg M (Adm M j0) j1)) ! (Lng (Br (Red (seg M (Adm M j0) j1))) - 1)"
    and "FirstNodes (Red (seg M (Adm M j0) j1)) ! (Lng (Br (Red (seg M (Adm M j0) j1))) - 1)
           = j1 - Adm M j0"
    and "entry (Red (seg M (Adm M j0) j1)) 0 (j1 - Adm M j0)
           = entry (Red (seg M (Adm M j0) j1)) 1 (j1 - Adm M j0)"
proof -
  have nxR: "nextR M 1 (parent M 0 (Lng M - 1)) (Lng M - 1)"
    using e1x_condV_nextR1[OF MP cond] by (simp add: transJ0_def transJ1_def)
  have gap: "parent M 0 (Lng M - 1) < Lng M - 1 - 1"
    using s85b_condV_bridge(2)[OF MP cond]
    unfolding transJ0_def transJ1_def by linarith
  have nadm': "\<not> adm M (parent M 0 (Lng M - 1))" using nadm by (simp add: j0_def)
  note L = m_8_5_Joints_FirstNodes_basic[OF MST MP nxR nadm' gap]
  show "Lng (Br (Red (seg M (Adm M j0) j1))) \<ge> 1"
    using L(1) by (simp add: j0_def j1_def)
  show "j0 - Adm M j0
           = Joints (Red (seg M (Adm M j0) j1)) ! (Lng (Br (Red (seg M (Adm M j0) j1))) - 1)"
    using L(2) by (simp add: j0_def j1_def)
  show "FirstNodes (Red (seg M (Adm M j0) j1)) ! (Lng (Br (Red (seg M (Adm M j0) j1))) - 1)
           = j1 - Adm M j0"
    using L(3) by (simp add: j0_def j1_def)
  show "entry (Red (seg M (Adm M j0) j1)) 0 (j1 - Adm M j0)
           = entry (Red (seg M (Adm M j0) j1)) 1 (j1 - Adm M j0)"
    using L(4) by (simp add: j0_def j1_def)
qed

subsection \<open>HB discharged: the adm-case \<open>t\<^sub>2\<close>-component lower bound\<close>

text \<open>The adm analogue of part (3) of the Joints/FirstNodes lemma — the last
  named residual of the r15-S5b condV exchange triple.  Route (mirrors the
  article's non-adm proof, with the Adm-zero regime COMING FOR FREE in the adm
  case): \<open>N = (M\<^sub>j)\<^bsub>j=j\<^sub>0\<^esub>\<^bsup>j\<^sub>1\<^esup>\<close>, \<open>Red N \<in> DT\<^bsub>PS\<^esub>\<close>
  (@{thm [source] m_8_2_standard_slice_Red_strongmono}), \<open>transJ0 (Red N) = 0\<close>
  (@{thm [source] repr_transJ0_shift}) hence \<open>transJm1 (Red N) = 0\<close>, so the
  Adm0 family identifies the last branch (@{thm [source] m_8_2_j1eq_Adm0},
  @{thm [source] m_8_2_j0eq_Adm0}) with last joint \<open>0\<close> — the FIRST disjunct of
  case (i) of @{thm [source] m_8_2_subexpr_component_strongmono_uncond} fires,
  bounding every component of the body of \<open>Trans (Red N)\<close> from below by
  \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0\<close>.  \<open>Trans (Red N) = Trans N = c\<^sub>2 = D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>0\<^esub>(t\<^sub>2 + D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0)\<close>
  (@{thm [source] m_7_3_Trans_Red}, @{thm [source] m_8_5_scbdec_Np_condV_adm})
  pins the body, whose \<open>P\<^sub>B\<close>-components include \<open>t\<^sub>2\<close>'s.  \<open>Br (Red N) \<noteq> []\<close> by
  the trunk-step/parent-uniqueness contradiction, exactly as in
  @{thm [source] m_8_5_Joints_FirstNodes_basic}.  Empirical: 53/53 (r15, two
  seeds) + 60/60 DEEP (\<open>Lng \<ge> 9\<close>, this round, python/_r16_e1_nonadm_exch.py).\<close>

lemma m_8_5_condV_adm_t2_components:
  fixes M :: pairseq
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and cond: "transCondV M" and admj0: "adm M (transJ0 M)"
  shows "\<forall>c \<in> set (PB (transT2 M)).
           leBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B) c"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have mono: "monoT M" using MP by (simp add: PT_PS_def)
  let ?j0 = "transJ0 M"
  let ?j1 = "Lng M - 1"
  let ?N = "seg M ?j0 ?j1"
  let ?RN = "Red ?N"
  \<comment> \<open>ranges from condition (V)\<close>
  have rng: "?j0 + 1 < ?j1"
    using s85b_condV_bridge(2)[OF MP cond] by (simp add: transJ1_def)
  have j0lt: "?j0 < ?j1" using rng by linarith
  have L1: "1 < Lng M" using rng by linarith
  have j1gt0: "0 < ?j1" using rng by linarith
  have j1le: "?j1 \<le> Lng M - 1" by simp
  have hp0M: "hasParent M 0 (Lng M - 1)"
    by (rule monoT_hasParent0_last[OF MT mono L1])
  \<comment> \<open>ancestry \<open>leR M 0 j\<^sub>0 j\<^sub>1\<close> (the row-0 parent edge)\<close>
  have le0j: "le0 M ?j0 ?j1" by (rule s84c1_le0_j0[OF MP j1gt0])
  have leM: "leR M 0 ?j0 ?j1" using le0j by (simp add: leR_def)
  \<comment> \<open>the reduced slice: strongly mono, length preserved\<close>
  have NR: "?RN \<in> RT_PS" using slice_Red_in_RT_PS[OF MR j0lt j1le leM] by simp
  have NT: "?RN \<in> T_PS" using NR by (simp add: RT_PS_def)
  have segT: "?N \<in> T_PS" using slice_Red_in_RT_PS[OF MR j0lt j1le leM] by simp
  have ND: "?RN \<in> DT_PS"
    by (rule m_8_2_standard_slice_Red_strongmono[OF MST j0lt j1le leM])
  have monoRN: "monoT ?RN" using ND by (simp add: DT_PS_def)
  have NP: "?RN \<in> PT_PS" using NT monoRN by (simp add: PT_PS_def)
  have LRN: "Lng ?RN = Lng ?N" by (rule m_6_5_Lng_Red[OF segT])
  have LNval: "Lng ?N = Suc ?j1 - ?j0" by simp
  have LRNm1: "Lng ?RN - 1 = ?j1 - ?j0" using LRN LNval j0lt by linarith
  have RNge2: "2 \<le> Lng ?RN" using LRNm1 rng by linarith
  have LNpos: "0 < Lng ?N" using LNval j0lt by linarith
  \<comment> \<open>IncrFirst bridge for \<open>nextR\<close>\<close>
  have segeq: "?N = (IncrFirst ^^ (entry M 0 ?j0 - entry M 1 ?j0)) ?RN"
    using m_6_6_ancestor_slice_Red_IncrFirst[OF MR j0lt j1le leM] by simp
  have j1ltLM: "?j1 < Lng M" using L1 by simp
  have bridge: "\<And>i p q. i \<le> (1::nat) \<Longrightarrow> p < Lng ?N \<Longrightarrow> q < Lng ?N
                 \<Longrightarrow> nextR ?RN i p q = nextR M i (?j0 + p) (?j0 + q)"
  proof -
    fix i p q :: nat assume i: "i \<le> 1" and p: "p < Lng ?N" and q: "q < Lng ?N"
    have "nextR ?RN i p q
            = nextR ((IncrFirst ^^ (entry M 0 ?j0 - entry M 1 ?j0)) ?RN) i p q"
      by (simp add: nextR_funpow_IncrFirst_eq)
    also have "\<dots> = nextR ?N i p q" using segeq by simp
    also have "\<dots> = nextR M i (?j0 + p) (?j0 + q)"
      by (rule rcpb_nextR_seg[OF j1ltLM i p q])
    finally show "nextR ?RN i p q = nextR M i (?j0 + p) (?j0 + q)" .
  qed
  \<comment> \<open>the Adm-zero regime of the slice: \<open>transJ0 ?RN = 0\<close>, hence \<open>transJm1 ?RN = 0\<close>\<close>
  have mint: "?j0 < Lng M - 2" using rng by linarith
  have anc0: "?j0 \<le> parent M 0 (Lng M - 1)" by (simp add: transJ0_def transJ1_def)
  have leM2: "leR M 0 ?j0 (Lng M - 1)" using leM by simp
  have tj0RN: "transJ0 ?RN = 0"
    using repr_transJ0_shift[OF MR mint leM2 hp0M anc0] by simp
  have Adm0RN: "transJm1 ?RN = 0"
    using tj0RN adm_zero by (simp add: transJm1_def Adm_def)
  \<comment> \<open>row-1 parent edge of the host's last column sits at \<open>j\<^sub>0 \<noteq> j\<^sub>1 - 1\<close>\<close>
  have nxR1: "nextR M 1 ?j0 ?j1" by (rule e1x_condV_nextR1[OF MP cond])
  have notnext: "\<not> nextR M 1 (?j1 - 1) ?j1"
  proof
    assume H: "nextR M 1 (?j1 - 1) ?j1"
    have "?j1 - 1 = ?j0" by (rule nextR1_unique[OF H nxR1])
    thus False using rng by linarith
  qed
  \<comment> \<open>\<open>Br ?RN \<noteq> []\<close>\<close>
  have Brne: "Br ?RN \<noteq> []"
  proof
    assume Bemp: "Br ?RN = []"
    have trmaxeq: "TrMax ?RN = Lng ?RN - 1"
    proof (rule ccontr)
      assume ne: "TrMax ?RN \<noteq> Lng ?RN - 1"
      hence "Br ?RN = P (seg ?RN (TrMax ?RN + 1) (Lng ?RN - 1))" by (simp add: Br_def)
      hence "Br ?RN \<noteq> []" using P_nonempty by simp
      thus False using Bemp by simp
    qed
    have TrMaxpos: "0 < TrMax ?RN" using trmaxeq RNge2 by linarith
    have step: "nextR ?RN 1 (TrMax ?RN - 1) (TrMax ?RN)"
      using TrMax_trunk_step[OF NT, of "TrMax ?RN - 1"] TrMaxpos by simp
    have e2: "TrMax ?RN - 1 = Lng ?RN - 2" using trmaxeq by simp
    have p2: "Lng ?RN - 2 < Lng ?N" using LRN RNge2 by linarith
    have q2: "Lng ?RN - 1 < Lng ?N" using LRN RNge2 by linarith
    have add_p2: "?j0 + (Lng ?RN - 2) = ?j1 - 1" using LRNm1 RNge2 j0lt by linarith
    have add_q2: "?j0 + (Lng ?RN - 1) = ?j1" using LRNm1 j0lt by linarith
    have stepRN: "nextR ?RN 1 (Lng ?RN - 2) (Lng ?RN - 1)" using step trmaxeq e2 by simp
    have "nextR M 1 (?j1 - 1) ?j1"
      using bridge[of 1 "Lng ?RN - 2" "Lng ?RN - 1"] p2 q2 stepRN add_p2 add_q2 by simp
    thus False using notnext by simp
  qed
  have j1gtRN: "Lng ?RN - 1 > 1" using LRNm1 rng by linarith
  \<comment> \<open>last-branch identification: first node = last column, joint = \<open>0\<close>\<close>
  have FNlast: "FirstNodes ?RN ! (Lng (Br ?RN) - 1) = Lng ?RN - 1"
    by (rule m_8_2_j1eq_Adm0[OF NR NP Brne j1gtRN Adm0RN])
  have Jlast: "Joints ?RN ! (Lng (Br ?RN) - 1) = transJ0 ?RN"
    by (rule m_8_2_j0eq_Adm0[OF NR NP Brne j1gtRN Adm0RN])
  have J0z: "Joints ?RN ! (Lng (Br ?RN) - 1) = 0" using Jlast tj0RN by simp
  \<comment> \<open>strong-monomiality component bound, case (i) first disjunct\<close>
  obtain t' where
    TRN: "Trans ?RN = Dpt (enat (entry ?RN 1 0)) t'"
    and bnd: "(Joints ?RN ! (Lng (Br ?RN) - 1) = 0
          \<or> entry ?RN 0 (FirstNodes ?RN ! (Lng (Br ?RN) - 1))
              = entry ?RN 1 (FirstNodes ?RN ! (Lng (Br ?RN) - 1)))
         \<longrightarrow> (\<forall>p\<in>set (PB t').
                leBT (Dpt (enat (entry ?RN 1 (FirstNodes ?RN ! (Lng (Br ?RN) - 1)))) 0\<^sub>B) p)"
    using m_8_2_subexpr_component_strongmono_uncond[OF ND Brne] by blast
  have compbnd: "\<forall>p\<in>set (PB t').
      leBT (Dpt (enat (entry ?RN 1 (Lng ?RN - 1))) 0\<^sub>B) p"
    using bnd J0z FNlast by simp
  \<comment> \<open>row-1 entries of the reduced slice = host row-1 entries\<close>
  have e1RN: "\<And>p. p < Lng ?N \<Longrightarrow> entry ?RN 1 p = entry M 1 (?j0 + p)"
  proof -
    fix p assume pL: "p < Lng ?N"
    have pRN: "p < Lng ?RN" using pL LRN by simp
    have "entry ?N 1 p
            = entry ((IncrFirst ^^ (entry M 0 ?j0 - entry M 1 ?j0)) ?RN) 1 p"
      using segeq by simp
    hence a: "entry ?N 1 p = entry ?RN 1 p"
      using entry_funpow_IncrFirst1[OF pRN] by simp
    have b: "entry ?N 1 p = entry M 1 (?j0 + p)" by (rule entry_seg[OF pL])
    show "entry ?RN 1 p = entry M 1 (?j0 + p)" using a b by simp
  qed
  have lastL: "Lng ?RN - 1 < Lng ?N" using LRN LNpos by linarith
  have addlast: "?j0 + (Lng ?RN - 1) = ?j1" using LRNm1 j0lt by linarith
  have e1last: "entry ?RN 1 (Lng ?RN - 1) = entry M 1 ?j1"
    using e1RN[OF lastL] addlast by simp
  have zeroL: "(0::nat) < Lng ?N" using LNpos by simp
  have e1zero: "entry ?RN 1 0 = entry M 1 ?j0" using e1RN[OF zeroL] by simp
  \<comment> \<open>pin the body: \<open>Trans ?RN = Trans ?N = c\<^sub>2 = D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>0\<^esub>(t\<^sub>2 + D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0)\<close>\<close>
  have NpSeg: "s84x_Np M = ?N"
    using s85b_condV_bridge(4)[OF MP cond] by (simp add: s84x_Np_def)
  have TN: "Trans ?N
      = Dpt (enat (entry M 1 ?j0)) (transT2 M +\<^sub>B Dpt (enat (entry M 1 ?j1)) 0\<^sub>B)"
    using m_8_5_scbdec_Np_condV_adm(2)[OF MST MP cond admj0] NpSeg
    by (simp add: transJ1_def)
  have TRedN: "Trans ?N = Trans ?RN" by (rule m_7_3_Trans_Red[OF NR])
  have pinned: "Dpt (enat (entry M 1 ?j0)) (transT2 M +\<^sub>B Dpt (enat (entry M 1 ?j1)) 0\<^sub>B)
      = Dpt (enat (entry M 1 ?j0)) t'"
    using TN TRedN TRN e1zero by simp
  have t'eq: "t' = transT2 M +\<^sub>B Dpt (enat (entry M 1 ?j1)) 0\<^sub>B"
    using pinned by simp
  \<comment> \<open>\<open>t\<^sub>2\<close>'s components sit inside \<open>t'\<close>'s\<close>
  obtain as where t2l: "transT2 M = Trm as" by (cases "transT2 M") auto
  have t'l: "t' = Trm (as @ [DB (enat (entry M 1 ?j1)) 0\<^sub>B])"
    using t'eq t2l by simp
  have sub: "set (PB (transT2 M)) \<subseteq> set (PB t')"
    using t2l t'l by (auto simp: PB_def)
  show ?thesis
  proof
    fix c assume "c \<in> set (PB (transT2 M))"
    hence mem: "c \<in> set (PB t')" using sub by blast
    have "leBT (Dpt (enat (entry ?RN 1 (Lng ?RN - 1))) 0\<^sub>B) c"
      using compbnd mem by blast
    thus "leBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B) c"
      using e1last by simp
  qed
qed

text \<open>Corollary: the OTHER r15-S5b residual, \<open>t2lb\<close> — \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>0\<^esub> 0 < t\<^sub>2\<close> — now
  unconditional (via the pure order lemma @{thm [source] s85b_complb_lessBT},
  \<open>t\<^sub>2 \<noteq> 0\<close> and \<open>M\<^bsub>1,j\<^sub>0\<^esub> < M\<^bsub>1,j\<^sub>1\<^esub>\<close>).\<close>

lemma m_8_5_condV_adm_t2lb:
  fixes M :: pairseq
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and cond: "transCondV M" and admj0: "adm M (transJ0 M)"
  shows "lessBT (Dpt (enat (entry M 1 (transJ0 M))) 0\<^sub>B) (transT2 M)"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  note J1pos = s85b_condV_setup(1)[OF MR MP cond]
  note jm1 = s85b_jm1_adm[OF admj0]
  have t2ne: "transT2 M \<noteq> 0\<^sub>B"
    by (rule m_8_5_scbdec_t2_nonzero_condV[OF MR MP cond])
  have uv: "entry M 1 (transJ0 M) < entry M 1 (transJ1 M)"
    using m_8_5_condV_uv[OF MR MP J1pos cond] jm1 by simp
  have HB: "\<forall>c \<in> set (PB (transT2 M)).
              leBT (Dpt (enat (entry M 1 (transJ1 M))) 0\<^sub>B) c"
    using m_8_5_condV_adm_t2_components[OF MST MP cond admj0]
    by (simp add: transJ1_def)
  show ?thesis by (rule s85b_complb_lessBT[OF uv t2ne HB])
qed

subsection \<open>The condition-(V) adm-case exchange triple, fully unconditional\<close>

text \<open>命題（条件(V)の下での\<open>Trans\<close>と基本列の交換関係）, adm branch, A28-corrected
  index \<open>m\<^sub>n + 1 = n\<close>, with NO residual hypothesis left: conclusion (3) is now
  STRICT and unconditional (HB discharged above).  This closes the r15-S5b
  front's "modulo two named residuals" caveat entirely.\<close>

lemma m_8_5_Trans_oper_exchange_condV_adm_uncond:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS" and n1: "n \<ge> 1"
    and cond: "transCondV M"
    and admj0: "adm M (parent M 0 (Lng M - 1))"
  shows "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))"
    and "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
    and "lessBT (operB (Trans M) (numBT n)) (Trans ((M::pairseq)[n + 1]))"
proof -
  have admj0': "adm M (transJ0 M)"
    using admj0 by (simp add: transJ0_def transJ1_def)
  show "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))"
    by (rule m_8_5_scbdec_exchange1_condV_adm[OF MST MP cond admj0' n1])
  show "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
    by (rule m_8_5_scbdec_exchange2_condV_adm[OF MST MP cond admj0' n1])
  have HB: "\<forall>c \<in> set (PB (transT2 M)).
              leBT (Dpt (enat (entry M 1 (transJ1 M))) 0\<^sub>B) c"
    using m_8_5_condV_adm_t2_components[OF MST MP cond admj0']
    by (simp add: transJ1_def)
  have "lessBT (operB (Trans M) (numBT n)) (Trans ((M::pairseq)[Suc n]))"
    by (rule m_8_5_scbdec_exchange3_strict_condV_adm[OF MST MP cond admj0' n1 HB])
  thus "lessBT (operB (Trans M) (numBT n)) (Trans ((M::pairseq)[n + 1]))"
    by simp
qed

subsection \<open>Dispatcher wiring: the \<open>exchV\<close> hypothesis weakened to its non-adm leg\<close>

text \<open>The §8.7 dispatcher instance with the condition-(V) exchange hypothesis
  discharged on the ADM branch (via the unconditional triple above, witness
  \<open>k = m\<close>); only the non-adm branch — proven REACHABLE this round, see the
  refutation note — remains a named hypothesis (\<open>exchVn\<close>), now strictly weaker
  than the original \<open>exchV\<close>.  Every other hypothesis is verbatim
  @{thm [source] m_8_7_fseq_descend_dispatcher}.\<close>

lemma m_8_7_fseq_descend_dispatcher_admV:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS"
    and n1: "1 \<le> n" and L: "1 < Lng M"
    and TOT: "\<And>N. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow> Trans N \<in> OT_B"
    and exchI: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondI N \<Longrightarrow> 0 < parent N 0 (Lng N - 1) \<Longrightarrow> 1 < m \<Longrightarrow>
                  Trans ((N::pairseq)[m]) = operB (Trans N) (numBT (m - 1))"
    and exchII: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondII N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. Trans ((N::pairseq)[m]) = operB (Trans N) (numBT k)"
    and exchIII: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIII N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchIV: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIV N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchVn: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondV N \<Longrightarrow> \<not> adm N (parent N 0 (Lng N - 1)) \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchVI: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondVI N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  have exchV: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondV N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
  proof -
    fix N :: pairseq and m :: nat
    assume NST: "N \<in> ST_PS" and NP: "N \<in> PT_PS" and j1gt: "1 < Lng N - 1"
      and cV: "transCondV N" and m2: "1 < m"
    show "\<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    proof (cases "adm N (parent N 0 (Lng N - 1))")
      case True
      have m1: "1 \<le> m" using m2 by linarith
      have "lessBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT m))"
        by (rule m_8_5_Trans_oper_exchange_condV_adm_uncond(1)[OF NST NP m1 cV True])
      thus ?thesis by blast
    next
      case False
      show ?thesis by (rule exchVn[OF NST NP j1gt cV False m2])
    qed
  qed
  show ?thesis
    by (rule m_8_7_fseq_descend_dispatcher[OF MST n1 L TOT exchI exchII exchIII
          exchIV exchV exchVI])
qed


(* ===== round 16b front E2 (wt-s5 10425ca): terminal-slice modVE reduction ===== *)

section \<open>§8.2 round-16 front E2 — terminal-slice / \<open>Trans\<close> reduction\<close>

text \<open>TARGET: p_8_2_condV_terminal_slice_Trans (pss_paper 1604, the lemma
  ``terminal slice and Trans under condition (V)''), the single residual of the
  whole section 8.4 various-scb cluster and of the non-adm condV item.  Here we
  discharge, UNCONDITIONALLY, every part of the lemma EXCEPT one value equation
  VE': bpHeadT (Trans (seg M m (Lng M - 1))) = bpHeadT (Trans M).  VE' says the
  terminal slice M' = seg M m j1 shares the deep tail t1 of Trans M, with only
  the leftmost D-head rebased from M_1,0 to M_1,m (empirically 1284/1284 +
  52/52 over genuine ST_PS and the wider RT_PS regime, including 191 non-adm-j0
  hosts, python/_r16_e2_validate.py).  VE' is the article's front-peel / Pred
  simultaneous induction (the hard core that blocked rounds 15/16); it is stated
  as an explicit hypothesis of m_8_2_condV_terminal_slice_Trans_modVE below and
  is NOT proved here.\<close>

text \<open>Every reduced monoT Trans is principal with leftmost head M_1,0.  (The
  unconditional core of m_8_2_subexpr_leftend_unique, but needing only RT_PS and
  monoT, not DT_PS -- no descending hypothesis.)\<close>

lemma e2x_Trans_principal_head:
  assumes MR: "M \<in> RT_PS" and monoM: "monoT M"
  shows "Trans M = Dpt (enat (entry M 1 0)) (bpHeadT (Trans M))"
proof -
  have nz: "\<not> zeroT M" using monoM by (simp add: monoT_def)
  have tne: "Trans M \<noteq> 0\<^sub>B" using m_7_3_Trans_zeroT[OF MR] nz by blast
  obtain p where Tp: "Trans M = Trm [p]"
    using Trans_PT_single[THEN mp, THEN mp, THEN mp, OF MR monoM tne] by blast
  obtain u a where pua: "p = DB u a" by (cases p)
  have hv: "bpHeadV (Trans M) = enat (entry M 1 0)"
    using m_7_3_Trans_leftend MR by blast
  have ueq: "u = enat (entry M 1 0)" using Tp pua hv by simp
  have "Trans M = Dpt (enat (entry M 1 0)) a" using Tp pua ueq by simp
  moreover have "bpHeadT (Trans M) = a" using Tp pua by simp
  ultimately show ?thesis by simp
qed

text \<open>The exists-unique scaffold: once both Trans M and Trans M' are principal
  with heads M_1,0 resp. M_1,m AND share their deep tail (VE'), the target's
  unique common t1 is exactly bpHeadT (Trans M).  Fully unconditional.\<close>

lemma e2x_terminal_slice_scaffold:
  fixes M M' :: pairseq and m :: nat
  assumes princM: "Trans M = Dpt (enat (entry M 1 0)) (bpHeadT (Trans M))"
    and princM': "Trans M' = Dpt (enat (entry M 1 m)) (bpHeadT (Trans M'))"
    and VE: "bpHeadT (Trans M') = bpHeadT (Trans M)"
  shows "\<exists>!t1. Trans M = Dpt (enat (entry M 1 0)) t1
            \<and> Trans M' = Dpt (enat (entry M 1 m)) t1"
proof (rule ex1I[where a="bpHeadT (Trans M)"])
  show "Trans M = Dpt (enat (entry M 1 0)) (bpHeadT (Trans M))
      \<and> Trans M' = Dpt (enat (entry M 1 m)) (bpHeadT (Trans M))"
    using princM princM' VE by simp
next
  fix t1
  assume "Trans M = Dpt (enat (entry M 1 0)) t1
        \<and> Trans M' = Dpt (enat (entry M 1 m)) t1"
  hence "Dpt (enat (entry M 1 0)) t1 = Dpt (enat (entry M 1 0)) (bpHeadT (Trans M))"
    using princM by simp
  thus "t1 = bpHeadT (Trans M)" by simp
qed

text \<open>The target lemma p_8_2_condV_terminal_slice_Trans, verbatim statement,
  reduced to the single hypothesis VE' (bpHeadT (Trans M') = bpHeadT (Trans M)).
  Everything else is discharged: the slice is monoT (m_6_4_mono_slice, using
  m <= j0' from the hypothesis) with reduced form N = Red M' in RT_PS
  (slice_Red_in_RT_PS, via leR M 0 m j1), Trans M' = Trans N (m_7_3_Trans_Red),
  the head value entry N 1 0 = M_1,m (repr_entry1_shift_gen), and both
  principalities from e2x_Trans_principal_head.\<close>

lemma m_8_2_condV_terminal_slice_Trans_modVE:
  fixes M :: pairseq and m :: nat
  defines "j1 \<equiv> Lng M - 1"
  defines "J1 \<equiv> Lng (Br M) - 1"
  defines "j0' \<equiv> Joints M ! J1"
  defines "j1' \<equiv> FirstNodes M ! J1"
  defines "M' \<equiv> seg M m j1"
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS" and Brne: "Br M \<noteq> []"
    and hyp: "m < j0' \<or> (m = j0' \<and> entry M 0 j1' = entry M 1 j1' \<and> descending (Br M))"
    and VE: "bpHeadT (Trans M') = bpHeadT (Trans M)"
  shows "\<exists>!t1. Trans M = Dpt (enat (entry M 1 0)) t1
            \<and> Trans M' = Dpt (enat (entry M 1 m)) t1"
proof -
  have j1v: "j1 = Lng M - 1" by (simp add: j1_def)
  have J1v: "J1 = Lng (Br M) - 1" by (simp add: J1_def)
  have j0'v: "j0' = Joints M ! J1" by (simp add: j0'_def)
  have j1'v: "j1' = FirstNodes M ! J1" by (simp add: j1'_def)
  have M'v: "M' = seg M m j1" by (simp add: M'_def)
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have monoM: "monoT M" using MP by (simp add: PT_PS_def)
  have BrL: "0 < Lng (Br M)" using Brne by (cases "Br M") auto
  have J1Br: "J1 < Lng (Br M)" using BrL J1v by simp
  have geom: "j0' \<le> TrMax M \<and> TrMax M < j1'"
    using m_6_4_FirstNodes_TrMax_Joints[OF MP J1Br] by (simp add: j0'v j1'v)
  have g1: "j0' \<le> TrMax M" and g2: "TrMax M < j1'" using geom by auto
  have fL: "j1' < Lng M" using a1_FN_lt[OF MP J1Br] by (simp add: j1'v)
  have mlej0: "m \<le> j0'" using hyp by auto
  have mj1: "m < j1" using g1 g2 mlej0 fL j1v by linarith
  have mlej1: "m \<le> j1" using mj1 by linarith
  have j1LM: "j1 \<le> Lng M - 1" by (simp add: j1v)
  have j1ltLM: "j1 < Lng M" using mj1 j1v by linarith
  \<comment> \<open>the slice is monoT and (as a reduced form) in \<open>RT\<^sub>PS\<close>\<close>
  have j0leJ: "m \<le> Joints M ! (Lng (Br M) - 1)" using mlej0 j0'v J1v by simp
  have monoSeg: "monoT (seg M m j1)"
    by (rule m_6_4_mono_slice[OF MP mj1 j1LM j0leJ])
  have segne: "seg M m j1 \<noteq> []" using mj1 by (simp add: seg_def)
  have segT: "seg M m j1 \<in> T_PS" using segne by (simp add: T_PS_def)
  have segPT: "seg M m j1 \<in> PT_PS" using segT monoSeg by (simp add: PT_PS_def)
  have le0mj1: "le0 M m j1"
    by (rule le0_monoT_seg_into_list[OF MT monoSeg mlej1 order.refl j1ltLM])
  have leMmj1: "leR M 0 m j1" using le0mj1 by (simp add: leR_def)
  define N where "N = Red (seg M m j1)"
  have NR: "N \<in> RT_PS"
    using slice_Red_in_RT_PS[OF MR mj1 j1LM leMmj1] by (simp add: N_def)
  have monoN: "monoT N" using m_6_5_Red_preserves_monoT[OF segPT] by (simp add: N_def)
  have TMp: "Trans M' = Trans N"
    using m_7_3_Trans_Red[OF NR[unfolded N_def]] by (simp add: M'_def N_def)
  \<comment> \<open>the leftmost head value of the reduced slice is \<open>M\<^bsub>1,m\<^esub>\<close>\<close>
  have LNpos: "0 < Lng N"
  proof -
    have "Lng N = Lng (seg M m j1)" using m_6_5_Lng_Red[OF segT] by (simp add: N_def)
    also have "\<dots> = Suc j1 - m" by (simp add: Lng_seg)
    finally show ?thesis using mj1 by linarith
  qed
  have headN: "entry N 1 0 = entry M 1 m"
    using repr_entry1_shift_gen[OF MR mj1 j1LM leMmj1 LNpos[unfolded N_def]]
    by (simp add: N_def)
  \<comment> \<open>principality of both transforms, sharing the tail via \<open>VE'\<close>\<close>
  have princM: "Trans M = Dpt (enat (entry M 1 0)) (bpHeadT (Trans M))"
    by (rule e2x_Trans_principal_head[OF MR monoM])
  have princN: "Trans N = Dpt (enat (entry N 1 0)) (bpHeadT (Trans N))"
    by (rule e2x_Trans_principal_head[OF NR monoN])
  have princM': "Trans M' = Dpt (enat (entry M 1 m)) (bpHeadT (Trans M'))"
    using princN headN TMp by simp
  show ?thesis
    by (rule e2x_terminal_slice_scaffold[OF princM princM' VE])
qed


(* ===== round 16b front E3 (wt-s4b f7f018a): condIII exchange(2) + descent tower ===== *)

(* ===== round 16 front E3 (wt-s4b): §8.4 condIII exchange, A32-corrected ===== *)
section \<open>r16b-E3 — §8.4 命題（条件(III)か(IV)の下での\<open>Trans\<close>と基本列の交換関係） A32-corrected\<close>

text \<open>Target: \<open>p_8_4_Trans_oper_exchange\<close> (pss_paper 1906), A32-corrected.  Printed
  conclusion (1) index \<open>numBT(n-1)\<close> is FALSE (corrections A32 / r15-VX item 1,
  0/465 condIII); corrected form is STRICT \<open>lessBT (Trans(M[n])) (Trans(M)[n])\<close>.
  Conclusion (2) \<open>lessBT (Trans(M[n])) (Trans M)\<close> is the §8.4 DESCENT — this
  block proves it UNCONDITIONALLY (modulo the terminal-slice transports of
  front E2, taken as named hypotheses \<open>d1/d2/d3\<close> exactly as in
  @{thm [source] m_8_4_various_scb_IIIV_from_slice}) for the condition-(III)
  regime, by the two-letter descent tower, mirroring the r15-S5b condV route
  (@{thm [source] m_8_5_scbdec_exchange2_condV_adm}).  Prefix \<open>e3x_\<close>.\<close>

subsection \<open>The §8.4 two-letter descent tower \<open>e3x_H\<close>\<close>

text \<open>\<open>H\<^sub>0 = t\<^sub>2\<close>, \<open>H\<^sub>k\<^sub>+\<^sub>1 = t\<^sub>2 + D\<^bsub>ub\<^esub>(H\<^sub>k)\<close> (block letter \<open>ub = M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>\<close>).  Its flat
  string is the middle of the closed form of \<open>Trans(M[n])\<close> from L5, and — since
  \<open>ub < M\<^bsub>1,j\<^sub>1\<^esub>\<close> — it is bounded strictly by \<open>t\<^sub>2 + D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0\<close> = the \<open>c\<^sub>2\<close> body
  at every height.  Unlike the condV \<open>s85b_W\<close> (single head letter), the head
  letter \<open>M\<^bsub>1,j\<^sub>-\<^sub>1\<^esub>\<close> here sits OUTSIDE the tower and cancels in the descent
  comparison, so \<open>H\<close> carries only the block letter.\<close>

fun e3x_H :: "nat \<Rightarrow> BT \<Rightarrow> nat \<Rightarrow> BT" where
  "e3x_H ub t 0 = t"
| "e3x_H ub t (Suc k) = t +\<^sub>B Dpt (enat ub) (e3x_H ub t k)"

lemma e3x_H_dfree:
  assumes "dfree_BT t"
  shows "dfree_BT (e3x_H ub t k)"
  using assms by (induction k) (simp_all add: dfree_BT_addBT)

lemma e3x_H_TB:
  assumes "t \<in> T_B"
  shows "e3x_H ub t k \<in> T_B"
  using assms e3x_H_dfree[of t ub k] by (simp add: T_B_def)

lemma e3x_H_flat:
  assumes tTB: "t \<in> T_B"
    and inner: "scb_decomp (t +\<^sub>B Dpt (enat ub) 0\<^sub>B) s0
                  (flatBT (Dpt (enat ub) 0\<^sub>B)) b0"
  shows "flatBT (e3x_H ub t k)
       = concat (replicate k (s0 @ [Dsym (enat ub)]))
         @ flatBT t @ concat (replicate k b0)"
proof (induction k)
  case 0 show ?case by simp
next
  case (Suc k)
  have c0TB: "Dpt (enat ub) 0\<^sub>B \<in> T_B" by (simp add: T_B_def)
  have c0p: "\<exists>p. Dpt (enat ub) 0\<^sub>B = Trm [p]" by auto
  have HTB: "e3x_H ub t k \<in> T_B" by (rule e3x_H_TB[OF tTB])
  have HpTB: "Dpt (enat ub) (e3x_H ub t k) \<in> T_B" using HTB by (simp add: T_B_def)
  have Hpp: "\<exists>p. Dpt (enat ub) (e3x_H ub t k) = Trm [p]" by auto
  have sub: "scb_decomp (t +\<^sub>B Dpt (enat ub) (e3x_H ub t k)) s0
               (flatBT (Dpt (enat ub) (e3x_H ub t k))) b0"
    by (rule m_7_2_add_scb_conj2[OF tTB c0TB c0p HpTB Hpp inner])
  have fsub: "flatBT (t +\<^sub>B Dpt (enat ub) (e3x_H ub t k))
              = s0 @ flatBT (Dpt (enat ub) (e3x_H ub t k)) @ b0"
    using sub by (simp add: scb_decomp_def)
  have "flatBT (e3x_H ub t (Suc k))
        = s0 @ Dsym (enat ub)
           # (concat (replicate k (s0 @ [Dsym (enat ub)]))
              @ flatBT t @ concat (replicate k b0)) @ b0"
    using fsub Suc.IH by simp
  also have "\<dots> = concat (replicate (Suc k) (s0 @ [Dsym (enat ub)]))
        @ flatBT t @ concat (replicate (Suc k) b0)"
    by (simp add: s85b_crep_comm_snoc s85b_crep_snoc s85b_crep_comm)
  finally show ?case .
qed

lemma e3x_H_lt_top:
  assumes uv: "ub < v"
  shows "lessBT (e3x_H ub t k) (t +\<^sub>B Dpt (enat v) 0\<^sub>B)"
proof (induction k)
  case 0
  show ?case
    using lessBT_addBT_self[of "Dpt (enat v) 0\<^sub>B" t] by simp
next
  case (Suc k)
  have hd: "lessBT (Dpt (enat ub) (e3x_H ub t k)) (Dpt (enat v) 0\<^sub>B)"
    using uv by simp
  have "lessBT (t +\<^sub>B Dpt (enat ub) (e3x_H ub t k)) (t +\<^sub>B Dpt (enat v) 0\<^sub>B)"
    by (rule lessBT_addBT_mono_right[OF hd])
  thus ?case by simp
qed

subsection \<open>Conclusion (2): the §8.4 descent \<open>Trans(M[n]) < Trans M\<close> (condition III)\<close>

text \<open>命題（条件(III)か(IV)の下での\<open>Trans\<close>と基本列の交換関係） conclusion (2),
  condition-(III) regime, UNCONDITIONAL modulo the terminal-slice transports
  \<open>d1/d2/d3\<close> of front E2 (spelled exactly as in
  @{thm [source] m_8_4_various_scb_IIIV_from_slice}).  \<open>Trans(M[n]) = s\<^sub>1 D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>1\<^esub>(H\<^sub>n\<^sub>-\<^sub>1) b\<^sub>1\<close>
  with \<open>H = e3x_H M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub> t\<^sub>2\<close>, and \<open>Trans M = s\<^sub>1 D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>1\<^esub>(t\<^sub>2 + D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0) b\<^sub>1\<close>
  (the condition-(III) \<open>c\<^sub>2\<close> shape); since \<open>M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub> < M\<^bsub>1,j\<^sub>1\<^esub>\<close>
  (@{thm [source] s84c1_jm2_basic}) the tower is strictly below \<open>c\<^sub>2\<close> at every
  height, and 部分表現の不等式の延長性 (@{thm [source] scbext_lessBT}) closes.
  Route mirrors @{thm [source] m_8_5_scbdec_exchange2_condV_adm}, avoiding the
  \<open>Trans M \<in> OT\<^bsub>B\<^esub>\<close> pillar.  Empirical (r15-VX item 1): 465/465 condIII.\<close>

lemma e3x_exchange2_condIII:
  fixes M :: pairseq and n :: nat and s1' b1' :: "Sym list"
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and cIII: "transCondIII M"
    and reg: "s84x_jm2 M < transJ0 M \<or> adm M (transJ0 M)"
    and admeq: "Adm M (s84x_jm2 M) = transJm1 M"
    and n1: "n \<ge> 1"
    and d1: "scb_decomp (transC2 M)
               (Dsym (enat (entry M 1 (transJm1 M))) # s1')
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b1'"
    and d2: "scb_decomp (Trans (s84x_Np M))
               (Dsym (enat (entry M 1 (s84x_jm2 M))) # s1')
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b1'"
    and d3: "Trans (Pred (s84x_Np M)) = Dpt (enat (entry M 1 (s84x_jm2 M))) (transT2 M)"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  let ?e1jm1 = "entry M 1 (transJm1 M)"
  let ?e1jm2 = "entry M 1 (s84x_jm2 M)"
  let ?v = "entry M 1 (Lng M - 1)"
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MPT by (simp add: PT_PS_def)
  have nVI: "\<not> transCondVI M"
    using cIII by (auto simp: transCondIII_def transCondVI_def)
  have j1gt: "1 < Lng M - 1" and T1: "transT1 M \<noteq> 0\<^sub>B"
    using s84d_L4_regime[OF MST MPT hp nVI] by simp_all
  have J1pos: "transJ1 M > 0" using j1gt by (simp add: transJ1_def)
  note shape = m_8_5_scbdec_c1_shape[OF MR MPT J1pos T1]
  have t2TB: "transT2 M \<in> T_B" using shape(3) .
  have jm2ltv: "?e1jm2 < ?v" by (rule s84c1_jm2_basic(2)[OF hp])
  \<comment> \<open>condition-(III) \<open>c\<^sub>2\<close> shape\<close>
  have c2simple: "transC2 M
      = Dpt (enat ?e1jm1) (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B)"
  proof -
    have condA: "transCondI M \<or> transCondIII M \<or> transCondV M" using cIII by simp
    have "transC2 M = s84d_c2hole M ?v" by (rule s84d_c2hole_at_j1)
    also have "\<dots> = Dpt (transV M) (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B)"
      using condA by (simp add: s84d_c2hole_def Let_def)
    finally show ?thesis using shape(1) by simp
  qed
  \<comment> \<open>the L5 closed form of \<open>Trans(M[n])\<close> and the pair \<open>(fst sb, snd sb)\<close>\<close>
  obtain sb where SB:
    "scb_decomp (transC2 M)
       (Dsym (enat ?e1jm1) # fst sb)
       (flatBT (Dpt (enat ?v) 0\<^sub>B)) (snd sb)
     \<and> scb_decomp (Trans (s84x_Np M))
       (Dsym (enat ?e1jm2) # fst sb)
       (flatBT (Dpt (enat ?v) 0\<^sub>B)) (snd sb)
     \<and> scb_decomp (Trans (s84x_Lp M))
       (Dsym (enat ?e1jm2) # fst sb)
       (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sb)
     \<and> Trans (Pred (s84x_Np M)) = Dpt (enat ?e1jm2) (transT2 M)
     \<and> flatBT (Trans (s84x_L M n))
       = s84x_s1 M @ Dsym (enat ?e1jm1)
           # concat (replicate n (fst sb @ [Dsym (enat ?e1jm2)]))
           @ [Zsym] @ concat (replicate n (snd sb)) @ s84x_b1 M
     \<and> flatBT (Trans ((M::pairseq)[n]))
       = s84x_s1 M @ Dsym (enat ?e1jm1)
           # concat (replicate (n - 1) (fst sb @ [Dsym (enat ?e1jm2)]))
           @ flatBT (transT2 M)
           @ concat (replicate (n - 1) (snd sb)) @ s84x_b1 M"
    using ex1_implies_ex[OF m_8_4_various_scb_IIIV_from_slice
            [OF MST MPT hp nVI reg admeq n1 d1 d2 d3]] by blast
  have c1sb: "scb_decomp (transC2 M) (Dsym (enat ?e1jm1) # fst sb)
                (flatBT (Dpt (enat ?v) 0\<^sub>B)) (snd sb)"
    using SB by blast
  have cfM: "flatBT (Trans ((M::pairseq)[n]))
       = s84x_s1 M @ Dsym (enat ?e1jm1)
           # concat (replicate (n - 1) (fst sb @ [Dsym (enat ?e1jm2)]))
           @ flatBT (transT2 M)
           @ concat (replicate (n - 1) (snd sb)) @ s84x_b1 M"
    using SB by blast
  \<comment> \<open>un-lift the head of \<open>c1sb\<close> to the inner core decomposition\<close>
  have iptv: "isPTB_str (flatBT (Dpt (enat ?v) 0\<^sub>B))"
    by (rule isPTB_str_Dpt) simp_all
  have deq: "flatBT (transC2 M)
      = (Dsym (enat ?e1jm1) # fst sb) @ flatBT (Dpt (enat ?v) 0\<^sub>B) @ snd sb"
    and bsbRP: "\<forall>x \<in> set (snd sb). x = RP"
    using c1sb by (auto simp: scb_decomp_def)
  have flatbody: "flatBT (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B)
      = fst sb @ flatBT (Dpt (enat ?v) 0\<^sub>B) @ snd sb"
    using deq c2simple by simp
  have innerV: "scb_decomp (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B)
                  (fst sb) (flatBT (Dpt (enat ?v) 0\<^sub>B)) (snd sb)"
    unfolding scb_decomp_def using flatbody iptv bsbRP by simp
  \<comment> \<open>transport the inner core to the block letter \<open>M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>\<close>\<close>
  have DvTB: "Dpt (enat ?v) 0\<^sub>B \<in> T_B" by (simp add: T_B_def)
  have Dvp: "\<exists>p. Dpt (enat ?v) 0\<^sub>B = Trm [p]" by auto
  have DjTB: "Dpt (enat ?e1jm2) 0\<^sub>B \<in> T_B" by (simp add: T_B_def)
  have Djp: "\<exists>p. Dpt (enat ?e1jm2) 0\<^sub>B = Trm [p]" by auto
  have innerJ: "scb_decomp (transT2 M +\<^sub>B Dpt (enat ?e1jm2) 0\<^sub>B)
                  (fst sb) (flatBT (Dpt (enat ?e1jm2) 0\<^sub>B)) (snd sb)"
    by (rule m_7_2_add_scb_conj2[OF t2TB DvTB Dvp DjTB Djp innerV])
  have Hflat: "flatBT (e3x_H ?e1jm2 (transT2 M) (n - 1))
      = concat (replicate (n - 1) (fst sb @ [Dsym (enat ?e1jm2)]))
        @ flatBT (transT2 M) @ concat (replicate (n - 1) (snd sb))"
    by (rule e3x_H_flat[OF t2TB innerJ])
  \<comment> \<open>read \<open>Trans(M[n])\<close> as \<open>s\<^sub>1 D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>1\<^esub>(H\<^sub>n\<^sub>-\<^sub>1) b\<^sub>1\<close>\<close>
  have fMn: "flatBT (Trans ((M::pairseq)[n]))
      = s84x_s1 M @ flatBP (DB (enat ?e1jm1) (e3x_H ?e1jm2 (transT2 M) (n - 1)))
        @ s84x_b1 M"
    using cfM Hflat by simp
  \<comment> \<open>the outer wrappers coincide with \<open>s84x_s1/b1\<close>; \<open>Trans M\<close> reads as \<open>s\<^sub>1 c\<^sub>2 b\<^sub>1\<close>\<close>
  have T1ne: "Trans (Pred M) \<noteq> Trm []" using T1 by (simp add: transT1_def)
  obtain s1 b1 where
    dc1: "scb_decomp (Trans (Pred M)) s1 (flatBT (transC1 M)) b1"
    and dc2M0: "scb_decomp (Trans M) s1 (flatBT (transC2 M)) b1"
    by (rule s84c2_Trans_c2_decomp[OF MR MPT J1pos T1])
  have s1b1ex1: "\<exists>!sb. scb_decomp (transT1 M) (fst sb) (flatBT (transC1 M)) (snd sb)"
  proof (rule ex1I[of _ "(s1, b1)"])
    show "scb_decomp (transT1 M) (fst (s1, b1)) (flatBT (transC1 M)) (snd (s1, b1))"
      using dc1 by (simp add: transT1_def)
  next
    fix y
    assume "scb_decomp (transT1 M) (fst y) (flatBT (transC1 M)) (snd y)"
    hence "fst y = s1 \<and> snd y = b1"
      using m_7_2_scb_unique_sb[OF _ dc1 T1ne] by (simp add: transT1_def)
    thus "y = (s1, b1)" by (simp add: prod_eq_iff)
  qed
  have theSB: "(THE sb. scb_decomp (transT1 M) (fst sb) (flatBT (transC1 M)) (snd sb))
             = (s1, b1)"
    by (rule the1_equality[OF s1b1ex1]) (use dc1 in \<open>simp add: transT1_def\<close>)
  have s1val: "s84x_s1 M = s1" and b1val: "s84x_b1 M = b1"
    using theSB by (simp_all add: s84x_s1_def s84x_b1_def)
  have dc2M: "scb_decomp (Trans M) (s84x_s1 M) (flatBT (transC2 M)) (s84x_b1 M)"
    using dc2M0 s1val b1val by simp
  have fTM: "flatBT (Trans M)
      = s84x_s1 M @ flatBP (DB (enat ?e1jm1) (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B))
        @ s84x_b1 M"
    using dc2M c2simple by (simp add: scb_decomp_def)
  have bRP: "\<forall>x \<in> set (s84x_b1 M). x = RP"
    using dc2M by (simp add: scb_decomp_def)
  \<comment> \<open>the strict core comparison via the tower bound\<close>
  have bodyLt: "lessBT (e3x_H ?e1jm2 (transT2 M) (n - 1))
                       (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B)"
    by (rule e3x_H_lt_top[OF jm2ltv])
  have coreLt: "lessBP (DB (enat ?e1jm1) (e3x_H ?e1jm2 (transT2 M) (n - 1)))
                       (DB (enat ?e1jm1) (transT2 M +\<^sub>B Dpt (enat ?v) 0\<^sub>B))"
    using bodyLt by simp
  show ?thesis by (rule scbext_lessBT[OF fMn fTM bRP coreLt])
qed


(* ===== round 16b front E4 (wt-b1 1609775): OT preserve via exchange-value reduction ===== *)

(* ===== round 16b front E4 (wt-b1): §8.7 OT-membership TRANSPORT via the
        [Buc1] OT_B-closure (the ARTICLE ROUTE) ===== *)

section \<open>r16b-E4 — §8.7 OT-membership via the [Buc1] OT_B-closure (article route)\<close>

text \<open>MAP (front E4).  The mechanized §8.7 skeleton
  (@{thm [source] m_8_7_Trans_preserves_OT} / @{thm [source] m_8_7_Trans_preserves_OT_modulo})
  is a \<open>Pred\<close>-recursion whose open content is the 4-case keystone dispatcher's
  \<open>resid\<close> (R2 \<open>dstep\<close> tail + R3 \<open>newOT\<close>/\<open>gbt\<close>, via
  @{thm [source] m_8_7_OT_keystone_step} / @{thm [source] m_8_7_Trans_OT_step_keystone})
  and the multiT \<open>multiD\<close> junction (@{thm [source] m_8_7_multiD_junction}).  That
  is OUR reformulation.  The ARTICLE (content.md 6122/6216) instead inducts on
  the \<open>ST\<^bsub>PS\<^esub>\<close> GENERATION rank: for an \<open>oper\<close>-step \<open>M = N[n]\<close> with
  \<open>Trans N \<in> OT\<^bsub>B\<^esub>\<close> (IH), the value identity
      \<open>Trans (N[n]) = (Trans N)[m\<^sub>n] [0]\<^bsup>k\<^esup>\<close>   (some \<open>m\<^sub>n\<close>, \<open>k\<close>)
  makes \<open>Trans (N[n]) \<in> OT\<^bsub>B\<^esub>\<close> flow through the [Buc1] closure
  @{thm [source] m_buc1_3_2_OT_B_closed} (\<open>OT\<^bsub>B\<^esub>\<close> closed under \<open>a[m] = operB a (numBT m)\<close>)
  ALONE — NO \<open>G\<^bsub>B\<^esub>\<close>-condition, NO \<open>descP\<close>-step, NO \<open>newOT\<close>.  Here \<open>[0] = \<lambda>a. operB a (numBT 0)\<close>
  (\<open>numBT 0 = Trm [] = 0\<^bsub>B\<^esub>\<close>).

  This block formalizes that TRANSPORT, unconditionally: OT-membership is carried
  from \<open>a\<close> to \<open>(operB a (numBT m))\<close> and through any number of \<open>[0]\<close>-iterations, so the
  \<open>Trans (N[n]) \<in> OT\<^bsub>B\<^esub>\<close> STEP reduces to the PURE VALUE identity above (no OT
  reasoning left in it).  The value identity is exactly the (A28-corrected) §8.5
  exchange, empirically 40/40 at the shifted index; it is the sole remaining open
  content of the OT pillar's step under this route.  Note the descent pillar
  (@{thm [source] m_8_7_fseq_descend_dispatcher_admV}) already bounds by the SAME
  \<open>operB (Trans N) (numBT k)\<close> object (with \<open>\<le>\<close>), so both pillars share this frame.\<close>

lemma e4x_Zero_OT_B: "Trm [] \<in> OT_B"
  by (simp add: OT_B_def OT_def T_B_def)

text \<open>[Buc1] closure, UNCONDITIONAL form: \<open>OT\<^bsub>B\<^esub>\<close> is closed under \<open>a[m] = operB a (numBT m)\<close>
  with NO \<open>a \<noteq> 0\<^bsub>B\<^esub>\<close> side condition — the \<open>a = Trm []\<close> case gives
  \<open>operB (Trm []) z = Trm [] \<in> OT\<^bsub>B\<^esub>\<close> (@{thm [source] b1x_operB_zero},
  @{thm [source] e4x_Zero_OT_B}), the rest is @{thm [source] m_buc1_3_2_OT_B_closed}.\<close>

lemma e4x_OT_B_operB_numBT:
  assumes "a \<in> OT_B"
  shows "operB a (numBT n) \<in> OT_B"
proof (cases "a = Trm []")
  case True
  hence "operB a (numBT n) = Trm []" by (simp add: b1x_operB_zero)
  thus ?thesis by (simp add: e4x_Zero_OT_B)
next
  case False
  show ?thesis by (rule m_buc1_3_2_OT_B_closed[OF assms False])
qed

text \<open>Iterated \<open>[0]\<close> preserves \<open>OT\<^bsub>B\<^esub>\<close>: \<open>a \<in> OT\<^bsub>B\<^esub> \<Longrightarrow> [0]\<^bsup>k\<^esup> a \<in> OT\<^bsub>B\<^esub>\<close>.  Pure
  induction on \<open>k\<close> over the unconditional single-step
  @{thm [source] e4x_OT_B_operB_numBT} (at \<open>m = 0\<close>).\<close>

lemma e4x_OT_B_op0_iter:
  assumes "a \<in> OT_B"
  shows "((\<lambda>x. operB x (numBT 0))^^k) a \<in> OT_B"
  using assms
proof (induction k arbitrary: a)
  case 0
  thus ?case by simp
next
  case (Suc k)
  have step: "operB a (numBT 0) \<in> OT_B" by (rule e4x_OT_B_operB_numBT[OF Suc.prems])
  have ih: "((\<lambda>x. operB x (numBT 0))^^k) (operB a (numBT 0)) \<in> OT_B"
    by (rule Suc.IH[OF step])
  have "((\<lambda>x. operB x (numBT 0))^^(Suc k)) a
          = ((\<lambda>x. operB x (numBT 0))^^k) (operB a (numBT 0))"
    by (simp only: funpow_Suc_right o_apply)
  thus ?case using ih by simp
qed

text \<open>§8.7 OT-membership STEP (article route, ABSTRACT).  Given the IH \<open>a \<in> OT\<^bsub>B\<^esub>\<close>
  and the value identity \<open>b = [0]\<^bsup>k\<^esup> (operB a (numBT m))\<close>, conclude \<open>b \<in> OT\<^bsub>B\<^esub>\<close>.
  Composes @{thm [source] e4x_OT_B_operB_numBT} (one \<open>[m]\<close>) with
  @{thm [source] e4x_OT_B_op0_iter} (the \<open>[0]\<^bsup>k\<^esup>\<close> tail).  ALL OT reasoning is here;
  the caller's only remaining duty is the pure BT-VALUE identity for \<open>b\<close>.\<close>

lemma m_8_7_OT_via_exchange_value:
  assumes ihOT: "a \<in> OT_B"
    and val: "b = ((\<lambda>x. operB x (numBT 0))^^k) (operB a (numBT m))"
  shows "b \<in> OT_B"
proof -
  have "operB a (numBT m) \<in> OT_B" by (rule e4x_OT_B_operB_numBT[OF ihOT])
  hence "((\<lambda>x. operB x (numBT 0))^^k) (operB a (numBT m)) \<in> OT_B"
    by (rule e4x_OT_B_op0_iter)
  thus ?thesis using val by simp
qed

text \<open>§8.7 OT-membership STEP specialised to \<open>Trans\<close> / \<open>oper\<close> (existential value form,
  matching the descent pillar's \<open>\<exists>k. \<dots> operB (Trans N) (numBT k)\<close> phrasing).  From
  \<open>Trans N \<in> OT\<^bsub>B\<^esub>\<close> and the existence of an exchange presentation of \<open>Trans (N[n])\<close>,
  conclude \<open>Trans (N[n]) \<in> OT\<^bsub>B\<^esub>\<close>.  This is the OT-pillar analogue of
  @{thm [source] m_8_7_fseq_descend_dispatcher_admV}: it reduces the whole OT step
  to the §8.5 exchange EQUALITY (A28), with no residual OT/\<open>G\<^bsub>B\<^esub>\<close>/descP obligations.\<close>

lemma m_8_7_Trans_OT_step_via_exchange:
  assumes ihOT: "Trans N \<in> OT_B"
    and val: "\<exists>m k. Trans ((N::pairseq)[n])
                     = ((\<lambda>x. operB x (numBT 0))^^k) (operB (Trans N) (numBT m))"
  shows "Trans ((N::pairseq)[n]) \<in> OT_B"
  using val m_8_7_OT_via_exchange_value[OF ihOT] by blast

text \<open>§8.7 MAIN RESULT via the ARTICLE ROUTE (generation-rank induction).  The full
  \<open>ST\<^bsub>PS\<^esub> \<Longrightarrow> Trans M \<in> OT\<^bsub>B\<^esub>\<close>, proven by \<open>ST_PS.induct\<close> (the article's generation
  induction, article 6122), modulo the SINGLE clean value-identity hypothesis
  \<open>stepval\<close> (the §8.5 exchange EQUALITY).  This is an ARCHITECTURALLY SIMPLER
  reduction than @{thm [source] m_8_7_Trans_preserves_OT_modulo}: it needs NEITHER
  the 4-case keystone \<open>resid\<close> (R2 \<open>dstep\<close> + R3 \<open>newOT\<close>/\<open>gbt\<close>) NOR the multiT
  \<open>multiD\<close> junction — the whole OT pillar collapses to one \<open>Trans\<close>/\<open>oper\<close> value
  identity, with all OT/\<open>G\<^bsub>B\<^esub>\<close>/\<open>descP\<close> reasoning discharged by the [Buc1] closure
  transport (@{thm [source] m_8_7_Trans_OT_step_via_exchange}).
  \<^item> BASE (\<open>diag\<close>): \<open>Trans (diagSeq u v) \<in> OT\<^bsub>B\<^esub>\<close> is @{thm [source]
    m_8_7_Trans_preserves_OT_base} (\<open>diagSeq u v \<in> SkT\<^bsub>PS\<^esub> 0\<close> for \<open>u \<le> v\<close>).
  \<^item> STEP (\<open>oper\<close>): \<open>Trans (N[n]) \<in> OT\<^bsub>B\<^esub>\<close> from the IH \<open>Trans N \<in> OT\<^bsub>B\<^esub>\<close> +
    \<open>stepval\<close>, via @{thm [source] m_8_7_Trans_OT_step_via_exchange}.

  CAVEAT on \<open>stepval\<close> (honest scoping; python/_r16_e4_check.py + _r16_e4_condv_deep.py):
  the op0-tower identity is confirmed clean on genuine \<open>ST\<^bsub>PS\<^esub>\<close> for condV-adm
  (9/9, \<open>k=2\<close>), condI-adm, and condVI-nadm (\<open>k=0\<close>); for condIII-adm / condVI-adm a
  fraction did not fit the naive small \<open>(m,k)\<close> window and needs either a wider index
  or the A28-corrected \<open>m\<^sub>n\<close> — so \<open>stepval\<close> is the genuine remaining open content of
  the OT step, NOT a discharged fact.  This lemma isolates it as ONE hypothesis.\<close>

lemma m_8_7_Trans_preserves_OT_via_closure:
  fixes M :: pairseq
  assumes stepval:
    "\<And>N n. N \<in> ST_PS \<Longrightarrow> Trans N \<in> OT_B \<Longrightarrow> 1 \<le> n \<Longrightarrow>
        \<exists>m k. Trans ((N::pairseq)[n])
              = ((\<lambda>x. operB x (numBT 0))^^k) (operB (Trans N) (numBT m))"
    and MST: "M \<in> ST_PS"
  shows "Trans M \<in> OT_B"
  using MST
proof (induct M rule: ST_PS.induct)
  case (diag u v)
  have "diagSeq u v \<in> SkT_PS 0" using diag by auto
  thus ?case by (rule m_8_7_Trans_preserves_OT_base)
next
  case (oper N n)
  have val: "\<exists>m k. Trans ((N::pairseq)[n])
                   = ((\<lambda>x. operB x (numBT 0))^^k) (operB (Trans N) (numBT m))"
    by (rule stepval[OF oper.hyps(1) oper.hyps(2) oper.hyps(3)])
  show ?case by (rule m_8_7_Trans_OT_step_via_exchange[OF oper.hyps(2) val])
qed


(* ===== round 16b front E5 (wt2 178de9f): non-adm condV exchange + dispatcher condV ===== *)

(* ===== round 16b front E5: condition (V) NON-ADM exchange/descent ===== *)
section \<open>r16b-E5: 条件(V) — 非許容 \<open>j\<^sub>0\<close> の交換関係と降下性\<close>

text \<open>Front E5 attacks the NON-ADMISSIBLE condition-(V) branch of the
  \<open>Trans\<close>/fundamental-sequence exchange, proven REACHABLE by r16-E1
  (@{thm [source] m_8_5_Joints_FirstNodes_basic_condV}: genuine
  \<open>ST\<^bsub>PS\<^esub> \<inter> PT\<^bsub>PS\<^esub>\<close> members with \<open>transCondV M\<close> and \<open>\<not> adm M j\<^sub>0\<close> exist at
  \<open>Lng \<ge> 9\<close>).  EMPIRICAL MAP (python/_r16b_e5_nonadm.py, 21 genuine deep
  non-adm hosts, plus the dump python/_r16b_e5_dump.py /
  python/_r16b_e5_slices.py on the smallest witness
  \<open>M = (0,0)(1,1)(2,2)(3,1)(4,0)(5,1)(6,2)(7,0)(6,2)\<close>):
  writing \<open>u = M\<^bsub>1,j\<^sub>-\<^sub>1\<^esub>\<close> (\<open>= bpHeadV c\<^sub>1 = transV\<close>), \<open>e = M\<^bsub>1,j\<^sub>0\<^esub>\<close>,
  \<open>v\<^sub>1 = M\<^bsub>1,j\<^sub>1\<^esub>\<close> (condition (V): \<open>e + 1 = v\<^sub>1\<close>, and \<open>u \<le> e < v\<^sub>1\<close>),
  \<open>t\<^sub>2 = transT2 M\<close>, and the SHARED surgery pair \<open>(s\<^sub>1, b\<^sub>1)\<close> of
  @{thm [source] m_8_5_scbdec_fseq_condV}:
  \<^item> \<open>Trans M            = s\<^sub>1 \<cdot> D\<^sub>u(t\<^sub>2 + D\<^bsub>v\<^sub>1\<^esub> 0) \<cdot> b\<^sub>1\<close>  (= \<open>c\<^sub>2\<close>, head \<open>u\<close>);
  \<^item> \<open>Trans(M[1])        = s\<^sub>1 \<cdot> D\<^sub>u t\<^sub>2 \<cdot> b\<^sub>1\<close>                    (head \<open>u\<close>);
  \<^item> \<open>Trans(M[Suc k])     = s\<^sub>1 \<cdot> D\<^sub>u(bodyM t\<^sub>2 e k) \<cdot> b\<^sub>1\<close>, where
        \<open>bodyM t\<^sub>2 e 0 = t\<^sub>2\<close>, \<open>bodyM t\<^sub>2 e (Suc j) = t\<^sub>2 + W\<^sub>e\<^bsup>t\<^sub>2\<^esup>(t\<^sub>2, Suc j)\<close>
        (\<open>W = s85b_W\<close>, inner heads \<open>e\<close>, seed \<open>t\<^sub>2\<close>);
  \<^item> \<open>operB(Trans M)(numBT n) = s\<^sub>1 \<cdot> D\<^sub>u(bodyO t\<^sub>2 e n) \<cdot> b\<^sub>1\<close> (n \<ge> 1), where
        \<open>bodyO t\<^sub>2 e n = t\<^sub>2 + W\<^sub>e\<^bsup>t\<^sub>2\<^esup>(D\<^sub>e 0, n-1)\<close> (seed \<open>D\<^sub>e 0\<close>).
  The outer head is ALWAYS \<open>u = M\<^bsub>1,j\<^sub>-\<^sub>1\<^esub>\<close> (the article's head-rebase collapses in
  the adm case where \<open>j\<^sub>-\<^sub>1 = j\<^sub>0\<close> so \<open>u = e\<close>).  Consequences validated 100% over
  21 non-adm hosts:  descent (2) \<open>Trans(M[n]) < Trans M\<close> (all n), and exchange
  (1) at index \<open>n + 1\<close>: \<open>Trans(M[n]) < operB(Trans M)(numBT (n+1))\<close> STRICT
  (min-\<open>k\<close> is exactly \<open>n + 1\<close> for \<open>n \<ge> 2\<close>, \<open>1\<close> at \<open>n = 1\<close>; the printed
  adm-index \<open>n\<close> FAILS non-adm, 0/60 — a further A28-style shift).\<close>

subsection \<open>The tower inner bodies and the pure \<open>BT\<close>-order comparisons\<close>

text \<open>Inner body of the \<open>Trans(M[Suc k])\<close> core (below the outer \<open>D\<^sub>u\<close>): \<open>t\<close> at
  \<open>k = 0\<close>, and \<open>t + (s85b_W e t t (Suc j))\<close> at \<open>k = Suc j\<close>.\<close>

fun e5x_bodyM :: "BT \<Rightarrow> nat \<Rightarrow> nat \<Rightarrow> BT" where
  "e5x_bodyM t e 0 = t"
| "e5x_bodyM t e (Suc j) = t +\<^sub>B s85b_W e t t (Suc j)"

text \<open>Inner body of the \<open>operB(Trans M)(numBT n)\<close> core (n \<ge> 1): the same tower
  with seed \<open>D\<^sub>e 0\<close> at height \<open>n - 1\<close>.\<close>

definition e5x_bodyO :: "BT \<Rightarrow> nat \<Rightarrow> nat \<Rightarrow> BT" where
  "e5x_bodyO t e n = t +\<^sub>B s85b_W e t (Dpt (enat e) 0\<^sub>B) (n - 1)"

text \<open>A \<open>s85b_W\<close> tower with head \<open>u\<close> is strictly below any principal with a
  strictly larger head — the dictionary order decides at the first symbol.\<close>

lemma e5x_W_lt_Dpt:
  assumes uv: "u < v"
  shows "lessBT (s85b_W u t c k) (Dpt (enat v) d)"
proof -
  obtain b where b: "s85b_W u t c k = Dpt (enat u) b"
    using s85b_W_principal[of u t c k] by blast
  have "lessBP (DB (enat u) b) (DB (enat v) d)" using uv by simp
  thus ?thesis using b by simp
qed

text \<open>Seed-shift: raising the tower height by one more than compensates for
  shrinking the seed from \<open>t\<close> to \<open>D\<^sub>u 0\<close> — the \<open>operB\<close> body at height \<open>k+1\<close>
  strictly dominates the \<open>Trans(M[..])\<close> body at height \<open>k\<close>.  Pure \<open>BT\<close>-order,
  by induction on \<open>k\<close> (base = \<open>+\<close>-self, step = \<open>+\<close>-mono-right).\<close>

lemma e5x_W_seed_shift:
  "lessBT (s85b_W u t t k) (s85b_W u t (Dpt (enat u) 0\<^sub>B) (Suc k))"
proof (induction k)
  case 0
  have ne: "s85b_W u t (Dpt (enat u) 0\<^sub>B) 0 \<noteq> 0\<^sub>B" by simp
  have "lessBT t (t +\<^sub>B s85b_W u t (Dpt (enat u) 0\<^sub>B) 0)"
    by (rule lessBT_addBT_self[OF ne])
  thus ?case by simp
next
  case (Suc k)
  have "lessBT (t +\<^sub>B s85b_W u t t k) (t +\<^sub>B s85b_W u t (Dpt (enat u) 0\<^sub>B) (Suc k))"
    by (rule lessBT_addBT_mono_right[OF Suc.IH])
  thus ?case by simp
qed

text \<open>The two core comparisons at the shared outer head \<open>u\<close>, packaged as
  \<open>lessBP\<close> facts on the \<open>D\<^sub>u\<close>-wrapped bodies.\<close>

lemma e5x_bodyM_lt_c2:
  assumes ev: "e < v"
  shows "lessBP (DB (enat u) (e5x_bodyM t e k))
                (DB (enat u) (t +\<^sub>B Dpt (enat v) 0\<^sub>B))"
proof (cases k)
  case 0
  have ne: "Dpt (enat v) 0\<^sub>B \<noteq> 0\<^sub>B" by simp
  have "lessBT t (t +\<^sub>B Dpt (enat v) 0\<^sub>B)" by (rule lessBT_addBT_self[OF ne])
  thus ?thesis using 0 by simp
next
  case (Suc j)
  have wlt: "lessBT (s85b_W e t t (Suc j)) (Dpt (enat v) 0\<^sub>B)"
    by (rule e5x_W_lt_Dpt[OF ev])
  have "lessBT (t +\<^sub>B s85b_W e t t (Suc j)) (t +\<^sub>B Dpt (enat v) 0\<^sub>B)"
    by (rule lessBT_addBT_mono_right[OF wlt])
  thus ?thesis using Suc by simp
qed

lemma e5x_bodyM_lt_bodyO:
  shows "lessBP (DB (enat u) (e5x_bodyM t e k))
                (DB (enat u) (e5x_bodyO t e (Suc (Suc k))))"
proof (cases k)
  case 0
  have ne: "s85b_W e t (Dpt (enat e) 0\<^sub>B) (Suc 0) \<noteq> 0\<^sub>B" by simp
  have "lessBT t (t +\<^sub>B s85b_W e t (Dpt (enat e) 0\<^sub>B) (Suc 0))"
    by (rule lessBT_addBT_self[OF ne])
  thus ?thesis using 0 by (simp add: e5x_bodyO_def)
next
  case (Suc j)
  have wlt: "lessBT (s85b_W e t t (Suc j))
                    (s85b_W e t (Dpt (enat e) 0\<^sub>B) (Suc (Suc j)))"
    by (rule e5x_W_seed_shift)
  have "lessBT (t +\<^sub>B s85b_W e t t (Suc j))
               (t +\<^sub>B s85b_W e t (Dpt (enat e) 0\<^sub>B) (Suc (Suc j)))"
    by (rule lessBT_addBT_mono_right[OF wlt])
  thus ?thesis using Suc by (simp add: e5x_bodyO_def)
qed

subsection \<open>非許容 (V) の交換関係 (1) と降下性 (2)（tower閉形式を仮定して）\<close>

text \<open>命題（条件(V)の下での\<open>Trans\<close>と基本列の交換関係）, NON-ADMISSIBLE branch.
  Reduced to the SINGLE named hypothesis \<open>NF\<close> — the non-adm analogue of the
  \<open>mM\<close> conjunct of @{thm [source] m_8_5_scbdec_adm_forms} together with the
  \<open>operB\<close> value form (@{thm [source] m_8_5_scbdec_oper_general_condV_adm} in the
  adm case): the \<open>Trans(M[Suc k])\<close> and \<open>operB(Trans M)(numBT m)\<close> flat strings
  factor at the SHARED surgery pair \<open>(s\<^sub>1,b\<^sub>1)\<close> (the one
  @{thm [source] m_8_5_scbdec_fseq_condV} produces — pinned here by the base
  decomposition of \<open>Trans(M[1])\<close> at \<open>D\<^sub>u t\<^sub>2\<close> and the kind-1 decomposition of
  \<open>Trans M\<close> at \<open>c\<^sub>2\<close>) with cores \<open>D\<^sub>u(e5x_bodyM t\<^sub>2 e k)\<close> and \<open>D\<^sub>u(e5x_bodyO t\<^sub>2 e m)\<close>.
  From it, exchange (1) at the CORRECTED non-adm index \<open>n + 1\<close> (STRICT) and
  descent (2) follow by the pure comparisons above and 部分表現の不等式の延長性
  (@{thm [source] scbext_lessBT}).  \<open>NF\<close> is faithful: its \<open>k = 0\<close> instance is
  \<open>d1\<close> itself, and it is the exact shape the (non-adm) tower induction produces
  — empirically 100% over 21 genuine deep hosts (python/_r16b_e5_nonadm.py).\<close>

lemma m_8_5_Trans_oper_exchange_condV_nonadm:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and cond: "transCondV M"
    and nadm: "\<not> adm M (parent M 0 (Lng M - 1))"
    and n1: "1 \<le> n"
    and NF: "\<And>s\<^sub>1 b\<^sub>1.
        scb_decomp (Trans (M[1])) s\<^sub>1
          (flatBT (Dpt (enat (entry M 1 (transJm1 M))) (transT2 M))) b\<^sub>1
      \<Longrightarrow> scb_kind1 (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1
      \<Longrightarrow> (\<forall>k. flatBT (Trans (M[Suc k]))
                = s\<^sub>1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
                    (e5x_bodyM (transT2 M) (entry M 1 (transJ0 M)) k)) @ b\<^sub>1)
        \<and> (\<forall>m. 1 \<le> m \<longrightarrow> flatBT (operB (Trans M) (numBT m))
                = s\<^sub>1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
                    (e5x_bodyO (transT2 M) (entry M 1 (transJ0 M)) m)) @ b\<^sub>1)"
  shows "lessBT (Trans (M[n])) (operB (Trans M) (numBT (n + 1)))"
    and "lessBT (Trans (M[n])) (Trans M)"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  note J1pos = s85b_condV_setup(1)[OF MR MP cond]
  note T1 = s85b_condV_setup(2)[OF MR MP cond]
  note shape = m_8_5_scbdec_c1_shape[OF MR MP J1pos T1]
  \<comment> \<open>the shared surgery pair from @{thm m_8_5_scbdec_fseq_condV}\<close>
  obtain s0 s1 b0 b1 where
      d1: "scb_decomp (Trans (M[1])) s1
             (flatBT (Dpt (enat (entry M 1 (transJm1 M))) (transT2 M))) b1"
    and k1: "scb_kind1 (Trans M) s1 (flatBT (transC2 M)) b1"
    using m_8_5_scbdec_fseq_condV[OF MR MP J1pos T1 cond] by blast
  note forms = NF[OF d1 k1]
  have Mform: "\<And>k. flatBT (Trans (M[Suc k]))
        = s1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
            (e5x_bodyM (transT2 M) (entry M 1 (transJ0 M)) k)) @ b1"
    using forms by blast
  have Oform: "\<And>m. 1 \<le> m \<Longrightarrow> flatBT (operB (Trans M) (numBT m))
        = s1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
            (e5x_bodyO (transT2 M) (entry M 1 (transJ0 M)) m)) @ b1"
    using forms by blast
  \<comment> \<open>the \<open>Trans M\<close> core is \<open>c\<^sub>2 = D\<^sub>u(t\<^sub>2 + D\<^bsub>v\<^sub>1\<^esub> 0)\<close>\<close>
  have c2eq: "transC2 M = Dpt (enat (entry M 1 (transJm1 M)))
                (transT2 M +\<^sub>B Dpt (enat (entry M 1 (transJ1 M))) 0\<^sub>B)"
    using m_8_5_transC2_condV[OF cond] shape(1) by (simp add: transJ1_def)
  have dTM: "scb_decomp (Trans M) s1 (flatBT (transC2 M)) b1"
    using k1 by (simp add: scb_kind1_def)
  have fTM: "flatBT (Trans M)
        = s1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
            (transT2 M +\<^sub>B Dpt (enat (entry M 1 (transJ1 M))) 0\<^sub>B)) @ b1"
    using dTM c2eq by (simp add: scb_decomp_def)
  have bRP: "\<forall>x \<in> set b1. x = RP" using d1 by (simp add: scb_decomp_def)
  have ev: "entry M 1 (transJ0 M) < entry M 1 (transJ1 M)"
    using cond unfolding transCondV_def transJ0_def transJ1_def by arith
  obtain k where nk: "n = Suc k" using n1 by (cases n) auto
  have fMn: "flatBT (Trans (M[n]))
        = s1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
            (e5x_bodyM (transT2 M) (entry M 1 (transJ0 M)) k)) @ b1"
    using Mform nk by simp
  \<comment> \<open>descent (2)\<close>
  have coreLt2: "lessBP (DB (enat (entry M 1 (transJm1 M)))
                          (e5x_bodyM (transT2 M) (entry M 1 (transJ0 M)) k))
                        (DB (enat (entry M 1 (transJm1 M)))
                          (transT2 M +\<^sub>B Dpt (enat (entry M 1 (transJ1 M))) 0\<^sub>B))"
    by (rule e5x_bodyM_lt_c2[OF ev])
  show "lessBT (Trans (M[n])) (Trans M)"
    by (rule scbext_lessBT[OF fMn fTM bRP coreLt2])
  \<comment> \<open>exchange (1) at index \<open>n + 1\<close>\<close>
  have n1le: "1 \<le> n + 1" by simp
  have fOn1: "flatBT (operB (Trans M) (numBT (n + 1)))
        = s1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
            (e5x_bodyO (transT2 M) (entry M 1 (transJ0 M)) (n + 1))) @ b1"
    using Oform[OF n1le] .
  have idx: "n + 1 = Suc (Suc k)" using nk by simp
  have fOn1': "flatBT (operB (Trans M) (numBT (n + 1)))
        = s1 @ flatBP (DB (enat (entry M 1 (transJm1 M)))
            (e5x_bodyO (transT2 M) (entry M 1 (transJ0 M)) (Suc (Suc k)))) @ b1"
    using fOn1 idx by simp
  have coreLt1: "lessBP (DB (enat (entry M 1 (transJm1 M)))
                          (e5x_bodyM (transT2 M) (entry M 1 (transJ0 M)) k))
                        (DB (enat (entry M 1 (transJm1 M)))
                          (e5x_bodyO (transT2 M) (entry M 1 (transJ0 M)) (Suc (Suc k))))"
    by (rule e5x_bodyM_lt_bodyO)
  show "lessBT (Trans (M[n])) (operB (Trans M) (numBT (n + 1)))"
    by (rule scbext_lessBT[OF fMn fOn1' bRP coreLt1])
qed

subsection \<open>Dispatcher: the condition-(V) branch FULLY closed modulo the tower forms\<close>

text \<open>The §8.7 fundamental-sequence-descent dispatcher with BOTH condition-(V)
  sub-branches discharged: the ADM branch unconditionally (via the r16-E1
  triple @{thm [source] m_8_5_Trans_oper_exchange_condV_adm_uncond}, inside
  @{thm [source] m_8_7_fseq_descend_dispatcher_admV}), and the NON-ADM branch
  via @{thm [source] m_8_5_Trans_oper_exchange_condV_nonadm} — reducing the whole
  condition-(V) leg to the single universally-quantified non-adm tower-forms
  hypothesis \<open>NFall\<close> (the ONLY remaining condition-(V) residual, empirically
  100% over the genuine deep regime).  Every other hypothesis is verbatim
  @{thm [source] m_8_7_fseq_descend_dispatcher_admV}, EXCEPT \<open>exchVn\<close> is now
  DERIVED (witness \<open>k = m + 1\<close>, strict) rather than assumed.\<close>

lemma m_8_7_fseq_descend_dispatcher_condV:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS"
    and n1: "1 \<le> n" and L: "1 < Lng M"
    and TOT: "\<And>N. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow> Trans N \<in> OT_B"
    and exchI: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondI N \<Longrightarrow> 0 < parent N 0 (Lng N - 1) \<Longrightarrow> 1 < m \<Longrightarrow>
                  Trans ((N::pairseq)[m]) = operB (Trans N) (numBT (m - 1))"
    and exchII: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondII N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. Trans ((N::pairseq)[m]) = operB (Trans N) (numBT k)"
    and exchIII: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIII N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchIV: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIV N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and NFall: "\<And>N s\<^sub>1 b\<^sub>1. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> transCondV N \<Longrightarrow>
                  \<not> adm N (parent N 0 (Lng N - 1)) \<Longrightarrow>
                  scb_decomp (Trans (N[1])) s\<^sub>1
                    (flatBT (Dpt (enat (entry N 1 (transJm1 N))) (transT2 N))) b\<^sub>1 \<Longrightarrow>
                  scb_kind1 (Trans N) s\<^sub>1 (flatBT (transC2 N)) b\<^sub>1 \<Longrightarrow>
                  (\<forall>k. flatBT (Trans (N[Suc k]))
                        = s\<^sub>1 @ flatBP (DB (enat (entry N 1 (transJm1 N)))
                            (e5x_bodyM (transT2 N) (entry N 1 (transJ0 N)) k)) @ b\<^sub>1)
                  \<and> (\<forall>mm. 1 \<le> mm \<longrightarrow> flatBT (operB (Trans N) (numBT mm))
                        = s\<^sub>1 @ flatBP (DB (enat (entry N 1 (transJm1 N)))
                            (e5x_bodyO (transT2 N) (entry N 1 (transJ0 N)) mm)) @ b\<^sub>1)"
    and exchVI: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondVI N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  have exchVn: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondV N \<Longrightarrow> \<not> adm N (parent N 0 (Lng N - 1)) \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
  proof -
    fix N :: pairseq and m :: nat
    assume NST: "N \<in> ST_PS" and NP: "N \<in> PT_PS" and j1gt: "1 < Lng N - 1"
      and cV: "transCondV N" and nadmN: "\<not> adm N (parent N 0 (Lng N - 1))"
      and m2: "1 < m"
    have m1: "1 \<le> m" using m2 by linarith
    have "lessBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT (m + 1)))"
      by (rule m_8_5_Trans_oper_exchange_condV_nonadm(1)
            [OF NST NP cV nadmN m1 NFall[OF NST NP cV nadmN]])
    hence "leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT (m + 1)))" by simp
    thus "\<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))" by blast
  qed
  show ?thesis
    by (rule m_8_7_fseq_descend_dispatcher_admV[OF MST n1 L TOT exchI exchII
          exchIII exchIV exchVn exchVI])
qed



(* ===== round 17 front FPEEL (wt2 be2ab28): VE reduced to FPEEL_STEP + scaffold ===== *)
(* ===== round 17 front FPEEL (wt2, Opus): front-peel reduction of VE' ===== *)

section \<open>§8.2 round-17 front FPEEL — VE' reduced + slice-peel infrastructure\<close>

text \<open>Round-16b collapsed the §8 endgame onto ONE object: the deep-tail
  equality \<open>VE'(m): bpHeadT (Trans (seg M m j\<^sub>1)) = bpHeadT (Trans M)\<close> for the
  terminal slice family \<open>M' = seg M m j\<^sub>1\<close> (\<open>m \<le> j'\<^sub>0\<close>), which is the last
  hypothesis of @{thm [source] m_8_2_condV_terminal_slice_Trans_modVE}.  The
  ADM topmost slice is pinned by @{thm [source] m_8_5_scbdec_adm_forms}; the
  article generalizes by a front-peel / \<open>Pred\<close> simultaneous induction whose
  proof text was dropped from the extraction.

  This block delivers the tractable setup, leaving the ONE hard inductive core
  as a single sharp named hypothesis \<open>FPEEL_STEP\<close> for a later Fable+xhigh round:

  * @{text fpx_seg0_self}: the trivial front-peel base \<open>seg M 0 j\<^sub>1 = M\<close>.
  * @{text fpx_slice_principal}: every terminal slice is principal with leftmost
    head value \<open>M\<^bsub>1,m\<^esub>\<close> (so \<open>FPEEL_STEP\<close> becomes a pure statement about deep
    tails).  This is the peel-step infrastructure.
  * @{text fpx_VE_reduction}: the UNCONDITIONAL telescoping
    \<open>(\<forall>i<m. bpHeadT(Trans(seg M i j\<^sub>1)) = bpHeadT(Trans(seg M (i+1) j\<^sub>1)))
       \<Longrightarrow> VE'(m)\<close>, base \<open>m = 0\<close> discharged by @{text fpx_seg0_self}.
  * @{text fpx_terminal_slice_Trans_modStep}: feeds \<open>VE'\<close> into
    @{thm [source] m_8_2_condV_terminal_slice_Trans_modVE}, so the whole
    terminal-slice lemma is GREEN modulo the single front-peel step.

  EMPIRICAL (python/_r17_fpeel_map.py): \<open>VE'\<close> 1386/1386 (WIDE) + 68/68 (GENUINE,
  16/16 at Lng \<ge> 9); the slice-principal head 5712/5712; \<open>seg M 0 j\<^sub>1 = M\<close>
  4822/4822.  NOTE (honest): the *unrestricted* per-\<open>i\<close> tail-preservation step
  \<open>bpHeadT(Trans(seg M i j\<^sub>1)) = bpHeadT(Trans(seg M (i+1) j\<^sub>1))\<close> is FALSE at the
  boundary \<open>i = j'\<^sub>0 - 1\<close> (crossing out of the \<open>hyp\<close>-covered trunk); it is TRUE
  exactly in the domain \<open>i < m \<le> j'\<^sub>0\<close> demanded by \<open>fpx_VE_reduction\<close>, where it
  is the article's \<open>Pred\<close>-simultaneous step.  The clean *local* peel identity is
  \<open>Trans(seg M (i+1) j\<^sub>1) = bpHeadT(Trans(seg M i j\<^sub>1))\<close> (see the map file).\<close>

text \<open>The front-peel base: the full terminal slice \<open>seg M 0 (Lng M - 1)\<close> is \<open>M\<close>.\<close>

lemma fpx_seg0_self:
  assumes Mne: "M \<noteq> []"
  shows "seg M 0 (Lng M - 1) = M"
proof -
  have L: "0 < Lng M" using Mne by (cases M) auto
  have "seg M 0 (Lng M - 1) = take (Suc (Lng M - 1)) M"
    using L by (intro seg_0_eq_take) simp
  also have "\<dots> = take (Lng M) M" using L by simp
  also have "\<dots> = M" by simp
  finally show ?thesis .
qed

text \<open>Peel-step infrastructure: every terminal slice \<open>seg M m j\<^sub>1\<close> (\<open>m < j\<^sub>1\<close>,
  \<open>m \<le> j'\<^sub>0\<close>) is a reduced monoT sequence, hence its \<open>Trans\<close> is PRINCIPAL with
  leftmost head value \<open>M\<^bsub>1,m\<^esub>\<close>.  Reproduces the internal derivation of
  @{thm [source] m_8_2_condV_terminal_slice_Trans_modVE} for a general offset,
  reducing any front-peel comparison to a statement about the deep tails.\<close>

lemma fpx_slice_principal:
  fixes M :: pairseq and m :: nat
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS"
    and mj1: "m < Lng M - 1"
    and mj0: "m \<le> Joints M ! (Lng (Br M) - 1)"
  shows "Trans (seg M m (Lng M - 1))
         = Dpt (enat (entry M 1 m)) (bpHeadT (Trans (seg M m (Lng M - 1))))"
proof -
  let ?j1 = "Lng M - 1"
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have j1LM: "?j1 \<le> Lng M - 1" by simp
  have j1ltLM: "?j1 < Lng M" using mj1 by linarith
  have mlej1: "m \<le> ?j1" using mj1 by linarith
  have monoSeg: "monoT (seg M m ?j1)"
    by (rule m_6_4_mono_slice[OF MP mj1 j1LM mj0])
  have segne: "seg M m ?j1 \<noteq> []" using mj1 by (simp add: seg_def)
  have segT: "seg M m ?j1 \<in> T_PS" using segne by (simp add: T_PS_def)
  have segPT: "seg M m ?j1 \<in> PT_PS" using segT monoSeg by (simp add: PT_PS_def)
  have le0mj1: "le0 M m ?j1"
    by (rule le0_monoT_seg_into_list[OF MT monoSeg mlej1 order.refl j1ltLM])
  have leMmj1: "leR M 0 m ?j1" using le0mj1 by (simp add: leR_def)
  define N where "N = Red (seg M m ?j1)"
  have NR: "N \<in> RT_PS"
    using slice_Red_in_RT_PS[OF MR mj1 j1LM leMmj1] by (simp add: N_def)
  have monoN: "monoT N"
    using m_6_5_Red_preserves_monoT[OF segPT] by (simp add: N_def)
  have TMp: "Trans (seg M m ?j1) = Trans N"
    using m_7_3_Trans_Red[OF NR[unfolded N_def]] by (simp add: N_def)
  have LNpos: "0 < Lng N"
  proof -
    have "Lng N = Lng (seg M m ?j1)"
      using m_6_5_Lng_Red[OF segT] by (simp add: N_def)
    also have "\<dots> = Suc ?j1 - m" by (simp add: Lng_seg)
    finally show ?thesis using mj1 by linarith
  qed
  have headN: "entry N 1 0 = entry M 1 m"
    using repr_entry1_shift_gen[OF MR mj1 j1LM leMmj1 LNpos[unfolded N_def]]
    by (simp add: N_def)
  have princN: "Trans N = Dpt (enat (entry N 1 0)) (bpHeadT (Trans N))"
    by (rule e2x_Trans_principal_head[OF NR monoN])
  show ?thesis using princN headN TMp by simp
qed

text \<open>The telescoping reduction (UNCONDITIONAL): if a single front-peel preserves
  the \<open>Trans\<close> deep tail at every offset below \<open>m\<close>, then the deep tail of the
  terminal slice \<open>seg M m j\<^sub>1\<close> equals that of \<open>M\<close> — i.e. \<open>VE'(m)\<close>.  Base \<open>m = 0\<close>
  is @{thm [source] fpx_seg0_self}; the whole content of \<open>VE'\<close> lives in the
  single step hypothesis.\<close>

lemma fpx_VE_reduction:
  fixes M :: pairseq and m :: nat
  assumes Mne: "M \<noteq> []"
    and step: "\<And>i. i < m \<Longrightarrow>
        bpHeadT (Trans (seg M i (Lng M - 1)))
      = bpHeadT (Trans (seg M (Suc i) (Lng M - 1)))"
  shows "bpHeadT (Trans (seg M m (Lng M - 1))) = bpHeadT (Trans M)"
proof -
  have seg0: "seg M 0 (Lng M - 1) = M" by (rule fpx_seg0_self[OF Mne])
  have tel: "k \<le> m \<Longrightarrow>
      bpHeadT (Trans (seg M k (Lng M - 1))) = bpHeadT (Trans M)" for k
  proof (induction k)
    case 0
    show ?case using seg0 by simp
  next
    case (Suc k)
    have km: "k < m" using Suc.prems by simp
    have "bpHeadT (Trans (seg M (Suc k) (Lng M - 1)))
          = bpHeadT (Trans (seg M k (Lng M - 1)))"
      using step[OF km] by simp
    also have "\<dots> = bpHeadT (Trans M)"
      using Suc.IH[OF less_imp_le[OF km]] .
    finally show ?case .
  qed
  show ?thesis by (rule tel[OF order.refl])
qed

text \<open>The terminal-slice lemma, GREEN modulo the single front-peel step
  \<open>FPEEL_STEP\<close> (the reserved hard inductive core).  Feeds \<open>VE'\<close> — obtained from
  \<open>FPEEL_STEP\<close> by @{thm [source] fpx_VE_reduction} — into
  @{thm [source] m_8_2_condV_terminal_slice_Trans_modVE}.  Hypotheses (\<open>defines\<close>,
  \<open>MR\<close>, \<open>MP\<close>, \<open>Brne\<close>, \<open>hyp\<close>) are verbatim those of the target lemma
  \<open>p_8_2_condV_terminal_slice_Trans\<close>.\<close>

lemma fpx_terminal_slice_Trans_modStep:
  fixes M :: pairseq and m :: nat
  defines "j1 \<equiv> Lng M - 1"
  defines "J1 \<equiv> Lng (Br M) - 1"
  defines "j0' \<equiv> Joints M ! J1"
  defines "j1' \<equiv> FirstNodes M ! J1"
  defines "M' \<equiv> seg M m j1"
  assumes MR: "M \<in> RT_PS" and MP: "M \<in> PT_PS" and Brne: "Br M \<noteq> []"
    and hyp: "m < j0' \<or> (m = j0' \<and> entry M 0 j1' = entry M 1 j1'
                          \<and> descending (Br M))"
    and FPEEL_STEP: "\<And>i. i < m \<Longrightarrow>
        bpHeadT (Trans (seg M i (Lng M - 1)))
      = bpHeadT (Trans (seg M (Suc i) (Lng M - 1)))"
  shows "\<exists>!t1. Trans M = Dpt (enat (entry M 1 0)) t1
            \<and> Trans M' = Dpt (enat (entry M 1 m)) t1"
proof -
  have Mne: "M \<noteq> []" using MR by (simp add: RT_PS_def T_PS_def)
  have VE: "bpHeadT (Trans M') = bpHeadT (Trans M)"
    unfolding M'_def j1_def by (rule fpx_VE_reduction[OF Mne FPEEL_STEP])
  show ?thesis
    unfolding j1_def J1_def j0'_def j1'_def M'_def
    by (rule m_8_2_condV_terminal_slice_Trans_modVE[OF MR MP Brne
          hyp[unfolded j1_def J1_def j0'_def j1'_def]
          VE[unfolded M'_def j1_def]])
qed



(* ===== round 17 front DII (wt-s5 5069466): condII descent ===== *)
(* ==================== round 17 front DII (wt-s5): §8.3 condition-(II) DESCENT ==================== *)
section \<open>r17-DII — §8.3 命題（条件(II)の下での\<open>Trans\<close>と基本列の交換関係） conclusion (2),
  the condition-(II) DESCENT \<open>Trans(M[n]) < Trans M\<close> (kind-0), OT-pillar-free\<close>

text \<open>Target: @{thm [source] p_8_3_TransCondII_oper_descend} conclusion (2)
  (\<open>lessBT (Trans(M[n])) (Trans M)\<close>) for the condition-(II) regime, delivered
  UNCONDITIONALLY modulo the kind-0 LHS marking-nesting closed form
  (\<open>lhs\<close>) and the condition-(II) marked-principal scb-decomposition of \<open>Trans M\<close>
  (\<open>dM\<close>) — exactly the residuals of @{thm [source] m_8_3_exch_of_lhs_closed}.  This
  mirrors the DONE condition-(V) descent @{thm [source] m_8_5_scbdec_exchange2_condV_adm}
  and the r16b condition-(III) descent @{thm [source] e3x_exchange2_condIII}, and
  like them AVOIDS the \<open>Trans M \<in> OT\<^bsub>B\<^esub>\<close> pillar (\<open>TOT\<close>): instead of routing
  \<open>Trans(M[n]) = operB (Trans M) (numBT k) < Trans M\<close> through [Buc1] Lemma 3.2(a),
  it compares the two flat strings directly via 部分表現の不等式の延長性
  (@{thm [source] scbext_lessBT}).

  Condition (II) is KIND-0 (\<open>M\<^bsub>1,j\<^sub>1\<^esub> = 0\<close>): the marked principal is
  \<open>c\<^sub>2 = D\<^bsub>u\<^esub>(t\<^sub>0 + D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0))\<close> and the fundamental-sequence body simply replicates
  the block letter \<open>D\<^bsub>v\<^esub> t\<^sub>1\<close> — there is NO deep two-letter tower (contrast the kind-1
  \<open>s85b_W\<close> / \<open>e3x_H\<close>): \<open>Trans(M[n]) = s D\<^bsub>u\<^esub>(t\<^sub>0 + (D\<^bsub>v\<^esub> t\<^sub>1)\<^bsup>n-1\<^esup>) b\<close>.  Since the leading
  principal of \<open>(D\<^bsub>v\<^esub> t\<^sub>1)\<^bsup>n-1\<^esup>\<close> is \<open>D\<^bsub>v\<^esub> t\<^sub>1 < D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0)\<close> (same head \<open>v\<close>,
  strictly smaller body), the whole replicate string is \<open><\<close> the single top principal
  \<open>D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0)\<close> — the KIND-0 branch comparison.  Empirically (\<open>python/_r17_d2_condII.py\<close>):
  the descent holds on every genuine condition-(II) host (wide mine, \<open>Lng \<ge> 9\<close> included),
  and the printed fundamental-sequence index is EXACT (r15-VX 204/204, no A28-shift),
  matching @{thm [source] m_8_3_exch_of_lhs_closed}'s \<open>m\<^sub>n = n-2\<close>.  Prefix \<open>d2x_\<close>.\<close>

subsection \<open>The kind-0 replicate helpers \<open>d2x_multBT_*\<close>\<close>

text \<open>\<open>a\<cdot>k = a\<^bsup>k\<^esup>\<close> for a single-principal \<open>a = Trm [p]\<close>: the flat replicate.\<close>

lemma d2x_multBT_replicate:
  "multBT (Trm [p]) k = Trm (replicate k p)"
  by (induction k) (simp_all add: replicate_append_same)

text \<open>The KIND-0 branch comparison: for \<open>k \<ge> 1\<close>, the replicate \<open>(D\<^bsub>v\<^esub> t\<^sub>1)\<^bsup>k\<^esup>\<close> is
  strictly below the single top principal \<open>D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0)\<close>.  The leading principal
  \<open>D\<^bsub>v\<^esub> t\<^sub>1\<close> is \<open>< D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0)\<close> (equal head \<open>v\<close>, body \<open>t\<^sub>1 < t\<^sub>1 + D\<^sub>0 0\<close> by
  @{thm [source] lessBT_addBT_self}), and a strictly-smaller first component decides
  the \<open>BT\<close> order regardless of the tail.  Pure \<open>BT\<close>-order fact.\<close>

lemma d2x_multBT_lt_top:
  fixes v k :: nat and t\<^sub>1 :: BT
  assumes k1: "1 \<le> k"
  shows "lessBT (multBT (Dpt (enat v) t\<^sub>1) k) (Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B))"
proof -
  obtain j where kj: "k = Suc j" using k1 by (cases k) auto
  have mform: "multBT (Dpt (enat v) t\<^sub>1) k = Trm (replicate k (DB (enat v) t\<^sub>1))"
    by (simp add: d2x_multBT_replicate)
  have krep: "replicate k (DB (enat v) t\<^sub>1)
            = DB (enat v) t\<^sub>1 # replicate j (DB (enat v) t\<^sub>1)"
    using kj by simp
  have body_lt: "lessBT t\<^sub>1 (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B)"
    by (rule lessBT_addBT_self[of "Dpt 0 0\<^sub>B" t\<^sub>1]) simp
  have hd_lt: "lessBP (DB (enat v) t\<^sub>1) (DB (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B))"
    using body_lt by simp
  have core: "lessBT (Trm (DB (enat v) t\<^sub>1 # replicate j (DB (enat v) t\<^sub>1)))
                     (Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B))"
    using hd_lt by simp
  show ?thesis
    using core mform krep by simp
qed

subsection \<open>The condition-(II) descent \<open>d2x_exchange2_condII\<close>\<close>

text \<open>命題（条件(II)の下での\<open>Trans\<close>と基本列の交換関係） conclusion (2), condition-(II)
  regime, for every \<open>n \<ge> 1\<close>, modulo the kind-0 residuals \<open>t\<^sub>0/t\<^sub>1/tT/dM/lhs\<close> spelled
  exactly as in @{thm [source] m_8_3_exch_of_lhs_closed}.  The \<open>n = 1\<close> leaf is the
  proven \<open>Pred\<close>-descent (@{thm [source] m_8_3_TransCondII_oper1_descend}); the
  \<open>n > 1\<close> branch reads \<open>Trans(M[n])\<close> back through the marked-principal scb-value
  (@{thm [source] operB_marked_scb_value} / @{thm [source] m_7_2_scb_fseq_scb}) as
  \<open>s D\<^bsub>u\<^esub>(t\<^sub>0 + (D\<^bsub>v\<^esub> t\<^sub>1)\<^bsup>n-1\<^esup>) b\<close>, compares core-to-core against
  \<open>Trans M = s D\<^bsub>u\<^esub>(t\<^sub>0 + D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0)) b\<close> (\<open>dM\<close>) with the kind-0 branch bound
  @{thm [source] d2x_multBT_lt_top}, and closes by @{thm [source] scbext_lessBT}.
  Audit (agent-workflow rule 4): cites only proven facts (\<open>m_8_3_*\<close>,
  \<open>operB_marked_scb_value\<close>, \<open>m_7_2_scb_fseq_scb\<close>, \<open>scbext_lessBT\<close>, \<open>lessBT_addBT_*\<close>);
  no circular use of \<open>p_8_3_*\<close> nor of any \<open>sorry\<close>-\<open>p_*\<close> fact.\<close>

lemma d2x_exchange2_condII:
  fixes M :: pairseq and u v :: nat and n :: nat
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and j1: "Lng M - 1 > 1" and cond: "transCondII M"
    and t0: "t\<^sub>0 \<in> T_B" and t1: "t\<^sub>1 \<in> T_B" and tT: "Trans M \<in> T_B"
    and dM: "scb_decomp (Trans M) s
               (flatBT (Dpt (enat u) (t\<^sub>0 +\<^sub>B Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B)))) b"
    and lhs: "\<And>m. 1 < m \<Longrightarrow> Trans (M[m])
                = unflatBT (s @ flatBT (Dpt (enat u)
                       (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (m - 1))) @ b)"
    and n1: "1 \<le> n"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  consider (one) "n = 1" | (big) "1 < n" using n1 by linarith
  then show ?thesis
  proof cases
    case one
    have "lessBT (Trans ((M::pairseq)[1])) (Trans M)"
      by (rule m_8_3_TransCondII_oper1_descend[OF MST MP j1 cond])
    thus ?thesis using one by simp
  next
    case big
    \<comment> \<open>\<open>n = Suc (Suc k)\<close>, so \<open>n - 1 = Suc k\<close> and the fundamental-sequence body
       replicates the block letter \<open>Suc k\<close> times\<close>
    obtain m0 where nm: "n = Suc m0" using big by (cases n) auto
    have m0pos: "0 < m0" using big nm by simp
    obtain k where mk: "m0 = Suc k" using m0pos by (cases m0) auto
    have nk: "n = Suc (Suc k)" using nm mk by simp
    have n1': "1 < n" using nk by simp
    \<comment> \<open>\<open>Trans(M[n]) = operB (Trans M) (numBT k)\<close> (both equal the same unflat string)\<close>
    have lhsN: "Trans ((M::pairseq)[n])
          = unflatBT (s @ flatBT (Dpt (enat u)
                 (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k))) @ b)"
      using lhs[OF n1'] nk by simp
    have rhsK: "operB (Trans M) (numBT k)
          = unflatBT (s @ flatBT (Dpt (enat u)
                 (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k))) @ b)"
      using operB_marked_scb_value[OF t0 t1 tT dM, of k] by simp
    have exch_eq: "Trans ((M::pairseq)[n]) = operB (Trans M) (numBT k)"
      using lhsN rhsK by simp
    \<comment> \<open>scb-value of the RHS \<open>operB\<close> step, read as the two flat strings\<close>
    have dOp: "scb_decomp (operB (Trans M) (numBT k)) s
                 (flatBT (Dpt (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k)))) b"
      using m_7_2_scb_fseq_scb[OF t0 t1 tT dM, of k] by simp
    have fOp: "flatBT (operB (Trans M) (numBT k))
          = s @ flatBP (DB (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k))) @ b"
      using dOp by (simp add: scb_decomp_def)
    have fMn: "flatBT (Trans ((M::pairseq)[n]))
          = s @ flatBP (DB (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k))) @ b"
      using fOp exch_eq by simp
    have fTM: "flatBT (Trans M)
          = s @ flatBP (DB (enat u) (t\<^sub>0 +\<^sub>B Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B))) @ b"
      using dM by (simp add: scb_decomp_def)
    have bRP: "\<forall>x \<in> set b. x = RP" using dM by (simp add: scb_decomp_def)
    \<comment> \<open>the kind-0 core comparison, lifted through the shared prefix \<open>t\<^sub>0\<close> and head \<open>u\<close>\<close>
    have topLt: "lessBT (multBT (Dpt (enat v) t\<^sub>1) (Suc k))
                        (Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B))"
      by (rule d2x_multBT_lt_top) simp
    have bodyLt: "lessBT (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k))
                         (t\<^sub>0 +\<^sub>B Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B))"
      by (rule lessBT_addBT_mono_right[OF topLt])
    have coreLt: "lessBP (DB (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (Suc k)))
                         (DB (enat u) (t\<^sub>0 +\<^sub>B Dpt (enat v) (t\<^sub>1 +\<^sub>B Dpt 0 0\<^sub>B)))"
      using bodyLt by simp
    show ?thesis by (rule scbext_lessBT[OF fMn fTM bRP coreLt])
  qed
qed


(* ===== round 17 front DVI (wt-s4b 076869e): condVI descent ===== *)
(* ===== round 17 front DVI (wt-s4b): section 8.6 condition-(VI) DESCENT ===== *)
section \<open>r17-DVI: section 8.6 condition-(VI) Trans/fseq exchange (3) DESCENT\<close>

text \<open>Target: the condition-(VI) DESCENT  lessBT (Trans(M[n])) (Trans M)  for
  M in ST_PS Int PT_PS, transCondVI M, j1 > 1, all n >= 1 (content.md 5484-5847,
  conclusion (3), and the section 8.7 basic-sequence descent condition-(VI) leg,
  content.md 5937-5949).  This is the section 8.6 analogue of
  @{thm [source] m_8_5_scbdec_exchange2_condV_adm} / @{thm [source] e3x_exchange2_condIII}:
  a DIRECT scb-surgery descent that AVOIDS the  Trans M : OT_B  pillar (unlike
  @{thm [source] m_8_6_TransCondVI_oper_descend_engine}, which routes through
  @{thm [source] buc1_3_2a_fseq_lt} and hence needs OT_B).

  KEY STRUCTURAL SIMPLIFICATION of condition (VI): its c2 is the CLEAN two-level tower
  c2 = D_v (D_(M1j1) 0) (@{thm [source] transC2_def}, condVI branch) with NO additive t2
  middle (contrast conditions III/V, where c2 = D_v (t2 + D_(M1j1) 0)).  The article shows
  Trans(M[n]) = s1 . D_v (D_(M1j0)^k 0) . b1 (k in {n-1,n}) with the SAME (s1,b1); since
  M1j0 < M1j1 (condVI: M1j0+1 = M1j1) the inner D_(M1j0)-tower is strictly below D_(M1j1) 0
  by a bare HEAD comparison (no marking-nesting tower like e3x_H / s85b_W is needed, the head
  letter cancels and the body descends outright), so scbext_lessBT closes.

  The closed form of flatBT(Trans(M[n])) for n > 1 is the shared kind-1 LHS Mark-slice
  tower, the single hardest inductive core, RESERVED for a later round (it is exactly the
  lhs hypothesis of @{thm [source] m_8_6_exch_of_lhs_closed}).  So, faithfully mirroring
  e3x_exchange2_condIII's d1/d2/d3, this block takes that closed form as the single named
  hypothesis cf (existential in (s1,b1,inner) witnessing the scb-decomposition of Trans M and
  the flat string of Trans(M[n]), with the inner body bounded below D_(M1j1) 0) and discharges
  the descent from it.  The n = 1 leg is the pure Pred-descent
  (@{thm [source] m_7_3_Pred_Trans_descend}), needing NO closed form.  Empirical
  (r17-DVI, python/_r17_dvi_notes.py): descent 4955/4955 on genuine condVI hosts
  (adm-j0 4250/4250, nadm-j0 705/705; host Lng up to 11).  Prefix d6x_.\<close>

text \<open>A bare-head BT-order fact: any D_a-tower is strictly below D_b 0 when a < b
  (the tower's outermost head a < b, or the tower is 0 < D_b 0).  This is the ONLY order
  lemma the condition-(VI) descent needs (the marking-nesting tower of III/V does not arise,
  as c2 has no t2 middle).  It also discharges, for the reserved core, the inner-bound of cf
  at the actual tower inner = D_(M1j0)^k 0.\<close>

lemma d6x_Dtower_lt_Dpt:
  assumes ab: "a < b"
  shows "lessBT (Dtower a k) (Dpt (enat b) 0\<^sub>B)"
proof (cases k)
  case 0
  thus ?thesis by simp
next
  case (Suc k')
  have "lessBT (Dpt (enat a) (Dtower a k')) (Dpt (enat b) 0\<^sub>B)"
    using ab by simp
  thus ?thesis using Suc by simp
qed

text \<open>The condition-(VI) descent, modulo the reserved closed form \<open>cf\<close> (the shared
  kind-1 Mark-slice tower for \<open>Trans(M[n])\<close>, \<open>n > 1\<close>).  Direct scb surgery; AVOIDS the
  \<open>OT\<^bsub>B\<^esub>\<close> pillar.  Conclusion is the §8.7 基本列の降下性 condition-(VI) leg for \<open>j\<^sub>1 > 1\<close>.\<close>

lemma d6x_exchange2_condVI:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and j1gt: "1 < Lng M - 1"
    and cond: "transCondVI M"
    and n1: "1 \<le> n"
    and cf: "\<And>m. 1 < m \<Longrightarrow>
               \<exists>s\<^sub>1 b\<^sub>1 inner.
                 scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1
                 \<and> flatBT (Trans ((M::pairseq)[m]))
                     = s\<^sub>1 @ flatBP (DB (transV M) inner) @ b\<^sub>1
                 \<and> lessBT inner (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have MT: "M \<in> T_PS" using MP by (simp add: PT_PS_def)
  have L: "1 < Lng M" using j1gt by linarith
  let ?w = "entry M 1 (Lng M - 1)"
  have ncond: "\<not> transCondI M \<and> \<not> transCondIII M \<and> \<not> transCondV M"
    using cond
    by (auto simp: transCondI_def transCondIII_def transCondV_def transCondVI_def)
  have c2shape: "transC2 M = Dpt (transV M) (Dpt (enat ?w) 0\<^sub>B)"
    using ncond cond by (simp add: transC2_def Let_def transJ1_def)
  show ?thesis
  proof (cases "n = 1")
    case True
    \<comment> \<open>\<open>n = 1\<close>: \<open>M[1] = Pred M\<close>, pure \<open>Pred\<close>-descent (condition (VI) unused)\<close>
    have oper1: "(M::pairseq)[1] = Pred M" by (rule m_8_4_oper1_eq_Pred[OF MT])
    have d: "lessBT (Trans (Pred M)) (Trans M)"
      using m_7_3_Pred_Trans_descend[rule_format, OF MR L] .
    show ?thesis using True oper1 d by simp
  next
    case False
    hence n1': "1 < n" using n1 by linarith
    obtain s\<^sub>1 b\<^sub>1 inner where
      dc2: "scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1"
      and fMn: "flatBT (Trans ((M::pairseq)[n]))
                  = s\<^sub>1 @ flatBP (DB (transV M) inner) @ b\<^sub>1"
      and innerLt: "lessBT inner (Dpt (enat ?w) 0\<^sub>B)"
      using cf[OF n1'] by blast
    have fTM: "flatBT (Trans M)
                 = s\<^sub>1 @ flatBP (DB (transV M) (Dpt (enat ?w) 0\<^sub>B)) @ b\<^sub>1"
    proof -
      have "flatBT (Trans M) = s\<^sub>1 @ flatBT (transC2 M) @ b\<^sub>1"
        using dc2 by (simp add: scb_decomp_def)
      also have "flatBT (transC2 M)
                   = flatBP (DB (transV M) (Dpt (enat ?w) 0\<^sub>B))"
        using c2shape by simp
      finally show ?thesis .
    qed
    have bRP: "\<forall>x \<in> set b\<^sub>1. x = RP" using dc2 by (simp add: scb_decomp_def)
    have coreLt: "lessBP (DB (transV M) inner)
                         (DB (transV M) (Dpt (enat ?w) 0\<^sub>B))"
      using innerLt by simp
    show ?thesis by (rule scbext_lessBT[OF fMn fTM bRP coreLt])
  qed
qed

text \<open>The drop-in tower interface for the reserved core: the closed form is stated with
  the concrete inner tower  inner = D_(M1j0)^k 0 = Dtower (entry M 1 (transJ0 M)) k  (the
  article's Mark-slice tower), and the strict inner bound is discharged INTERNALLY by
  @{thm [source] d6x_Dtower_lt_Dpt} from the condition-(VI) index relation
  M1j0 < M1j1 (i.e. entry M 1 (transJ0 M) < entry M 1 (Lng M - 1), from
  @{thm [source] transCondVI_def}).  So the reserved kind-1 Mark-slice core only has to
  supply the flat-string equation of Trans(M[m]) (n>1); no separate order side-goal remains.
  Reduces to @{thm [source] d6x_exchange2_condVI}.\<close>

lemma d6x_exchange2_condVI_tower:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and j1gt: "1 < Lng M - 1"
    and cond: "transCondVI M"
    and n1: "1 \<le> n"
    and cf': "\<And>m. 1 < m \<Longrightarrow>
               \<exists>s\<^sub>1 b\<^sub>1 k.
                 scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1
                 \<and> flatBT (Trans ((M::pairseq)[m]))
                     = s\<^sub>1 @ flatBP (DB (transV M)
                              (Dtower (entry M 1 (transJ0 M)) k)) @ b\<^sub>1"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof -
  have jlt: "entry M 1 (transJ0 M) < entry M 1 (Lng M - 1)"
  proof -
    have "entry M 1 (parent M 0 (Lng M - 1)) + 1 = entry M 1 (Lng M - 1)"
      using cond by (simp add: transCondVI_def)
    thus ?thesis unfolding transJ0_def transJ1_def by linarith
  qed
  have cf: "\<And>m. 1 < m \<Longrightarrow>
       \<exists>s\<^sub>1 b\<^sub>1 inner.
         scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1
         \<and> flatBT (Trans ((M::pairseq)[m]))
             = s\<^sub>1 @ flatBP (DB (transV M) inner) @ b\<^sub>1
         \<and> lessBT inner (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)"
  proof -
    fix m :: nat assume m: "1 < m"
    obtain s\<^sub>1 b\<^sub>1 k where
      A: "scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1"
      and B: "flatBT (Trans ((M::pairseq)[m]))
                = s\<^sub>1 @ flatBP (DB (transV M)
                         (Dtower (entry M 1 (transJ0 M)) k)) @ b\<^sub>1"
      using cf'[OF m] by blast
    have lt: "lessBT (Dtower (entry M 1 (transJ0 M)) k)
                     (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)"
      by (rule d6x_Dtower_lt_Dpt[OF jlt])
    show "\<exists>s\<^sub>1 b\<^sub>1 inner.
            scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1
            \<and> flatBT (Trans ((M::pairseq)[m]))
                = s\<^sub>1 @ flatBP (DB (transV M) inner) @ b\<^sub>1
            \<and> lessBT inner (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)"
      using A B lt by blast
  qed
  show ?thesis by (rule d6x_exchange2_condVI[OF MST MP j1gt cond n1 cf])
qed



(* ===== round 17 front D13 (wt-b1 68ca5d1): condIII (1)(3)+triple ===== *)
(* ===== round 17 front D13 (wt-b1): §8.4 condIII exchange TRIPLE — conclusions
        (1) and (3) via the jm3-decomposition fundamental-sequence route ===== *)

section \<open>r17-D13 — §8.4 condIII exchange conclusions (1) and (3) (jm3 route)\<close>

text \<open>命題（条件(III)か(IV)の下での\<open>Trans\<close>と基本列の交換関係）, the two REMAINING
  conclusions of the A32-corrected triple (front E3 discharged conclusion (2),
  @{thm [source] e3x_exchange2_condIII}):
    \<^item> (1)  \<open>Trans(M[n]) < Trans(M)[n]\<close>          (strict), and
    \<^item> (3)  \<open>Trans(M)[n-1] < Trans(M[n+1])\<close>     (the shifted pairing).
  where \<open>Trans(M)[k] = operB (Trans M) (numBT k)\<close>.  Unlike conclusion (2) — which
  compares \<open>Trans(M[n])\<close> with \<open>Trans M\<close> in the outer \<open>j\<^sub>-\<^sub>1\<close>-decomposition — these
  two involve the Buchholz fundamental sequence \<open>operB\<close>, which expands the RIGHTMOST
  principal of \<open>Trans M\<close>.  In the \<open>j\<^sub>-\<^sub>1\<close>-decomposition \<open>operB\<close> suffers domain-capture
  (\<open>M\<^bsub>1,j\<^sub>0\<^esub> \<ge> M\<^bsub>1,j\<^sub>1\<^esub>\<close>, r15-VX item 6b/7); the E3 route instead descends to the
  \<open>j\<^sub>-\<^sub>3\<close>-decomposition \<open>Trans M = U\<^sub>0 D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>3\<^esub>(body) V\<^sub>0\<close> (kind-1,
  @{thm [source] m_8_4_Trans_scb}), where the head letter \<open>e\<^sub>3 = M\<^bsub>1,j\<^sub>-\<^sub>3\<^esub> < M\<^bsub>1,j\<^sub>1\<^esub>\<close>
  so the operB engine @{thm [source] m_7_2_scb_fseq_kind1_general} APPLIES (validator
  \<open>_r16_e3_validate.py\<close>: \<open>S0_e3_lt_v1\<close> 192/192, \<open>S8_1_strict\<close> 576/576,
  \<open>S8_3_printed\<close> 576/576).  Both \<open>Trans(M[n])\<close> and \<open>Trans(M)[n]\<close> then read in the
  SAME \<open>U\<^sub>0 D\<^bsub>e\<^sub>3\<^esub>(\<cdot>) V\<^sub>0\<close> wrapper, with cores the two interleaving towers
  \<open>A\<^sub>k\<close> (base \<open>A\<^sub>0 = bpHeadT(Trans(Pred N))\<close>) and \<open>X\<^sub>k\<close> (base \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^sub>-\<^sub>1\<^esub> 0\<close>)
  sharing the recursion \<open>Y\<^sub>k\<^sub>+\<^sub>1 = L +\<^sub>B D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^sub>-\<^sub>1\<^esub>(Y\<^sub>k)\<close>.  The fundamental
  interleaving \<open>X\<^sub>k < A\<^sub>k < X\<^sub>k\<^sub>+\<^sub>1\<close> gives (1) and (3).  Prefix \<open>d13x_\<close>.\<close>

subsection \<open>The base-parametrised two-letter tower \<open>d13x_T\<close> and its interleaving\<close>

text \<open>\<open>d13x_T L ub base\<close> is the tower \<open>Y\<^sub>0 = base\<close>, \<open>Y\<^sub>k\<^sub>+\<^sub>1 = L +\<^sub>B D\<^bsub>ub\<^esub>(Y\<^sub>k)\<close>
  (leaf \<open>L\<close>, block letter \<open>ub = M\<^bsub>1,j\<^sub>1\<^esub> - 1 = M\<^bsub>1,j\<^sub>-\<^sub>2\<^esub>\<close>).  With \<open>base = L\<close> it is
  @{const e3x_H}; the two conclusion towers differ only in their base (\<open>A\<^sub>0\<close> resp.
  \<open>X\<^sub>0 = D\<^bsub>ub\<^esub> 0\<close>).  The flat form mirrors @{thm [source] e3x_H_flat}; the interleaving
  is pure @{thm [source] lessBT_addBT_mono_right} (no surgery needed).\<close>

fun d13x_T :: "BT \<Rightarrow> nat \<Rightarrow> BT \<Rightarrow> nat \<Rightarrow> BT" where
  "d13x_T L ub base 0 = base"
| "d13x_T L ub base (Suc k) = L +\<^sub>B Dpt (enat ub) (d13x_T L ub base k)"

lemma d13x_T_dfree:
  assumes "dfree_BT L" and "dfree_BT base"
  shows "dfree_BT (d13x_T L ub base k)"
  using assms by (induction k) (simp_all add: dfree_BT_addBT)

lemma d13x_T_TB:
  assumes "L \<in> T_B" and "base \<in> T_B"
  shows "d13x_T L ub base k \<in> T_B"
  using assms d13x_T_dfree[of L base ub k] by (simp add: T_B_def)

lemma d13x_T_flat:
  assumes LTB: "L \<in> T_B" and baseTB: "base \<in> T_B"
    and inner: "scb_decomp (L +\<^sub>B Dpt (enat ub) 0\<^sub>B) s0
                  (flatBT (Dpt (enat ub) 0\<^sub>B)) b0"
  shows "flatBT (d13x_T L ub base k)
       = concat (replicate k (s0 @ [Dsym (enat ub)]))
         @ flatBT base @ concat (replicate k b0)"
proof (induction k)
  case 0 show ?case by simp
next
  case (Suc k)
  have c0TB: "Dpt (enat ub) 0\<^sub>B \<in> T_B" by (simp add: T_B_def)
  have c0p: "\<exists>p. Dpt (enat ub) 0\<^sub>B = Trm [p]" by auto
  have HTB: "d13x_T L ub base k \<in> T_B" by (rule d13x_T_TB[OF LTB baseTB])
  have HpTB: "Dpt (enat ub) (d13x_T L ub base k) \<in> T_B" using HTB by (simp add: T_B_def)
  have Hpp: "\<exists>p. Dpt (enat ub) (d13x_T L ub base k) = Trm [p]" by auto
  have sub: "scb_decomp (L +\<^sub>B Dpt (enat ub) (d13x_T L ub base k)) s0
               (flatBT (Dpt (enat ub) (d13x_T L ub base k))) b0"
    by (rule m_7_2_add_scb_conj2[OF LTB c0TB c0p HpTB Hpp inner])
  have fsub: "flatBT (L +\<^sub>B Dpt (enat ub) (d13x_T L ub base k))
              = s0 @ flatBT (Dpt (enat ub) (d13x_T L ub base k)) @ b0"
    using sub by (simp add: scb_decomp_def)
  have "flatBT (d13x_T L ub base (Suc k))
        = s0 @ Dsym (enat ub)
           # (concat (replicate k (s0 @ [Dsym (enat ub)]))
              @ flatBT base @ concat (replicate k b0)) @ b0"
    using fsub Suc.IH by simp
  also have "\<dots> = concat (replicate (Suc k) (s0 @ [Dsym (enat ub)]))
        @ flatBT base @ concat (replicate (Suc k) b0)"
    by (simp add: s85b_crep_comm_snoc s85b_crep_snoc s85b_crep_comm)
  finally show ?case .
qed

text \<open>The fundamental interleaving \<open>X\<^sub>k < A\<^sub>k < X\<^sub>k\<^sub>+\<^sub>1\<close> from the two base facts
  \<open>X\<^sub>0 < A\<^sub>0\<close> and \<open>A\<^sub>0 < X\<^sub>1 = L +\<^sub>B D\<^bsub>ub\<^esub>(X\<^sub>0)\<close>, by monotone lifting of the shared
  recursion.  Validator: \<open>S8_1_tower\<close>/\<open>S8_3s_tower\<close> 576/576.\<close>

lemma d13x_T_interleave:
  assumes b0: "lessBT xb ab"
    and b1: "lessBT ab (L +\<^sub>B Dpt (enat ub) xb)"
  shows "lessBT (d13x_T L ub xb k) (d13x_T L ub ab k)
       \<and> lessBT (d13x_T L ub ab k) (d13x_T L ub xb (Suc k))"
proof (induction k)
  case 0
  show ?case using b0 b1 by simp
next
  case (Suc k)
  have XA: "lessBT (d13x_T L ub xb k) (d13x_T L ub ab k)" using Suc.IH by blast
  have AX: "lessBT (d13x_T L ub ab k) (d13x_T L ub xb (Suc k))" using Suc.IH by blast
  have s1: "lessBT (d13x_T L ub xb (Suc k)) (d13x_T L ub ab (Suc k))"
  proof -
    have "lessBT (Dpt (enat ub) (d13x_T L ub xb k)) (Dpt (enat ub) (d13x_T L ub ab k))"
      using XA by simp
    from lessBT_addBT_mono_right[OF this] show ?thesis by simp
  qed
  have s2: "lessBT (d13x_T L ub ab (Suc k)) (d13x_T L ub xb (Suc (Suc k)))"
  proof -
    have "lessBT (Dpt (enat ub) (d13x_T L ub ab k))
                 (Dpt (enat ub) (d13x_T L ub xb (Suc k)))"
      using AX by simp
    from lessBT_addBT_mono_right[OF this] show ?thesis by simp
  qed
  show ?case using s1 s2 by blast
qed


subsection \<open>The operB fundamental-sequence closed form at the \<open>j\<^sub>-\<^sub>3\<close> head\<close>

text \<open>The condition-(III) analogue of @{thm [source] m_8_5_scbdec_fseq_condV}: with
  the kind-1 decomposition of \<open>Trans M\<close> around the \<open>j\<^sub>-\<^sub>3\<close>-principal
  \<open>D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>3\<^esub>(body)\<close> (head \<open>u = M\<^bsub>1,j\<^sub>-\<^sub>3\<^esub> < M\<^bsub>1,j\<^sub>1\<^esub> = v\<close>, @{thm [source] m_8_4_Trans_scb}
  supplies \<open>k1\<close>), the fundamental sequence expands that principal into \<open>n\<close> copies of
  the inner \<open>(s\<^sub>0, D\<^bsub>v-1\<^esub>, b\<^sub>0)\<close> block, via the corrected engine
  @{thm [source] m_7_2_scb_fseq_kind1_general}.  Direct instantiation (drop the
  \<open>v > u\<close> conjunct).  Validator: \<open>S3_fseq_form\<close> 768/768.\<close>

lemma d13x_fseq_condIII:
  fixes M :: pairseq and n :: nat and s0 s1 b0 b1 :: "Sym list" and body :: BT
  assumes TT: "Trans M \<in> T_B"
    and uv: "entry M 1 (s84x_jm3 M) < entry M 1 (Lng M - 1)"
    and bodyT: "body \<in> T_B"
    and dbbody: "domB body = TBv (enat (entry M 1 (Lng M - 1) - 1))"
    and bodyne: "body \<noteq> Trm []"
    and inner: "scb_decomp body s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b0"
    and k1: "scb_kind1 (Trans M) s1
               (flatBT (Dpt (enat (entry M 1 (s84x_jm3 M))) body)) b1"
  shows "flatBT (operB (Trans M) (numBT n))
           = s1 @ (Dsym (enat (entry M 1 (s84x_jm3 M)))
                # concat (replicate n (s0 @ [Dsym (enat (entry M 1 (Lng M - 1) - 1))]))
                @ [Dsym (enat (entry M 1 (Lng M - 1) - 1))]
                @ [Zsym]
                @ concat (replicate n b0))
             @ b1"
proof -
  have "entry M 1 (Lng M - 1) > entry M 1 (s84x_jm3 M) \<and>
        flatBT (operB (Trans M) (numBT n))
           = s1 @ (Dsym (enat (entry M 1 (s84x_jm3 M)))
                # concat (replicate n (s0 @ [Dsym (enat (entry M 1 (Lng M - 1) - 1))]))
                @ [Dsym (enat (entry M 1 (Lng M - 1) - 1))]
                @ [Zsym]
                @ concat (replicate n b0))
             @ b1"
    by (rule m_7_2_scb_fseq_kind1_general[OF TT uv bodyT dbbody bodyne inner k1])
  thus ?thesis by blast
qed


subsection \<open>Conclusions (1) and (3) of the §8.4 condIII exchange triple\<close>

text \<open>Assembling the whole triple's conclusions (1) and (3).  In the shared
  \<open>U\<^sub>0 D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>-\<^sub>3\<^esub>(\<cdot>) V\<^sub>0\<close> wrapper (\<open>s1 / b1\<close> here), \<open>Trans(M)[n]\<close> reads with core
  the X-tower \<open>X\<^sub>n = d13x_T L (v-1) (D\<^bsub>v-1\<^esub> 0) n\<close> (@{thm [source] d13x_fseq_condIII}
  + @{thm [source] d13x_T_flat}), and \<open>Trans(M[n])\<close> reads with core the A-tower
  \<open>A\<^sub>n\<^sub>-\<^sub>1 = d13x_T L (v-1) A\<^sub>0 (n-1)\<close> (\<open>mnform\<close>, the E3 reserved core, taken as a
  hypothesis).  The interleaving @{thm [source] d13x_T_interleave} gives
  \<open>A\<^sub>n\<^sub>-\<^sub>1 < X\<^sub>n\<close> (conclusion (1)), \<open>X\<^sub>n\<^sub>-\<^sub>1 < A\<^sub>n\<^sub>-\<^sub>1\<close> (shifted (3)); the printed (3)
  follows via the \<open>Trans\<close>-monotonicity \<open>Trans(M[n]) < Trans(M[n+1])\<close> (\<open>A\<^sub>n\<^sub>-\<^sub>1 < A\<^sub>n\<close>).
  All three cores are compared by 部分表現の不等式の延長性
  (@{thm [source] scbext_lessBT}).  Validator: \<open>S8_1_strict\<close> 576/576,
  \<open>S8_3s_chain\<close> 576/576, \<open>S8_3_printed\<close> 576/576.\<close>

lemma d13x_exchange13_condIII:
  fixes M :: pairseq and n :: nat and L A0 body :: BT and s0 s1 b0 b1 :: "Sym list"
  assumes MST: "M \<in> ST_PS"
    and n1: "1 \<le> n"
    and LTB: "L \<in> T_B"
    and uv: "entry M 1 (s84x_jm3 M) < entry M 1 (Lng M - 1)"
    and bodyT: "body \<in> T_B"
    and bodyne: "body \<noteq> Trm []"
    and dbbody: "domB body = TBv (enat (entry M 1 (Lng M - 1) - 1))"
    and inner: "scb_decomp body s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b0"
    and innerU: "scb_decomp (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)
                   s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)) b0"
    and k1: "scb_kind1 (Trans M) s1
               (flatBT (Dpt (enat (entry M 1 (s84x_jm3 M))) body)) b1"
    and mnform: "\<And>m. 1 \<le> m \<Longrightarrow>
        flatBT (Trans ((M::pairseq)[m]))
          = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
              # flatBT (d13x_T L (entry M 1 (Lng M - 1) - 1) A0 (m - 1)) @ b1"
    and bx: "lessBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B) A0"
    and ba: "lessBT A0 (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1))
                          (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B))"
  shows "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))
       \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n]))
       \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n + 1]))"
proof -
  let ?e3 = "entry M 1 (s84x_jm3 M)"
  let ?ub = "entry M 1 (Lng M - 1) - 1"
  let ?X0 = "Dpt (enat ?ub) 0\<^sub>B"
  have MR: "M \<in> RT_PS" using MST m_6_7_ST_PS_subseteq_RT_PS by blast
  have TT: "Trans M \<in> T_B" by (rule m_7_3_Trans_in_T_B[OF MR])
  \<comment> \<open>the operB closed form at \<open>n\<close> and \<open>n-1\<close>\<close>
  have fs_n: "flatBT (operB (Trans M) (numBT n))
      = s1 @ (Dsym (enat ?e3)
           # concat (replicate n (s0 @ [Dsym (enat ?ub)]))
           @ [Dsym (enat ?ub)] @ [Zsym] @ concat (replicate n b0)) @ b1"
    by (rule d13x_fseq_condIII[OF TT uv bodyT dbbody bodyne inner k1])
  have fs_n1: "flatBT (operB (Trans M) (numBT (n - 1)))
      = s1 @ (Dsym (enat ?e3)
           # concat (replicate (n - 1) (s0 @ [Dsym (enat ?ub)]))
           @ [Dsym (enat ?ub)] @ [Zsym] @ concat (replicate (n - 1) b0)) @ b1"
    by (rule d13x_fseq_condIII[OF TT uv bodyT dbbody bodyne inner k1])
  \<comment> \<open>the X-tower flat form\<close>
  have X0TB: "?X0 \<in> T_B" by (simp add: T_B_def)
  have Xflat_n: "flatBT (d13x_T L ?ub ?X0 n)
      = concat (replicate n (s0 @ [Dsym (enat ?ub)]))
        @ flatBT ?X0 @ concat (replicate n b0)"
    by (rule d13x_T_flat[OF LTB X0TB innerU])
  have Xflat_n1: "flatBT (d13x_T L ?ub ?X0 (n - 1))
      = concat (replicate (n - 1) (s0 @ [Dsym (enat ?ub)]))
        @ flatBT ?X0 @ concat (replicate (n - 1) b0)"
    by (rule d13x_T_flat[OF LTB X0TB innerU])
  \<comment> \<open>read the four flat strings in the common \<open>s1 D\<^bsub>e\<^sub>3\<^esub>(\<cdot>) b1\<close> wrapper\<close>
  have fOn: "flatBT (operB (Trans M) (numBT n))
      = s1 @ flatBP (DB (enat ?e3) (d13x_T L ?ub ?X0 n)) @ b1"
    using fs_n Xflat_n by simp
  have fOn1: "flatBT (operB (Trans M) (numBT (n - 1)))
      = s1 @ flatBP (DB (enat ?e3) (d13x_T L ?ub ?X0 (n - 1))) @ b1"
    using fs_n1 Xflat_n1 by simp
  have fMn: "flatBT (Trans ((M::pairseq)[n]))
      = s1 @ flatBP (DB (enat ?e3) (d13x_T L ?ub A0 (n - 1))) @ b1"
    using mnform[OF n1] by simp
  have n11: "(1::nat) \<le> n + 1" by simp
  have fMn1: "flatBT (Trans ((M::pairseq)[n + 1]))
      = s1 @ flatBP (DB (enat ?e3) (d13x_T L ?ub A0 n)) @ b1"
    using mnform[OF n11] by simp
  \<comment> \<open>the shared right-context \<open>b1\<close> is all-\<open>RP\<close>\<close>
  have dTM: "scb_decomp (Trans M) s1 (flatBT (Dpt (enat ?e3) body)) b1"
    using k1 by (simp add: scb_kind1_def)
  have b1RP: "\<forall>x \<in> set b1. x = RP" using dTM by (simp add: scb_decomp_def)
  \<comment> \<open>the fundamental interleaving of the two towers\<close>
  note IL = d13x_T_interleave[OF bx ba]
  have Sn: "Suc (n - 1) = n" using n1 by simp
  have XAn: "lessBT (d13x_T L ?ub ?X0 (n - 1)) (d13x_T L ?ub A0 (n - 1))"
    using IL[of "n - 1"] by simp
  have AXn: "lessBT (d13x_T L ?ub A0 (n - 1)) (d13x_T L ?ub ?X0 n)"
    using IL[of "n - 1"] Sn by simp
  have XAsn: "lessBT (d13x_T L ?ub ?X0 n) (d13x_T L ?ub A0 n)"
    using IL[of "n"] by simp
  have AAn: "lessBT (d13x_T L ?ub A0 (n - 1)) (d13x_T L ?ub A0 n)"
    using AXn XAsn by (rule lessBT_trans)
  \<comment> \<open>conclusion (1): \<open>Trans(M[n]) < Trans(M)[n]\<close>\<close>
  have core1: "lessBP (DB (enat ?e3) (d13x_T L ?ub A0 (n - 1)))
                      (DB (enat ?e3) (d13x_T L ?ub ?X0 n))"
    using AXn by simp
  have concl1: "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))"
    by (rule scbext_lessBT[OF fMn fOn b1RP core1])
  \<comment> \<open>shifted (3): \<open>Trans(M)[n-1] < Trans(M[n])\<close>\<close>
  have core3s: "lessBP (DB (enat ?e3) (d13x_T L ?ub ?X0 (n - 1)))
                       (DB (enat ?e3) (d13x_T L ?ub A0 (n - 1)))"
    using XAn by simp
  have concl3s: "lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n]))"
    by (rule scbext_lessBT[OF fOn1 fMn b1RP core3s])
  \<comment> \<open>\<open>Trans\<close>-monotonicity and printed (3)\<close>
  have coreAA: "lessBP (DB (enat ?e3) (d13x_T L ?ub A0 (n - 1)))
                       (DB (enat ?e3) (d13x_T L ?ub A0 n))"
    using AAn by simp
  have Mmono: "lessBT (Trans ((M::pairseq)[n])) (Trans ((M::pairseq)[n + 1]))"
    by (rule scbext_lessBT[OF fMn fMn1 b1RP coreAA])
  have concl3: "lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n + 1]))"
    using concl3s Mmono by (rule lessBT_trans)
  show ?thesis using concl1 concl3s concl3 by blast
qed


subsection \<open>The assembled A32-corrected §8.4 exchange triple (condition III)\<close>

text \<open>命題（条件(III)か(IV)の下での\<open>Trans\<close>と基本列の交換関係）, the WHOLE A32-corrected
  triple for the condition-(III) regime, gluing conclusion (2)
  (@{thm [source] e3x_exchange2_condIII}, front E3) to conclusions (1)/(3)
  (@{thm [source] d13x_exchange13_condIII}).  The A32 correction: the printed
  conclusion (1) \<open>Trans(M[n]) \<le> Trans(M)[n-1]\<close> is refuted (r15-VX item 1); the
  correct pairing is \<open>Trans(M[n]) < Trans(M)[n]\<close> (strict, index \<open>n\<close>) — indeed
  @{thm [source] d13x_exchange13_condIII} even proves the reverse strict
  \<open>Trans(M)[n-1] < Trans(M[n])\<close>.  Every hypothesis is a named E3-route residual (the
  E2/E3 terminal-slice transports \<open>d1/d2/d3\<close> for (2); the \<open>j\<^sub>-\<^sub>3\<close> kind-1 producer
  data + the reserved \<open>mnform\<close> M[n]-form + the two tower base facts for (1)/(3)).
  NB @{thm [source] d13x_exchange13_condIII} is itself condition-agnostic (it never
  uses \<open>transCondIII\<close>), so conclusions (1)/(3) already transfer to condition (IV);
  only conclusion (2)'s \<open>c\<^sub>2\<close>-shape here is condIII-specific.\<close>

lemma m_8_4_Trans_oper_exchange_corrected_condIII:
  fixes M :: pairseq and n :: nat and L A0 body :: BT
    and s0 s1 b0 b1 s1' b1' :: "Sym list"
  assumes MST: "M \<in> ST_PS" and MPT: "M \<in> PT_PS"
    and hp: "hasParent M 1 (Lng M - 1)"
    and cIII: "transCondIII M"
    and reg: "s84x_jm2 M < transJ0 M \<or> adm M (transJ0 M)"
    and admeq: "Adm M (s84x_jm2 M) = transJm1 M"
    and n1: "1 \<le> n"
    \<comment> \<open>conclusion (2): the E2/E3 terminal-slice transports\<close>
    and d1: "scb_decomp (transC2 M)
               (Dsym (enat (entry M 1 (transJm1 M))) # s1')
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b1'"
    and d2: "scb_decomp (Trans (s84x_Np M))
               (Dsym (enat (entry M 1 (s84x_jm2 M))) # s1')
               (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b1'"
    and d3: "Trans (Pred (s84x_Np M))
               = Dpt (enat (entry M 1 (s84x_jm2 M))) (transT2 M)"
    \<comment> \<open>conclusions (1)/(3): the \<open>j\<^sub>-\<^sub>3\<close> kind-1 producer data, reserved core, base facts\<close>
    and LTB: "L \<in> T_B"
    and uv: "entry M 1 (s84x_jm3 M) < entry M 1 (Lng M - 1)"
    and bodyT: "body \<in> T_B"
    and bodyne: "body \<noteq> Trm []"
    and dbbody: "domB body = TBv (enat (entry M 1 (Lng M - 1) - 1))"
    and inner: "scb_decomp body s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b0"
    and innerU: "scb_decomp (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)
                   s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)) b0"
    and k1: "scb_kind1 (Trans M) s1
               (flatBT (Dpt (enat (entry M 1 (s84x_jm3 M))) body)) b1"
    and mnform: "\<And>m. 1 \<le> m \<Longrightarrow>
        flatBT (Trans ((M::pairseq)[m]))
          = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
              # flatBT (d13x_T L (entry M 1 (Lng M - 1) - 1) A0 (m - 1)) @ b1"
    and bx: "lessBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B) A0"
    and ba: "lessBT A0 (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1))
                          (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B))"
  shows "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))
       \<and> lessBT (Trans ((M::pairseq)[n])) (Trans M)
       \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n + 1]))"
proof -
  have c2: "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
    by (rule e3x_exchange2_condIII[OF MST MPT hp cIII reg admeq n1 d1 d2 d3])
  have tri: "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))
           \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n]))
           \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n + 1]))"
    by (rule d13x_exchange13_condIII[OF MST n1 LTB uv bodyT bodyne dbbody
          inner innerU k1 mnform bx ba])
  show ?thesis using c2 tri by blast
qed




(* ===== round 18 front CONS (wt2 873380b): collapse to CF-META + capstone m_8_termination_modulo_CF ===== *)
(* ==================== r18-CONS: CONSOLIDATION onto the single residual CF ==================== *)
section \<open>r18-CONS — every §8 termination residual collapses onto the marked-principal
  fundamental-sequence flat closed form \<open>CF\<close>\<close>

text \<open>THE CONVERGENCE (round 17), pinned.  Every §8 termination residual bottoms on the
  closed form of \<open>flatBT (Trans (M[n]))\<close> that the article's Pred-SIMULTANEOUS induction
  (content.md 3745-3945) produces.  The UNIFYING object is NOT an equation
  \<open>Trans(M[n]) = operB (\<dots>)\<close> — that EQUALITY is FALSE for conditions (III) and (V), where the
  fundamental sequence strictly INTERLEAVES the Buchholz fundamental sequence
  (\<open>X\<^sub>k < A\<^sub>k < X\<^sub>k\<^sub>+\<^sub>1\<close>; @{thm [source] d13x_exchange13_condIII}, and the STRICT exchange(1) of
  r15-S5b).  The unifying object is the FULL FLAT STRING of \<open>flatBT (Trans (M[n]))\<close> read in
  the MARKED-PRINCIPAL surgery wrapper of \<open>Trans M\<close>:

  \<^bold>\<open>CF-META\<close>:  \<open>flatBT (Trans (M[n])) = s\<^sub>1 @ flatBP (DB hd (core M n)) @ b\<^sub>1\<close>,

  where \<open>(s\<^sub>1,b\<^sub>1)\<close> is the ONE surgery pair scb-decomposing \<open>Trans M\<close> at its marked principal
  \<open>transC2 M\<close> (\<open>flatBT (Trans M) = s\<^sub>1 @ flatBP (DB hd top) @ b\<^sub>1\<close>), \<open>hd\<close> is the marked head, and
  \<open>core M n\<close> is the condition-specific inner body:

  \<^item> cond (II)  KIND-0, \<open>hd = M\<^bsub>1,j\<^sub>-\<^sub>1\<^esub>\<close>, \<open>core = t\<^sub>0 + (D\<^bsub>v\<^esub> t\<^sub>1)\<cdot>(n-1)\<close>, \<open>top = t\<^sub>0 + D\<^bsub>v\<^esub>(t\<^sub>1 + D\<^sub>0 0)\<close>
    (the \<open>lhs\<close> of @{thm [source] m_8_3_exch_of_lhs_closed} / @{thm [source] d2x_exchange2_condII}).
  \<^item> cond (VI) KIND-1, \<open>hd = transV M\<close>, \<open>core = Dtower M\<^bsub>1,j\<^sub>0\<^esub> k\<close>, \<open>top = D\<^bsub>M\<^sub>1\<^sub>,\<^sub>j\<^sub>1\<^esub> 0\<close>
    (the \<open>cf'\<close> of @{thm [source] d6x_exchange2_condVI_tower}).
  \<^item> cond (III) KIND-1, \<open>hd = M\<^bsub>1,j\<^sub>-\<^sub>3\<^esub>\<close>, \<open>core = d13x_T L (v-1) A\<^sub>0 (n-1)\<close> (A-tower)
    (the \<open>mnform\<close> of @{thm [source] d13x_exchange13_condIII}).
  \<^item> cond (V)-nonadm KIND-1, \<open>hd = M\<^bsub>1,j\<^sub>-\<^sub>1\<^esub>\<close>, \<open>core = e5x_bodyM t\<^sub>2 e (n-1)\<close> (+ the \<open>operB\<close> companion)
    (the \<open>NF\<close> of @{thm [source] m_8_5_Trans_oper_exchange_condV_nonadm}).

  Because the four cores are genuinely different closed forms (the condition IS the core shape),
  NO single literal equation gives all four; what is single is this ABSTRACT marked-principal
  flat form.  It is the FABLE TARGET: Fable proves CF-META (4 instances) by the Pred-simultaneous
  induction; below we discharge, GREEN, the mechanical consequences.

  COLLAPSE MAP (see the lemmas below and python/_r18_cons_map.py):
  \<^item> @{text m_8_cf_descent_of_CF}: CF-META + core-bound \<Rightarrow> \<open>lessBT (Trans(M[n])) (Trans M)\<close>.  ONE
    generic lemma subsuming the conclusion-(2) DESCENT of conditions (II)/(III)/(V)/(VI).
  \<^item> @{text m_8_3_lhs_of_CF}: the cond-(II) CF-META instance \<Rightarrow> the \<open>lhs\<close> residual (unflat form).
  \<^item> @{text m_8_6_cf_of_CF}: the cond-(VI) CF-META instance \<Rightarrow> d6x's existential \<open>cf'\<close> residual.
  \<^item> @{text m_8_termination_modulo_CF}: the two §8 PILLARS (\<open>Trans M \<in> OT\<^bsub>B\<^esub>\<close> + the fundamental-
    sequence DESCENT) from the CF-derived exchanges + \<open>stepval\<close> — so §8 bottoms on
    CF + \<open>buc1_2_2_OT_B_wf\<close> alone (the final \<open>Fdom\<close> step is the standard well-founded induction
    over that descent, not re-mechanized here).
  \<^item> VE'/FPEEL_STEP (§8.2) is a DIFFERENT object — the terminal SLICE \<open>seg M m j\<^sub>1\<close>, not the
    fundamental sequence — proved by the SAME Pred-simultaneous induction; it does NOT logically
    follow from CF-for-\<open>M[n]\<close>, so it is a second (slice) instance of the same core (its telescoping
    reduction to FPEEL_STEP is already GREEN: @{thm [source] fpx_terminal_slice_Trans_modStep}).\<close>

subsection \<open>The generic descent from \<open>CF\<close> (subsumes the four condition descents)\<close>

text \<open>The single point onto which every conclusion-(2) DESCENT collapses: once CF-META gives
  \<open>flatBT (Trans (M[n]))\<close> in the surgery wrapper of \<open>flatBT (Trans M)\<close> with a marked principal
  \<open>coreP\<close> strictly below the \<open>Trans M\<close> marked principal \<open>topP\<close>, the descent is one application
  of 部分表現の不等式の延長性 (@{thm [source] scbext_lessBT}).  Conditions (II)
  (@{thm [source] d2x_exchange2_condII}), (III) (@{thm [source] e3x_exchange2_condIII}),
  (V)-nonadm (@{thm [source] m_8_5_Trans_oper_exchange_condV_nonadm}) and (VI)
  (@{thm [source] d6x_exchange2_condVI}) each end with exactly this step.\<close>

lemma m_8_cf_descent_of_CF:
  fixes M :: pairseq and n :: nat
    and s b :: "Sym list" and topP coreP :: BP
  assumes dTM: "flatBT (Trans M) = s @ flatBP topP @ b"
    and CF:    "flatBT (Trans ((M::pairseq)[n])) = s @ flatBP coreP @ b"
    and bRP:   "\<forall>x \<in> set b. x = RP"
    and coreLt: "lessBP coreP topP"
  shows "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
  by (rule scbext_lessBT[OF CF dTM bRP coreLt])

subsection \<open>The cond-(II) \<open>lhs\<close> residual from its CF-META instance\<close>

text \<open>The KIND-0 CF-META instance (@{text CF}: the flat string of \<open>Trans(M[m])\<close> at the marked
  principal \<open>D\<^bsub>u\<^esub>(t\<^sub>0 + (D\<^bsub>v\<^esub> t\<^sub>1)\<cdot>(m-1))\<close>) is exactly the \<open>lhs\<close> hypothesis of
  @{thm [source] m_8_3_exch_of_lhs_closed} / @{thm [source] d2x_exchange2_condII}, read back
  through @{thm [source] unflatBT_flat} (\<open>flatBT (Dpt u t) = flatBP (DB u t)\<close>).\<close>

lemma m_8_3_lhs_of_CF:
  fixes M :: pairseq and m u v :: nat and t\<^sub>0 t\<^sub>1 :: BT and s b :: "Sym list"
  assumes CF: "flatBT (Trans ((M::pairseq)[m]))
                 = s @ flatBP (DB (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (m - 1))) @ b"
  shows "Trans ((M::pairseq)[m])
           = unflatBT (s @ flatBT (Dpt (enat u)
                (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (m - 1))) @ b)"
proof -
  have fp: "flatBT (Dpt (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (m - 1)))
            = flatBP (DB (enat u) (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (m - 1)))"
    by simp
  have "unflatBT (s @ flatBT (Dpt (enat u)
             (t\<^sub>0 +\<^sub>B multBT (Dpt (enat v) t\<^sub>1) (m - 1))) @ b)
        = unflatBT (flatBT (Trans ((M::pairseq)[m])))"
    using CF fp by simp
  also have "\<dots> = Trans ((M::pairseq)[m])" by (rule unflatBT_flat)
  finally show ?thesis by (rule sym)
qed

subsection \<open>The cond-(VI) \<open>cf'\<close> residual from its CF-META instance\<close>

text \<open>The KIND-1 (clean, \<open>t\<^sub>2\<close>-free) CF-META instance packages directly into the existential
  \<open>cf'\<close> hypothesis of @{thm [source] d6x_exchange2_condVI_tower} (\<open>core = Dtower M\<^bsub>1,j\<^sub>0\<^esub> k\<close>): the
  scb-decomposition of \<open>Trans M\<close> at \<open>transC2 M\<close> and the flat string of \<open>Trans(M[m])\<close> ARE the two
  conjuncts.  The strict inner bound is discharged internally by @{thm [source] d6x_Dtower_lt_Dpt}
  from the condition-(VI) index relation, so \<open>cf'\<close> is just the CF-META existential witnessing.\<close>

lemma m_8_6_cf_of_CF:
  fixes M :: pairseq and m k :: nat and s\<^sub>1 b\<^sub>1 :: "Sym list"
  assumes dc2: "scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1"
    and CF: "flatBT (Trans ((M::pairseq)[m]))
               = s\<^sub>1 @ flatBP (DB (transV M) (Dtower (entry M 1 (transJ0 M)) k)) @ b\<^sub>1"
  shows "\<exists>s\<^sub>1 b\<^sub>1 k.
           scb_decomp (Trans M) s\<^sub>1 (flatBT (transC2 M)) b\<^sub>1
           \<and> flatBT (Trans ((M::pairseq)[m]))
               = s\<^sub>1 @ flatBP (DB (transV M)
                        (Dtower (entry M 1 (transJ0 M)) k)) @ b\<^sub>1"
  using dc2 CF by blast

subsection \<open>CAPSTONE — the two §8 pillars modulo \<open>CF\<close> (+ \<open>stepval\<close>)\<close>

text \<open>Both §8 termination pillars from the CF-derived inputs: the OT pillar \<open>Trans M \<in> OT\<^bsub>B\<^esub>\<close> from
  \<open>stepval\<close> (the §8.7 op0-tower value identity, via @{thm [source] m_8_7_Trans_preserves_OT_via_closure}),
  and the fundamental-sequence DESCENT \<open>lessBT (Trans(M[n])) (Trans M)\<close> from the six per-condition
  EXCHANGE facts (which the CF-META instances supply through the \<open>exch_of_lhs\<close> bridges
  @{thm [source] m_8_3_exch_of_lhs_closed} etc.) via the full dispatcher
  @{thm [source] m_8_7_fseq_descend_dispatcher}.  Thus the whole §8 bottoms on
  \<open>CF\<close> + \<open>buc1_2_2_OT_B_wf\<close>: the remaining step to the article's \<open>Fdom\<close> statement
  (@{thm [source] p_8_7_termination}) is the standard well-founded induction of the descent along
  \<open>(OT\<^bsub>B\<^esub>, <)\<close>, which is @{thm [source] buc1_2_2_OT_B_wf} and is not re-mechanized here.\<close>

lemma m_8_termination_modulo_CF:
  fixes M :: pairseq and n :: nat
  assumes MST: "M \<in> ST_PS" and n1: "1 \<le> n" and L: "1 < Lng M"
    and stepval: "\<And>N k. N \<in> ST_PS \<Longrightarrow> Trans N \<in> OT_B \<Longrightarrow> 1 \<le> k \<Longrightarrow>
        \<exists>m j. Trans ((N::pairseq)[k])
              = ((\<lambda>x. operB x (numBT 0))^^j) (operB (Trans N) (numBT m))"
    and exchI: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondI N \<Longrightarrow> 0 < parent N 0 (Lng N - 1) \<Longrightarrow> 1 < m \<Longrightarrow>
                  Trans ((N::pairseq)[m]) = operB (Trans N) (numBT (m - 1))"
    and exchII: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondII N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. Trans ((N::pairseq)[m]) = operB (Trans N) (numBT k)"
    and exchIII: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIII N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchIV: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondIV N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchV: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondV N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
    and exchVI: "\<And>N m. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow>
                  transCondVI N \<Longrightarrow> 1 < m \<Longrightarrow>
                  \<exists>k. leBT (Trans ((N::pairseq)[m])) (operB (Trans N) (numBT k))"
  shows "Trans M \<in> OT_B \<and> lessBT (Trans ((M::pairseq)[n])) (Trans M)"
proof
  show "Trans M \<in> OT_B"
    by (rule m_8_7_Trans_preserves_OT_via_closure[OF stepval MST])
next
  have TOT: "\<And>N. N \<in> ST_PS \<Longrightarrow> N \<in> PT_PS \<Longrightarrow> 1 < Lng N - 1 \<Longrightarrow> Trans N \<in> OT_B"
    by (rule m_8_7_Trans_preserves_OT_via_closure[OF stepval])
  show "lessBT (Trans ((M::pairseq)[n])) (Trans M)"
    by (rule m_8_7_fseq_descend_dispatcher[OF MST n1 L TOT exchI exchII exchIII
          exchIV exchV exchVI])
qed





(* ===== round 19 front CFA (wt2): condIII CF-META tower engine ===== *)


section \<open>r19-CFA — the article Pred-simultaneous KIND-1 CF-META tower engine\<close>

text \<open>The remaining §8 core is \<open>mnform\<close> = CF-META for the KIND-1 general regime
  (conditions III/IV — the strictly-interleaving case; hypothesis of
  @{thm [source] d13x_exchange13_condIII}):
  \[
     \mathrm{flatBT}(\mathrm{Trans}(M[m]))
       = s_1 \mathbin{@} D_{e_3} \# \mathrm{flatBT}(\mathrm{d13x\_T}\;L\;\mathit{ub}\;A_0\;(m-1)) \mathbin{@} b_1 ,
  \]
  where \<open>e\<^sub>3 = M\<^bsub>1,j\<^sub>-\<^sub>3\<^esub>\<close> is the outer (jm3) marked-principal head, \<open>ub = M\<^bsub>1,j\<^sub>1\<^esub> - 1\<close>
  is the inner block letter (jm2), and \<open>(s\<^sub>1,b\<^sub>1)\<close> is the jm3 kind-1 surgery pair.

  KEY OBSERVATION.  This tower has the EXACT shape of the ADM base
  @{thm [source] m_8_5_scbdec_adm_forms}'s internal coupled induction (the \<open>mL\<close>/\<open>mM\<close>
  closed forms), differing ONLY in that the wrapper head \<open>e\<^sub>3\<close> may differ from the
  block letter \<open>ub\<close> (in the adm/condV case they coincide, both \<open>= M\<^bsub>1,j\<^sub>0\<^esub>\<close>).  So the
  adm block-reading engine (one @{thm [source] m_8_4_oper_props_5} step per tower
  level, the surgery pair pinned by @{thm [source] m_7_2_scb_unique_sb}) generalises
  verbatim.  We ABSTRACT that engine here: it takes the condition-specific
  \<^emph>\<open>value facts\<close> (the two base strings and the two per-block \<open>Trans\<close> values
  \<open>Trans(s84x_Lp M)\<close>, \<open>Trans(Pred(s84x_Np M))\<close>) as named hypotheses and delivers the
  full \<open>\<forall>m\<close> tower by the Pred-simultaneous coupled induction.  This reduces the
  \<open>\<forall>m\<close> CF-META tower (KIND-1 general) to FOUR fixed (m-independent) flat-string
  equalities plus the \<open>jm2ub\<close>/\<open>nzPN\<close> setup — the article's actual reserved core.

  The four value facts are the condition-III analogues of the PROVEN adm value
  lemmas @{thm [source] m_8_5_scbdec_Lp_condV_adm} / \<open>m_8_5_scbdec_PredNp_condV_adm\<close>
  / \<open>PL1\<close>; discharging them is the article's §8.4 condIII structural analysis.

  Empirically validated (python/_r19_cfax_engine.py): over 103 genuine reduced
  monoT condIII hosts (19 deep, \<open>Lng \<ge> 9\<close>), the \<open>jm2ub\<close>, \<open>nzPN\<close>, \<open>fPN\<close>/\<open>fLp\<close>
  (ub-principal), \<open>baseM\<close>/\<open>baseL\<close>, \<open>b0RP\<close>/\<open>b1RP\<close> hypotheses hold with ZERO failures,
  and the resulting tower reproduces \<open>flatBT(Trans(M[m]))\<close> for \<open>m = 1..4\<close> at 100%.\<close>

text \<open>The block-rotation identity left over when the per-block \<open>Trans(s84x_Lp M)\<close>
  value (\<open>d # s @ \<dots>\<close>, a \<open>Cons\<close>-headed block) is folded into the snoc-shaped tower
  \<open>concat (replicate k (s @ [d]))\<close> — needed here (but not in the adm case, where the
  outer head coincides with the block letter) because the wrapper head \<open>e\<^sub>3\<close> differs
  from the block letter \<open>ub\<close>.\<close>

lemma cfax_crep_rot:
  "concat (replicate k (s @ [d])) @ s = s @ concat (replicate k (d # s))"
  by (induction k) auto

subsection \<open>The raw concat tower closed form (pure block-reading engine)\<close>

text \<open>The coupled Pred-simultaneous induction, abstracted.  \<open>baseM\<close>/\<open>baseL\<close> pin the
  \<open>m = 1\<close> strings; \<open>fLp\<close>/\<open>fPN\<close> are the single per-block \<open>Trans\<close> values inserted at
  each step via @{thm [source] m_8_4_oper_props_5}'s common-pair triple.  Conclusion:
  the \<open>M[Suc k]\<close> tower with \<open>k\<close> inner \<open>(s\<^sub>0, D\<^bsub>ub\<^esub>)\<close>-blocks around the base body \<open>A\<^sub>0\<close>.\<close>

lemma cfax_CF_kind1_concat:
  fixes M :: pairseq and e3 ub :: nat
    and s0 s1 b0 b1 :: "Sym list" and A0 :: BT
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and hp1: "hasParent M 1 (Lng M - 1)" and j1gt2: "1 < Lng M - 1"
    and jm2ub: "entry M 1 (s84x_jm2 M) = ub"
    and b0RP: "\<forall>x \<in> set b0. x = RP"
    and b1RP: "\<forall>x \<in> set b1. x = RP"
    and nzPN: "\<not> zeroT (Pred (s84x_Np M))"
    and baseM: "flatBT (Trans ((M::pairseq)[1]))
                  = s1 @ Dsym (enat e3) # flatBT A0 @ b1"
    and baseL: "flatBT (Trans (s84x_L M 1))
                  = s1 @ Dsym (enat e3) # s0 @ [Dsym (enat ub), Zsym] @ b0 @ b1"
    and fLp: "flatBT (Trans (s84x_Lp M))
                = Dsym (enat ub) # s0 @ [Dsym (enat ub), Zsym] @ b0"
    and fPN: "flatBT (Trans (Pred (s84x_Np M)))
                = Dsym (enat ub) # flatBT A0"
  shows "\<forall>k. flatBT (Trans ((M::pairseq)[Suc k]))
             = s1 @ Dsym (enat e3)
                # concat (replicate k (s0 @ [Dsym (enat ub)]))
                @ flatBT A0 @ concat (replicate k b0) @ b1"
proof -
  define X where "X = s0 @ [Dsym (enat ub)]"
  have main: "flatBT (Trans (s84x_L M (Suc k)))
                = s1 @ Dsym (enat e3) # concat (replicate (Suc k) X)
                  @ [Zsym] @ concat (replicate (Suc k) b0) @ b1
              \<and> flatBT (Trans ((M::pairseq)[Suc k]))
                = s1 @ Dsym (enat e3) # concat (replicate k X)
                  @ flatBT A0 @ concat (replicate k b0) @ b1" for k
  proof (induction k)
    case 0
    have Lpart: "flatBT (Trans (s84x_L M (Suc 0)))
                 = s1 @ Dsym (enat e3) # concat (replicate (Suc 0) X)
                   @ [Zsym] @ concat (replicate (Suc 0) b0) @ b1"
      using baseL by (simp add: X_def One_nat_def)
    have Mpart: "flatBT (Trans ((M::pairseq)[Suc 0]))
                 = s1 @ Dsym (enat e3) # concat (replicate 0 X)
                   @ flatBT A0 @ concat (replicate 0 b0) @ b1"
      using baseM by (simp add: One_nat_def)
    show ?case using Lpart Mpart by blast
  next
    case (Suc k)
    have IHL: "flatBT (Trans (s84x_L M (Suc k)))
               = s1 @ Dsym (enat e3) # concat (replicate (Suc k) X)
                 @ [Zsym] @ concat (replicate (Suc k) b0) @ b1"
      using Suc.IH by blast
    define Sk where "Sk = s1 @ Dsym (enat e3) # concat (replicate k X) @ s0"
    define Bk where "Bk = concat (replicate (Suc k) b0) @ b1"
    have flatk: "flatBT (Trans (s84x_L M (Suc k)))
                 = Sk @ flatBT (Dpt (enat ub) 0\<^sub>B) @ Bk"
      using IHL by (simp add: Sk_def Bk_def X_def s85b_crep_snoc s85b_crep_comm
          s85b_rot_cons s85b_crep_comm_cons s85b_crep_comm_snoc s85b_crep_comm_snoc0)
    have iptz: "isPTB_str (flatBT (Dpt (enat ub) 0\<^sub>B))"
      by (rule isPTB_str_Dpt) simp_all
    have BkRP: "\<forall>x \<in> set Bk. x = RP"
      using b0RP b1RP by (auto simp add: Bk_def)
    have wk: "scb_decomp (Trans (s84x_L M (Suc k))) Sk
                (flatBT (Dpt (enat ub) 0\<^sub>B)) Bk"
      unfolding scb_decomp_def using flatk iptz BkRP by simp
    have Lkne: "Trans (s84x_L M (Suc k)) \<noteq> Trm []"
    proof
      assume "Trans (s84x_L M (Suc k)) = Trm []"
      hence "flatBT (Trans (s84x_L M (Suc k))) = [Zsym]" by simp
      moreover have "2 \<le> length (flatBT (Trans (s84x_L M (Suc k))))"
        using flatk by simp
      ultimately show False by simp
    qed
    have n2: "(1::nat) < Suc (Suc k)" by simp
    obtain sb where P5:
      "scb_decomp (Trans (s84x_L M (Suc (Suc k) - 1))) (fst sb)
         (flatBT (Dpt (enat (entry M 1 (s84x_jm2 M))) 0\<^sub>B)) (snd sb)
       \<and> scb_decomp (Trans (s84x_L M (Suc (Suc k)))) (fst sb)
         (flatBT (Trans (s84x_Lp M))) (snd sb)
       \<and> (\<not> zeroT (Pred (s84x_Np M)) \<longrightarrow>
            scb_decomp (Trans ((M::pairseq)[Suc (Suc k)])) (fst sb)
              (flatBT (Trans (Pred (s84x_Np M)))) (snd sb))"
      using m_8_4_oper_props_5[OF MST MP hp1 j1gt2 n2] by blast
    have P5a: "scb_decomp (Trans (s84x_L M (Suc k))) (fst sb)
                 (flatBT (Dpt (enat ub) 0\<^sub>B)) (snd sb)"
      using P5 jm2ub by simp
    have pin: "fst sb = Sk \<and> snd sb = Bk"
      using m_7_2_scb_unique_sb[OF P5a wk Lkne] by simp
    have dL2: "scb_decomp (Trans (s84x_L M (Suc (Suc k)))) Sk
                 (flatBT (Trans (s84x_Lp M))) Bk"
      using P5 pin by simp
    have dM2: "scb_decomp (Trans ((M::pairseq)[Suc (Suc k)])) Sk
                 (flatBT (Trans (Pred (s84x_Np M)))) Bk"
      using P5 pin nzPN by simp
    have Lgoal: "flatBT (Trans (s84x_L M (Suc (Suc k))))
                 = s1 @ Dsym (enat e3) # concat (replicate (Suc (Suc k)) X)
                   @ [Zsym] @ concat (replicate (Suc (Suc k)) b0) @ b1"
    proof -
      have "flatBT (Trans (s84x_L M (Suc (Suc k))))
            = Sk @ flatBT (Trans (s84x_Lp M)) @ Bk"
        using dL2 by (simp add: scb_decomp_def)
      thus ?thesis
        by (simp add: Sk_def Bk_def X_def fLp cfax_crep_rot s85b_crep_snoc
            s85b_crep_comm s85b_rot_cons s85b_crep_comm_cons s85b_crep_comm_snoc
            s85b_crep_comm_snoc0)
    qed
    have Mgoal: "flatBT (Trans ((M::pairseq)[Suc (Suc k)]))
                 = s1 @ Dsym (enat e3) # concat (replicate (Suc k) X)
                   @ flatBT A0 @ concat (replicate (Suc k) b0) @ b1"
    proof -
      have "flatBT (Trans ((M::pairseq)[Suc (Suc k)]))
            = Sk @ flatBT (Trans (Pred (s84x_Np M))) @ Bk"
        using dM2 by (simp add: scb_decomp_def)
      thus ?thesis
        by (simp add: Sk_def Bk_def X_def fPN s85b_crep_snoc s85b_crep_comm
            s85b_rot_cons s85b_crep_comm_cons s85b_crep_comm_snoc s85b_crep_comm_snoc0)
    qed
    show ?case using Lgoal Mgoal by blast
  qed
  show "\<forall>k. flatBT (Trans ((M::pairseq)[Suc k]))
             = s1 @ Dsym (enat e3)
                # concat (replicate k (s0 @ [Dsym (enat ub)]))
                @ flatBT A0 @ concat (replicate k b0) @ b1"
  proof
    fix k
    from main[of k] show "flatBT (Trans ((M::pairseq)[Suc k]))
             = s1 @ Dsym (enat e3)
                # concat (replicate k (s0 @ [Dsym (enat ub)]))
                @ flatBT A0 @ concat (replicate k b0) @ b1"
      by (simp add: X_def)
  qed
qed

subsection \<open>The \<open>d13x_T\<close> tower form = \<open>mnform\<close> (CF-META KIND-1 general instance)\<close>

text \<open>Wrapping the raw concat engine into the @{const d13x_T} tower via
  @{thm [source] d13x_T_flat}, giving EXACTLY the \<open>mnform\<close> hypothesis of
  @{thm [source] d13x_exchange13_condIII} (hence, via that lemma, conclusions
  (1)/(3) of the §8.4 condIII exchange triple, i.e. the interleaving descent).
  This is the CF-META KIND-1 general instance \<open>CF_III\<close> of the round-18 CONS map,
  reduced to the four value facts \<open>baseM\<close>/\<open>baseL\<close>/\<open>fLp\<close>/\<open>fPN\<close>.\<close>

lemma cfax_CF_kind1_mnform:
  fixes M :: pairseq and m :: nat
    and s0 s1 b0 b1 :: "Sym list" and L A0 :: BT
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and hp1: "hasParent M 1 (Lng M - 1)" and j1gt2: "1 < Lng M - 1"
    and jm2ub: "entry M 1 (s84x_jm2 M) = entry M 1 (Lng M - 1) - 1"
    and b0RP: "\<forall>x \<in> set b0. x = RP"
    and b1RP: "\<forall>x \<in> set b1. x = RP"
    and nzPN: "\<not> zeroT (Pred (s84x_Np M))"
    and baseM: "flatBT (Trans ((M::pairseq)[1]))
                  = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M))) # flatBT A0 @ b1"
    and baseL: "flatBT (Trans (s84x_L M 1))
                  = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
                     # s0 @ [Dsym (enat (entry M 1 (Lng M - 1) - 1)), Zsym] @ b0 @ b1"
    and fLp: "flatBT (Trans (s84x_Lp M))
                = Dsym (enat (entry M 1 (Lng M - 1) - 1))
                   # s0 @ [Dsym (enat (entry M 1 (Lng M - 1) - 1)), Zsym] @ b0"
    and fPN: "flatBT (Trans (Pred (s84x_Np M)))
                = Dsym (enat (entry M 1 (Lng M - 1) - 1)) # flatBT A0"
    and LTB: "L \<in> T_B" and A0TB: "A0 \<in> T_B"
    and innerU: "scb_decomp (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)
                   s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)) b0"
    and m1: "1 \<le> m"
  shows "flatBT (Trans ((M::pairseq)[m]))
           = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
               # flatBT (d13x_T L (entry M 1 (Lng M - 1) - 1) A0 (m - 1)) @ b1"
proof -
  let ?e3 = "entry M 1 (s84x_jm3 M)"
  let ?ub = "entry M 1 (Lng M - 1) - 1"
  define k where "k = m - 1"
  have mk: "m = Suc k" using m1 by (simp add: k_def)
  have tower: "\<forall>k. flatBT (Trans ((M::pairseq)[Suc k]))
               = s1 @ Dsym (enat ?e3)
                  # concat (replicate k (s0 @ [Dsym (enat ?ub)]))
                  @ flatBT A0 @ concat (replicate k b0) @ b1"
    by (rule cfax_CF_kind1_concat[OF MST MP hp1 j1gt2 jm2ub b0RP b1RP nzPN
          baseM baseL fLp fPN])
  have concl: "flatBT (Trans ((M::pairseq)[Suc k]))
               = s1 @ Dsym (enat ?e3)
                  # concat (replicate k (s0 @ [Dsym (enat ?ub)]))
                  @ flatBT A0 @ concat (replicate k b0) @ b1"
    using tower by blast
  have flat_core: "flatBT (d13x_T L ?ub A0 k)
                   = concat (replicate k (s0 @ [Dsym (enat ?ub)]))
                     @ flatBT A0 @ concat (replicate k b0)"
    by (rule d13x_T_flat[OF LTB A0TB innerU])
  show ?thesis using concl flat_core mk by simp
qed

subsection \<open>The condition-(III) exchange (1)/(3) DESCENT bottoms on the four CF value facts\<close>

text \<open>Composing @{thm [source] cfax_CF_kind1_mnform} (which discharges the \<open>mnform\<close>
  reserved core from the four value facts) into @{thm [source] d13x_exchange13_condIII}:
  the whole condition-(III) exchange pairing (1)/(3) — hence the interleaving
  descent feeding the dispatcher's \<open>exchIII\<close> leg and the capstone
  @{thm [source] m_8_termination_modulo_CF} — now bottoms EXACTLY on the four fixed
  flat-string value facts \<open>baseM\<close>/\<open>baseL\<close>/\<open>fLp\<close>/\<open>fPN\<close> plus the \<open>jm2ub\<close>/\<open>nzPN\<close> setup
  (the article's §8.4 condIII structural analysis, the analogue of the PROVEN adm
  value lemmas), and the standard \<open>j\<^sub>-\<^sub>3\<close> kind-1 producer data (\<open>bodyT\<close>/\<open>inner\<close>/\<open>k1\<close>)
  and interleaving bounds (\<open>bx\<close>/\<open>ba\<close>) that @{thm [source] d13x_exchange13_condIII}
  already needs.\<close>

lemma cfax_condIII_exchange13_of_CFvalues:
  fixes M :: pairseq and n :: nat and L A0 body :: BT
    and s0 s1 b0 b1 :: "Sym list"
  assumes MST: "M \<in> ST_PS" and MP: "M \<in> PT_PS"
    and hp1: "hasParent M 1 (Lng M - 1)" and j1gt2: "1 < Lng M - 1"
    and n1: "1 \<le> n"
    and jm2ub: "entry M 1 (s84x_jm2 M) = entry M 1 (Lng M - 1) - 1"
    and b0RP: "\<forall>x \<in> set b0. x = RP"
    and b1RP: "\<forall>x \<in> set b1. x = RP"
    and nzPN: "\<not> zeroT (Pred (s84x_Np M))"
    and baseM: "flatBT (Trans ((M::pairseq)[1]))
                  = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M))) # flatBT A0 @ b1"
    and baseL: "flatBT (Trans (s84x_L M 1))
                  = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
                     # s0 @ [Dsym (enat (entry M 1 (Lng M - 1) - 1)), Zsym] @ b0 @ b1"
    and fLp: "flatBT (Trans (s84x_Lp M))
                = Dsym (enat (entry M 1 (Lng M - 1) - 1))
                   # s0 @ [Dsym (enat (entry M 1 (Lng M - 1) - 1)), Zsym] @ b0"
    and fPN: "flatBT (Trans (Pred (s84x_Np M)))
                = Dsym (enat (entry M 1 (Lng M - 1) - 1)) # flatBT A0"
    and LTB: "L \<in> T_B" and A0TB: "A0 \<in> T_B"
    and innerU: "scb_decomp (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)
                   s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B)) b0"
    and uv: "entry M 1 (s84x_jm3 M) < entry M 1 (Lng M - 1)"
    and bodyT: "body \<in> T_B"
    and bodyne: "body \<noteq> Trm []"
    and dbbody: "domB body = TBv (enat (entry M 1 (Lng M - 1) - 1))"
    and inner: "scb_decomp body s0 (flatBT (Dpt (enat (entry M 1 (Lng M - 1))) 0\<^sub>B)) b0"
    and k1: "scb_kind1 (Trans M) s1
               (flatBT (Dpt (enat (entry M 1 (s84x_jm3 M))) body)) b1"
    and bx: "lessBT (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B) A0"
    and ba: "lessBT A0 (L +\<^sub>B Dpt (enat (entry M 1 (Lng M - 1) - 1))
                          (Dpt (enat (entry M 1 (Lng M - 1) - 1)) 0\<^sub>B))"
  shows "lessBT (Trans ((M::pairseq)[n])) (operB (Trans M) (numBT n))
       \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n]))
       \<and> lessBT (operB (Trans M) (numBT (n - 1))) (Trans ((M::pairseq)[n + 1]))"
proof -
  have mn: "1 \<le> m \<Longrightarrow>
      flatBT (Trans ((M::pairseq)[m]))
        = s1 @ Dsym (enat (entry M 1 (s84x_jm3 M)))
            # flatBT (d13x_T L (entry M 1 (Lng M - 1) - 1) A0 (m - 1)) @ b1" for m
    by (rule cfax_CF_kind1_mnform[OF MST MP hp1 j1gt2 jm2ub b0RP b1RP nzPN
          baseM baseL fLp fPN LTB A0TB innerU])
  show ?thesis
    by (rule d13x_exchange13_condIII[OF MST n1 LTB uv bodyT bodyne dbbody
          inner innerU k1 mn bx ba])
qed

