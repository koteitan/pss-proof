  (e.g. \<open>M=(1,1)(0,0)(1,0)(1,1)(1,0)\<close>, \<open>q=1\<close>, \<open>m=1\<close>: \<open>entry N 0 0 = 1 = fst col\<close>, not strict).
  ROOT CAUSE (article-confirmed, not a transcription artifact): \<open>tmp/content.md:1346\<close>
